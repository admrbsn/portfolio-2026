---
/**
 * Break-time CTA. Static markup plus a ~20-line loader — the game itself
 * (engine + stylesheet + panels) is behind a dynamic `import()` that only
 * resolves once someone actually wants to play, so none of it is on the
 * critical path or in a Lighthouse run.
 */
import { BRICK_TOTAL } from '../lib/breakout/game';

const ROW_COLOURS = ['#ff3b5c', '#ff8a3d', '#ffd83d', '#3dff9e', '#3ddcff', '#8f7bff'];
const WALL_COLS = 12;
const WALL_TOTAL = ROW_COLOURS.length * WALL_COLS;

/** Seconds for one full churn of the wall. Matches `wall-churn` in the CSS. */
const CYCLE = 5;

// Deterministic shuffle: the churn needs each brick to blink at a moment that
// *looks* random, but SSG output has to be byte-stable across builds, so this
// seeds a small LCG rather than calling Math.random().
const order = Array.from({ length: WALL_TOTAL }, (_, i) => i);
let seed = 20260725;
for (let i = order.length - 1; i > 0; i--) {
  seed = (seed * 1664525 + 1013904223) % 4294967296;
  const j = seed % (i + 1);
  [order[i], order[j]] = [order[j]!, order[i]!];
}

// Negative delays spread the bricks across the whole cycle and start them
// mid-animation, so the wall is already churning on the first frame instead of
// sitting still until its turn comes round.
const wall = ROW_COLOURS.flatMap((colour, row) =>
  Array.from({ length: WALL_COLS }, (_, col) => ({
    colour,
    delay: `${(-(order[row * WALL_COLS + col]! / WALL_TOTAL) * CYCLE).toFixed(3)}s`,
  })),
);

// Built from the same array the wall uses, so the button can't drift out of
// sync with the rack it represents.
const playGradient = `linear-gradient(100deg, ${ROW_COLOURS.join(', ')})`;
---

<section class="arcade border-t border-line px-gutter py-24 text-center">
  <div class="mx-auto max-w-xl">
    {/* Decorative echo of the real rack. Bricks blink out and back on a
        continuous stagger — a preview of the mechanic, running whether or not
        anyone points at it. */}
    <div class="wall" aria-hidden="true">
      {wall.map((brick) => <i style={`--c:${brick.colour};--d:${brick.delay}`} />)}
    </div>

    <h2 class="title mt-10 font-arcade text-[clamp(2.5rem,8vw,4.5rem)] leading-[1.05]">
      Need a break?
    </h2>

    <p class="mx-auto mt-6 max-w-md text-ink-dim">
      Play Breakout, right here on the page. It starts almost entirely blacked
      out &mdash; every brick you knock down lets a little more of the portfolio
      back through. Clear all {BRICK_TOTAL} to get it back.
    </p>

    {/* The aria-label exists because "Insert coin" alone doesn't say what the
        button does. The visible text stays a substring of the accessible name,
        which is what WCAG 2.5.3 (Label in Name) requires. */}
    <button
      type="button"
      data-breakout-launch
      style={`--play-gradient:${playGradient}`}
      aria-label="Insert coin — play Breakout"
      class="play mx-auto mt-9 inline-flex items-center gap-3 font-arcade text-[1.25rem] tracking-[0.05em]"
    >
      {/* Pixel-stepped play triangle — a smooth vector one would be the only
          anti-aliased curve in the whole component. */}
      <svg viewBox="0 0 6 10" aria-hidden="true" class="h-[1em] w-[0.6em] shrink-0">
        <path
          d="M0 0h2v2H0zM0 2h4v2H0zM0 4h6v2H0zM0 6h4v2H0zM0 8h2v2H0z"
          fill="currentColor"></path>
      </svg>
      Insert coin
    </button>

    <p class="mt-6 text-micro uppercase tracking-[0.14em] text-ink-faint">
      3 balls &middot; {BRICK_TOTAL} bricks &middot; no high scores, no accounts
    </p>
  </div>
</section>

<style>
  .wall {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 2px;
    width: min(22rem, 100%);
    margin-inline: auto;
  }

  .wall > i {
    height: 8px;
    border-radius: 2px;
    /* Same top-lit gradient the canvas bricks get, so the decoration and the
       real rack read as the same object. */
    background: linear-gradient(to bottom, color-mix(in srgb, var(--c) 66%, white), var(--c));
    opacity: 0.85;
    animation: wall-churn 5s linear infinite;
    animation-delay: var(--d);
    /* Held until the section is actually on screen — see the observer below.
       An infinite animation that runs against a footer nobody has scrolled to
       is pure background cost. */
    animation-play-state: paused;
  }

  .arcade[data-visible] .wall > i {
    animation-play-state: running;
  }

  /* Pointing at it winds the whole rack up. */
  .arcade:hover .wall > i,
  .arcade:focus-within .wall > i {
    animation-duration: 1.6s;
  }

  /* Each brick is out for ~7% of the cycle. Spread across 72 negative delays
     that leaves a handful missing at any instant — a wall being chipped at,
     rather than a wave sweeping through it. */
  @keyframes wall-churn {
    0% {
      opacity: 0.85;
      transform: none;
    }
    4% {
      opacity: 0.06;
      transform: translateY(-4px) scale(0.9);
    }
    11% {
      opacity: 0.85;
      transform: none;
    }
    100% {
      opacity: 0.85;
      transform: none;
    }
  }

  /* Gradient-lit keycap. The press still travels, but the silhouette is
     rounded and the shadow soft — retro shape, modern finish. */
  .title {
    background: linear-gradient(to bottom, #ffffff, #a9f2d3);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    filter: drop-shadow(0 0 26px oklch(0.8 0.15 138 / 0.28));
  }

  /* The rack, condensed into a button: `--play-gradient` runs the six brick
     colours left to right, built in the frontmatter from the same array the
     wall uses. Every stop is light enough to carry the near-black label at
     well past AA — the deepest is the indigo at ~5.7:1. */
  .play {
    padding: 0.75em 1.4em;
    border-radius: 14px;
    color: #08120e;
    background: var(--play-gradient);
    border: 1px solid rgb(255 255 255 / 0.45);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.55),
      0 4px 18px oklch(0.16 0.022 190 / 0.8),
      0 0 38px rgb(255 255 255 / 0.1);
    transition:
      transform 130ms var(--ease-out-expo),
      box-shadow 220ms var(--ease-out-expo),
      border-color 220ms var(--ease-out-expo),
      filter 220ms var(--ease-out-expo);
  }

  .play:hover {
    border-color: #ffffff;
    filter: saturate(1.15) brightness(1.06);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.7),
      0 6px 26px oklch(0.16 0.022 190 / 0.85),
      0 0 56px rgb(255 255 255 / 0.2);
  }

  .play:active {
    transform: translateY(2px);
    box-shadow:
      inset 0 2px 6px rgb(0 0 0 / 0.35),
      0 1px 6px oklch(0.16 0.022 190 / 0.8);
  }

  /* While the chunk is in flight. */
  .play[data-loading] {
    opacity: 0.6;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .wall > i,
    .arcade:hover .wall > i,
    .arcade:focus-within .wall > i {
      animation: none;
      opacity: 0.85;
      transform: none;
    }
  }
</style>

<script>
  /**
   * Delegated and globally guarded, matching the footer's copy handler: this
   * component carries `transition:persist`, so the listener has to survive
   * client-side navigation without ever binding twice.
   */
  const w = window as unknown as { __breakoutBound?: boolean };

  if (!w.__breakoutBound) {
    w.__breakoutBound = true;

    /**
     * Gate the wall's infinite churn on actually being on screen. The section
     * lives above the footer, so on most visits it is never reached at all —
     * without this, 72 elements animate forever against nothing.
     *
     * Idempotent via `data-observed`, and re-run on navigation: the component
     * carries `transition:persist` today, but a future layout change that drops
     * that would otherwise leave the wall frozen on every page but the first.
     */
    const observeWall = () => {
      const section = document.querySelector<HTMLElement>('.arcade');
      if (!section || section.dataset.observed !== undefined) return;
      section.dataset.observed = '';
      new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            section.toggleAttribute('data-visible', entry.isIntersecting);
          }
        },
        { rootMargin: '200px' },
      ).observe(section);
    };

    observeWall();
    document.addEventListener('astro:page-load', observeWall);

    // Kept as a promise, not a boolean — a hover followed immediately by a
    // click must reuse the in-flight request rather than start a second one.
    let pending: Promise<typeof import('../lib/breakout')> | null = null;
    const load = () => (pending ??= import('../lib/breakout'));

    // Warm the chunk on intent. Costs nothing on a visit that never plays.
    document.addEventListener(
      'pointerenter',
      (e) => {
        if ((e.target as Element | null)?.closest?.('[data-breakout-launch]')) void load();
      },
      { capture: true, passive: true },
    );

    document.addEventListener('click', async (e) => {
      const btn = (e.target as Element | null)?.closest<HTMLElement>('[data-breakout-launch]');
      if (!btn) return;

      btn.setAttribute('data-loading', '');
      try {
        const { openBreakout } = await load();
        openBreakout(btn);
      } catch (err) {
        console.error('[breakout] failed to load', err);
      } finally {
        btn.removeAttribute('data-loading');
      }
    });
  }
</script>
