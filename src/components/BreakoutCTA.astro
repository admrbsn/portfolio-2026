---
/**
 * Break-time CTA. Static markup plus a ~20-line loader — the game itself
 * (engine + stylesheet + panels) is behind a dynamic `import()` that only
 * resolves once someone actually wants to play, so none of it is on the
 * critical path or in a Lighthouse run.
 */
import { Image } from 'astro:assets';
import { BRICK_TOTAL } from '../lib/breakout/game';
import player from '../assets/home/breakout-player.webp';

const ROW_COLOURS = ['#ff3b5c', '#ff8a3d', '#ffd83d', '#3dff9e', '#3ddcff', '#8f7bff'];
// Nine wide bricks. The arcade original's rack reads as chunky slabs; at 12
// across they were thin enough to look like a progress bar.
const WALL_COLS = 9;
const WALL_ROWS = ROW_COLOURS.length;
const WALL_TOTAL = WALL_ROWS * WALL_COLS;

/** Seconds for one full churn of the wall. Must match `wall-churn` in the CSS. */
const CYCLE = 8;

// Deterministic PRNG. The wall needs two things that *look* random — which
// bricks are missing, and when each survivor blinks — but SSG output has to be
// byte-stable across builds, so this seeds a small LCG rather than calling
// Math.random().
let seed = 20260725;
const rand = () => {
  seed = (seed * 1664525 + 1013904223) % 4294967296;
  return seed / 4294967296;
};

/*
 * The notch. A ball has tunnelled up through the middle of this rack, so the
 * damage is a wedge that widens downward — the bottom rows are chewed through
 * and the top ones are untouched, which is the shape the arcade cabinet art has.
 *
 * A brick is out when its distance from the centre column falls inside a
 * half-width that grows with depth. `t ** 1.6` is what curves it: linear growth
 * gave a clean triangle, and the exponent holds the top two rows fully intact
 * before opening up quickly through the lower half. The constants are tuned so
 * the outermost column survives on every row — a rack eaten right to its edges
 * stops reading as a rack.
 *
 * Order matters: the gaps are drawn before the delays so both stay stable
 * against the same seed.
 */
const cx = (WALL_COLS - 1) / 2;
const gone = Array.from({ length: WALL_TOTAL }, (_, i) => {
  const t = Math.floor(i / WALL_COLS) / (WALL_ROWS - 1);
  const halfGap = t ** 1.6 * 4.3 - 0.55;
  // Jitter ragged-edges the boundary so the wedge is not a drawn triangle.
  return Math.abs((i % WALL_COLS) - cx) < halfGap + (rand() - 0.5) * 0.6;
});

// Negative delays spread the survivors across the whole cycle and start them
// mid-animation, so the wall is already churning on the first frame instead of
// sitting still until its turn comes round.
const order = Array.from({ length: WALL_TOTAL }, (_, i) => i);
for (let i = order.length - 1; i > 0; i--) {
  const j = Math.floor(rand() * (i + 1));
  [order[i], order[j]] = [order[j]!, order[i]!];
}

const wall = Array.from({ length: WALL_TOTAL }, (_, i) => ({
  colour: ROW_COLOURS[Math.floor(i / WALL_COLS)]!,
  gone: gone[i]!,
  delay: `${(-(order[i]! / WALL_TOTAL) * CYCLE).toFixed(3)}s`,
}));

/*
 * Box-art copy. The 1978 Atari box is the layout: wordmark, two lines of
 * subhead, a big numeral block on the left, a spec block on the right, the
 * illustration through the middle.
 *
 * What is deliberately *not* borrowed is the branding. The Atari fuji, the
 * ATARI wordmark and the CX2622 part number are a real company's marks, and
 * stamping them on a personal site is impersonation rather than homage — the
 * composition is the reference, not the identity. Everything below names this
 * site instead.
 */
/*
 * Kept to lines that fit the column without wrapping at any width the band
 * actually gets. The box's right-hand block is four short stacked phrases, and
 * a wrapped line there stops reading as a spec sheet and starts reading as a
 * paragraph that ran out of room.
 */
const SPEC = [
  'One player',
  'No continues',
  'Overlays the page',
  `Clear all ${BRICK_TOTAL} to win`,
];
---

{/*
  `--row-0..5` publish the rack's own palette to the CSS below, so `--box-ramp`
  (the wordmark and the count) and `--box-shade` are built from `ROW_COLOURS`
  rather than from hexes restated beside it. Same rule as everything else in
  here: one array, or the decoration drifts from the game it advertises.
*/}
<section
  class="arcade relative overflow-hidden border-t border-line px-gutter py-16"
  data-blueprint="Vibe code check"
  aria-labelledby="breakout-title"
  style={ROW_COLOURS.map((c, i) => `--row-${i}:${c}`).join(';')}
>
  {/*
    The CRT layer, over everything. Scanlines plus one slow refresh roll — the
    cabinet this section is pretending to be, stated once and quietly.

    Above the content rather than behind it, which is the whole point: a screen
    effect that only touches the background is wallpaper. Over the rack, the
    figure and the type it reads as all of them being *on* the same tube.
    `pointer-events: none` keeps the coin slot clickable through it.
  */}
  <div class="crt" aria-hidden="true"></div>

  {/*
    No box. This was a bordered panel with a printed ground, which is what a
    cartridge label is — but a hard edge across the page turned the section into
    an object sitting on the site rather than part of it, and capped the whole
    composition at a width the rack and the figure were both fighting.

    What survives the box is the thing the box was actually for: **the rack
    still needs something darker behind it.** That is now a soft radial on
    `.art` with no edge at all, rather than a frame — the requirement was never
    a border, it was contrast.

    **There is deliberately no background wash on this section.** Three were
    built and all three were cut: a four-field version when the rack sat loose
    on the page, a violet/red pair, and a warm orange/gold pair. Every one of
    them read as haze over near-black rather than as light, because a colour at
    the alpha this section can afford *is* a dark version of itself, and dark
    warm is brown. What the section actually wanted was the CRT layer above —
    texture, not colour. Reach for the raster before reaching for a gradient.
  */}
  <div class="cart mx-auto">
    <div class="cart__inner">
      {/* Masthead. The cartridge prints a small line above the wordmark
          ("game program™") and this carried a "Need a break?" in that slot —
          cut, because it was the third line of small type in a stack that
          already has two below the wordmark, and the only one saying nothing
          the button does not. */}
      <h2 id="breakout-title" class="wordmark">
        Breakout<span class="tm" aria-hidden="true">&#8482;</span>
      </h2>

      <p class="subhead">
        Portfolio computer system<span class="tm" aria-hidden="true">&#8482;</span>
      </p>
      <p class="subhead">
        Game program<span class="tm" aria-hidden="true">&#8482;</span>
      </p>

      {/* The three-column band: numeral block, art window, spec block. The box
          puts "12 VIDEO GAMES" and the player-count copy either side of the
          illustration, and the count is the one number this section actually
          has to communicate. */}
      <div class="band">
        <p class="count">
          <span class="count__num">{BRICK_TOTAL}</span>
          <span class="count__word">Bricks<br />to clear</span>
        </p>

        {/* The art window. On the box this is a bordered photo panel, and it is
            what stops the rack's six hues sitting loose on the orange. */}
        <div class="art">
          {/* Decorative echo of the real rack. Bricks blink out and back on a
              continuous stagger — a preview of the mechanic, running whether or
              not anyone points at it. */}
          <div class="wall" aria-hidden="true">
            {
              wall.map((brick) =>
                brick.gone ? (
                  <i data-gone />
                ) : (
                  <i style={`--c:${brick.colour};--d:${brick.delay}`} />
                ),
              )
            }
          </div>

          {/*
            The rally, inside the playfield rather than loose in the panel.

            It used to cross the whole section, which worked when the section
            was black. On the orange ground the same squares read as specks of
            dirt on printed card — and the box itself has no ball flying across
            its artwork. Confined here it is doing the thing it was always for:
            showing the mechanic, in the only place a ball belongs.

            Four squares on identical paths at staggered lags, so the tail
            traces wherever the head has actually been — a static box-shadow
            points one way and detaches the moment the ball turns.

            Squares, not circles: the Atari original's ball is a block, and
            hard-edged segments shrinking in steps read as a sprite trail where
            soft round dots read as motion blur.

            Ordered before the player so the rally passes behind him. Over his
            face it reads as a blemish rather than as depth.
          */}
          <div class="rally" aria-hidden="true">
            <span class="ball" style="--lag:0s;--size:12px;--alpha:1"></span>
            <span class="ball" style="--lag:0.055s;--size:10px;--alpha:0.5"></span>
            <span class="ball" style="--lag:0.11s;--size:8px;--alpha:0.28"></span>
            <span class="ball" style="--lag:0.17s;--size:6px;--alpha:0.14"></span>
          </div>

          {/*
            The player, bursting up through the rack exactly as on the box —
            drawn *over* the bricks and cropped by the window's bottom edge, so
            he reads as coming through the wall rather than standing behind it.

            `aria-hidden`: he is the box's illustration and carries no
            information the heading and spec block do not already give.
          */}
          <Image
            src={player}
            alt=""
            widths={[420, 640]}
            sizes="(max-width: 48rem) 60vw, 22rem"
            loading="lazy"
            decoding="async"
            class="player"
            aria-hidden="true"
          />
        </div>

        <ul class="spec">
          {SPEC.map((line) => <li>{line}</li>)}
        </ul>
      </div>

      {/* The aria-label exists because "Insert coin" alone doesn't say what the
          button does. The visible text stays a substring of the accessible name,
          which is what WCAG 2.5.3 (Label in Name) requires. */}
      <button
        type="button"
        data-breakout-launch
        data-cursor="coin"
        aria-label="Insert coin — play Breakout"
        class="play font-arcade"
      >
        {/* The slot itself — a milled slit in the faceplate, which is what the
            coin cursor is being offered to. */}
        <span class="play__slot" aria-hidden="true"></span>
        Insert coin
      </button>

      {/* The footer strip, where the box carries its publisher and part
          number. Both are this site's, deliberately — see the note in the
          frontmatter. */}
      <p class="colophon">
        <span>Adam Robertson</span>
        <span>AR&#8209;2026</span>
      </p>
    </div>
  </div>
</section>

<style>
  /*
    **The cartridge, not the box.** Atari shipped both, and the two have
    different grounds: the 1978 box is flat orange, the cartridge label is
    black with the wordmark in a pure saturated yellow (#fffe00, sampled). The
    orange was only ever the reference for the *composition* — on a page whose
    whole surface is near-black it read as a slab of unrelated colour rather
    than as an object on it. The black label is the same layout on a ground the
    page already has.

    The gradient is deliberately almost nothing: a warm lift falling out of the
    top edge, so the panel reads as lit from above rather than as a flat hole
    cut in the page. Push it any further and the section starts competing with
    the hero, which is the one thing on the site allowed to carry a wash.

    This section is the documented off-brand island, so these are literals by
    design; `check:tokens` allow-lists this file for exactly that reason.
  */
  .cart {
    --box-ink: #fffe00;
    --box-white: #f4f1ea;
    --box-dim: rgb(244 241 234 / 0.62);
    /* The wordmark's offset shadow. A darker tint of the ramp's *warm* end, not
       of its yellow one: the shadow sits under the bottom of the letterforms,
       which is where the ramp has already reached orange, and an olive-yellow
       shadow there read as dirt rather than as depth. */
    --box-shade: color-mix(in srgb, var(--row-1) 40%, black);

    /* The one ramp, shared by the wordmark and the count. Held at 34% rather
       than an even 50/50: a linear ramp lands mid-orange across the cap height
       and the mark stops reading as yellow at all. Two copies of this drifting
       apart is exactly the kind of thing nobody notices until the two blocks
       are side by side. */
    --box-ramp: linear-gradient(
      180deg,
      var(--row-2) 0%,
      var(--row-2) 34%,
      var(--row-1) 100%
    );

    position: relative;
    /* Wide. The 64rem cap was the box's, and with the box gone there is nothing
       left for it to be the width *of* — the composition is a masthead over a
       three-column band, and both want room. It still stops short of the full
       gutter, which is what keeps the section reading as a composition rather
       than as content pushed to the page edges. */
    width: min(76rem, 100%);
  }

  .cart__inner {
    position: relative;
    z-index: 10;
    /* Vertical only. The horizontal padding existed to hold content off a
       printed edge; without one it just narrows the band for no reason. */
    padding-block: clamp(0.25rem, 1vw, 0.75rem);
    text-align: center;
  }

  /* The CRT layer -------------------------------------------------------- */

  /*
    **Scanlines at a 3px pitch, one device pixel dark.** Pitch is the only value
    that matters: at 2px the pattern beats against the display's own grid and
    moirés on any fractional zoom, and at 4px+ it stops reading as a raster and
    starts reading as stripes. Alpha is deliberately far below where it "looks
    right" in isolation — this crosses the wordmark and the pixel subheads, and
    anything heavier costs their legibility for a texture nobody is meant to
    notice.

    Held to `screen`-safe darkness rather than a blend mode: `multiply` over a
    section that is already near-black does nothing at all, and `overlay` lifts
    the blacks into grey.
  */
  .crt {
    position: absolute;
    inset: 0;
    /* Above `.cart__inner` (10) — see the note at the element. */
    z-index: 20;
    pointer-events: none;
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0 2px,
      rgb(0 0 0 / 0.15) 2px 3px
    );
  }

  /*
    The refresh roll: one soft band easing down the tube, the artefact every
    photograph of a CRT has. It is the "fun" half of this and the half most
    likely to be overdone — it is a *single* band, it is nearly transparent, and
    it takes 9s to cross, so on a section most visitors scroll past it may never
    complete a pass. A faster or brighter roll stops reading as a screen and
    starts reading as a loading shimmer.

    Its own pseudo-element so the scanlines stay static underneath: animating
    the parent would drag the raster down with the band.
  */
  .crt::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 28%;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgb(255 255 255 / 0.035) 45%,
      rgb(255 255 255 / 0.05) 60%,
      transparent 100%
    );
    animation: crt-roll 9s linear infinite;
    animation-play-state: paused;
    will-change: transform;
  }

  .arcade[data-visible] .crt::after {
    animation-play-state: running;
  }

  /* A percentage translate resolves against the *band's* height, not the
     section's — and the band is 28% of it. 357% is 100/28, i.e. exactly one
     section height, so the band leaves the bottom edge as cleanly as it entered
     the top. Change the band's height and this number has to change with it. */
  @keyframes crt-roll {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: translateY(357%);
    }
  }

  /* Masthead ------------------------------------------------------------- */

  /*
    The wordmark. Baumans, ramped from the rack's own yellow row into its orange
    row — `--row-2` to `--row-1`, so the mark is literally lit by two of the
    bricks below it rather than by a colour invented beside them.

    Vertical, and weighted to hold the yellow through the top third before
    falling: a linear 50/50 ramp lands mid-orange across the cap height and the
    mark stops reading as yellow at all.

    **The offset shadow has to be `drop-shadow`, not `text-shadow`.** Clipping a
    gradient to text means `-webkit-text-fill-color: transparent`, and a
    text-shadow paints *behind* the glyph — so it shows straight through the
    transparent fill as a dirty smear instead of sitting under it.
    `drop-shadow` works on the composited alpha, which is the gradient-filled
    shape, and at 0 blur it is still the hard printed offset the label has.
  */
  .wordmark {
    margin-top: 0.15rem;
    font-family: var(--font-cartridge);
    font-weight: 400;
    font-size: clamp(2.5rem, 9vw, 5.25rem);
    line-height: 0.92;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    background-image: var(--box-ramp);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    /* Offset in `em`, not px: the wordmark clamps across a 2.1x range, and a
       fixed 4px shadow that reads as a print offset at 84px reads as a smear
       at 40px. */
    filter: drop-shadow(0.05em 0.05em 0 var(--box-shade));
  }

  /* The mark takes a solid fill of its own. A clipped background paints against
     the *parent's* box, so an inline child inherits the transparent fill and
     nothing to fill it with — the same trap `.accent-gradient > *` works around
     in global.css. */
  .wordmark .tm {
    -webkit-text-fill-color: var(--row-2);
    color: var(--row-2);
  }

  /*
    The trademark marks, riding the cap line at the size the box sets them.

    **Set in the sans, deliberately.** Neither Baumans nor Tiny5 carries U+2122,
    so both fall back — and Tiny5's fallback is a 5px blob that reads as a
    rendering fault rather than as a ™. This is the one place in the section
    where the site's own face is the right answer: at 0.3em nobody reads it as
    type, they read it as a mark, and a clean one is the only kind that works.
  */
  .tm {
    font-family: var(--font-sans);
    font-size: 0.3em;
    vertical-align: 0.85em;
    margin-left: 0.15em;
    letter-spacing: 0;
  }

  /* The subheads are already small, so their marks need proportionally more. */
  .subhead .tm {
    font-size: 0.55em;
    vertical-align: 0.5em;
  }

  .subhead {
    font-family: var(--font-arcade);
    font-size: clamp(0.875rem, 1.7vw, 1.0625rem);
    line-height: 1.15;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--box-white);
  }

  .subhead + .subhead {
    margin-top: 0.1rem;
  }

  /* The three-column band ------------------------------------------------ */

  /*
    Numeral, art, spec. One column below `md`, because the box's side blocks are
    printed *beside* the illustration and stacking them keeps that reading order
    — the art must not end up above the thing that counts it.
  */
  /*
    **The margin is negative, and the gap it closes is not the one it looks
    like.** Measured, the subheads already sat 36px off the top of his head —
    what read as a gap was the top of the panel itself, where his hair is dark
    and sparse against black and the eye finds no edge. Trimming positive
    spacing could not fix that; only overlap could.

    So the band rides up under the masthead. Paint order does the rest for
    free: the figure is `position: absolute` and the panel is a stacking
    context, so both land in step 8 and cover the in-flow subhead text above
    them. He passes in front of the type, which is the intent — the masthead is
    a label on the scene, not a caption above it.
  */
  .band {
    display: grid;
    gap: clamp(1rem, 3vw, 1.75rem);
    align-items: center;
    /* Positive below `md` — see the note on the negative value in the media
       query below. */
    margin-top: clamp(0.75rem, 2vw, 1.25rem);
  }

  /*
    **The side columns must be equal, or the middle one is not centred.** They
    were 0.5fr and 0.8fr — sized to what each block's text needed — which put
    the art column's centre ~85px left of the container's, so the rack and the
    figure sat visibly off-axis under a masthead centred on the container. A
    grid centres its middle track only when the tracks either side of it match.

    So they match, and the *content* absorbs the difference instead: the numeral
    block is right-aligned and the spec block left-aligned, both hard against
    the art, so the extra room the numeral doesn't need falls to the outside
    where nothing is looking. Widening the spec column is not the fix — check
    the spec lines still sit on one line each after changing this, since that is
    what the asymmetry was originally buying.
  */
  @media (min-width: 48rem) {
    .band {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 2.8fr) minmax(0, 0.9fr);

      /*
        **The overlap is a three-column device and must not survive the stack.**
        Here the band's first row is the illustration, so a negative margin
        slides his head up behind the subheads, which is the intent. Below `md`
        the band is one column and its first row is the *count* — the same
        negative margin drove `66` straight through "GAME PROGRAM". Any spacing
        tuned against the figure has to be scoped to the layout that puts the
        figure there.

        ~13px of overlap, and not as much as it will take: at -48px his hair
        crossed the middle of "GAME PROGRAM" and took `ME PRO` with it. The line
        is content, not texture — an illustration may graze a descender, not eat
        a word. If this moves again, measure it: the head wants to land just
        inside the last subhead's bottom edge.
      */
      margin-top: clamp(-1.875rem, -2vw, -0.5rem);
    }
  }

  /*
    The count takes the wordmark's ramp, so the two yellow marks in the frame
    are demonstrably the same object at two sizes rather than two yellows that
    happen to be close.

    **Both the block and its children carry the background.** A clipped
    background paints against the element's own box, and a block-level child
    with a transparent fill has nothing to fill it with — so the numeral and the
    caption would come out hollow if only the parent had it. Same pattern, same
    reason, as `.accent-gradient > *` in global.css.

    The consequence is that each part gets its *own* full ramp rather than one
    ramp spanning the group: the numeral runs yellow to orange across its own
    cap height, the caption across its two small lines. That is the right way
    round — one ramp over the whole block would land the caption entirely in
    orange, and it is small enough that it needs the yellow end to stay legible.

    No `drop-shadow` here, unlike the wordmark. At 3.5rem the offset reads as a
    deliberate print register; at the caption's 15px it is mud.
  */
  .count,
  .count > * {
    background-image: var(--box-ramp);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .count {
    text-align: center;
  }

  @media (min-width: 48rem) {
    .count {
      text-align: right;
    }
  }

  .count__num {
    display: block;
    font-family: var(--font-cartridge);
    font-size: clamp(2.5rem, 5.6vw, 3.5rem);
    line-height: 0.85;
    letter-spacing: -0.02em;
  }

  .count__word {
    display: block;
    margin-top: 0.35rem;
    font-family: var(--font-arcade);
    font-size: 0.9375rem;
    line-height: 1.15;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .spec {
    font-family: var(--font-arcade);
    font-size: 0.9375rem;
    line-height: 1.45;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--box-dim);
    text-align: center;
  }

  @media (min-width: 48rem) {
    .spec {
      text-align: left;
    }
  }

  /* The art window ------------------------------------------------------- */

  /*
    The panel the illustration and the rack share. Slightly darker than the
    label around it, with a hairline edge — on a black ground the window has to
    be found by its border rather than by its fill.

    `isolation: isolate` so the player's stacking stays local to this panel and
    cannot climb over the copy above it.
  */
  .art {
    position: relative;
    isolation: isolate;
    /*
      The rack sits at roughly a fifth down, not at the top. That is where the
      box prints its brick rows, and it is what leaves the figure something to
      come *through* — pinned to the top edge, he passes under the wall instead
      and the whole point is lost.
    */
    padding: 16% clamp(0.75rem, 2vw, 1.25rem) 0;
    /*
      No border, and a ground with no edge. What the rack needs is something
      *darker behind it*, which is a different requirement from a frame — so
      this is a soft radial that has fallen to nothing well before the column
      ends. It reads as depth in the middle of the wash rather than as a second
      box inside the one just removed.
    */
    background: radial-gradient(68% 85% at 50% 42%, rgb(0 0 0 / 0.62) 0%, transparent 74%);
    /* A ratio rather than a height, so the panel keeps its proportion as the
       column narrows. Wider than the box's own 4:3 window: the rack is nine
       bricks across and the figure has to clear them, and at 4:3 both were
       being squeezed to fit a square-ish frame. */
    aspect-ratio: 16 / 9;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    /*
      The figure's crop, now that there is no edge to crop against. A hard cut
      at an invisible line reads as a mistake; fading him out reads as emerging
      from the dark, which is the same story the veil in the game tells.

      Only the bottom 18% is touched, and the rack finishes above 60%, so no
      brick is ever caught by this.
    */
    mask-image: linear-gradient(to bottom, #000 0 82%, transparent 100%);
  }

  .wall {
    display: grid;
    grid-template-columns: repeat(9, 1fr);
    gap: 6px;
  }

  /*
    **16-bit, not 8-bit.** These bricks used to be a flat face with two hard
    two-pixel bevel bands — a 2600 sprite, drawn light-first so the dark bands
    owned the standard pixel-art mitre. That treatment is gone here *and* in
    `game.ts`, deliberately and together: the CTA's rack and the canvas rack
    have to stay demonstrably one object, and softening only the decoration
    would make the preview a lie about the game it opens.

    What replaced it is the later console idiom — a vertical ramp across the
    face, a bright one-pixel rim along the top, a dark one along the bottom, a
    small radius, and a real soft drop shadow underneath. Three things carry it,
    and dropping any one of them lands back in flat-vector territory rather than
    in either era:

    - the **ramp** has to stay inside the hue (a `color-mix` toward white and
      black, never a second hue), or the rack stops reading as six rows of one
      material;
    - the **rim lines** are 1px and opaque — at 2px they become a bevel again;
    - the **shadow** is the only blur in here, and it belongs to the brick, not
      to the light: tight, barely offset, and dark enough to lift the slab off
      the playfield.
  */
  .wall > i {
    /* Aspect rather than a fixed height: the rack has to keep its slab
       proportion as the art window narrows, and a 22px brick in a 240px-wide
       panel reads as a stripe. */
    aspect-ratio: 4 / 1.7;
    border-radius: 2px;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--c) 74%, white) 0%,
      var(--c) 46%,
      color-mix(in srgb, var(--c) 68%, black) 100%
    );
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--c) 40%, white),
      inset 0 -1px 0 color-mix(in srgb, var(--c) 45%, black),
      0 2px 3px rgb(0 0 0 / 0.45);
    opacity: 0.92;
    animation: wall-churn 8s linear infinite;
    animation-delay: var(--d);
    /* Held until the section is actually on screen — see the observer below.
       An infinite animation that runs against a footer nobody has scrolled to
       is pure background cost. */
    animation-play-state: paused;
  }

  .arcade[data-visible] .wall > i {
    animation-play-state: running;
  }

  /* Knocked out. Kept in the grid as an empty socket rather than removed, so
     the rack still reads as a rack with a hole in it — drop the element and the
     surviving bricks close ranks and the damage disappears. A recess, so its
     ramp and rim run the other way: dark at the top, light at the foot. */
  .wall > i[data-gone] {
    /*
      Lifted well clear of the playfield's own black. On the orange ground a
      socket only had to be darker than the card; here the panel is already
      near-black, and at the alpha this started on the wedge stopped reading as
      *damage* and started reading as rows that were never printed. The notch is
      the whole picture of the mechanic, so the empty slots have to stay findable.
    */
    background: linear-gradient(180deg, rgb(0 0 0 / 0.6) 0%, rgb(255 255 255 / 0.07) 100%);
    box-shadow:
      inset 0 1px 0 rgb(0 0 0 / 0.7),
      inset 0 -1px 0 rgb(255 255 255 / 0.1),
      inset 0 0 0 1px rgb(255 255 255 / 0.05);
    opacity: 1;
    animation: none;
  }

  /* Pointing at it winds the whole rack up. */
  .arcade:hover .wall > i,
  .arcade:focus-within .wall > i {
    animation-duration: 3.4s;
  }

  /* Each brick is out for ~7% of the cycle. Spread across the negative delays
     that leaves a handful missing at any instant — a wall being chipped at,
     rather than a wave sweeping through it. */
  @keyframes wall-churn {
    0% {
      opacity: 0.85;
      transform: none;
    }
    4% {
      opacity: 0.06;
      transform: translateY(-4px) scale(0.9);
    }
    11% {
      opacity: 0.85;
      transform: none;
    }
    100% {
      opacity: 0.85;
      transform: none;
    }
  }

  /*
    The player, coming up through the rack.

    Two things make him read as *through* rather than *behind*: he is painted
    over the bricks (later in the DOM, no z-index needed inside the isolated
    panel), and his feet are cropped by the window's bottom edge. Anchored to
    the bottom so the crop is always at the same place on him whatever the
    panel's width does.

    `mix-blend-mode: normal` and no filter — the artwork is a painted
    illustration and every attempt to tint it toward the page's palette turned
    it into a sticker. On the box it is full-colour against flat orange, and
    that contrast is the composition.
  */
  .player {
    position: absolute;
    left: 50%;
    bottom: 0;
    /*
      Sized off the panel's *height*, not its width. The wall is the width-bound
      element in here; matching him to the same axis meant he shrank whenever
      the column narrowed and ended up a figurine standing under the rack.

      **Under 100%, always.** He is anchored to the bottom inside an
      `overflow: hidden` panel, so any value over 100 crops the top of his head
      — which reads as a mistake, where the fade at his feet reads as depth. 96
      leaves him a little air above and still crosses the lower rows at every
      size, which is the composition. To make him bigger, make the panel taller
      (`aspect-ratio`); do not push this past 100.
    */
    height: 96%;
    width: auto;
    max-width: none;
    transform: translateX(-50%);
    object-fit: contain;
    object-position: bottom center;
    pointer-events: none;
  }

  /* The colophon strip --------------------------------------------------- */

  .colophon {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: clamp(0.75rem, 2vw, 1.25rem);
    padding-top: 0.75rem;
    border-top: 2px solid rgb(0 0 0 / 0.28);
    font-family: var(--font-arcade);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--box-dim);
  }

  /*
    The rally's own layer, filling the art window. Inset by the panel's padding
    would pen it under the rack; `inset: 0` lets it use the whole playfield,
    which is what the ball actually has.
  */
  .rally {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /*
    `left`/`top` rather than transforms: these are absolutely positioned, so
    they lay out nothing else, and percentage insets resolve against the section
    at any width — a transform would need the travel distance hardcoded.

    Two alternating animations at coprime durations, so the path never repeats
    and a fixed pair of keyframes reads as a genuine rally rather than a loop.
    `--lag` walks each trail dot back along that shared path: the base delay is
    negative (start mid-flight, not parked at the edge) and the lag makes it
    less negative, which is what puts a dot behind the head rather than ahead.
  */
  /*
    **Round, lit, and no longer a block.** The 2600 ball is a square, and this
    was one on that authority — the note used to run "hard-edged segments
    shrinking in steps read as a sprite trail where soft round dots read as
    motion blur." That was true of a flat white square beside a flat-bevelled
    rack. Beside a rack with ramped faces and rounded corners it was the last
    8-bit object left in the frame, and it read as a stray pixel rather than as
    the ball.

    The gradient is off-centre (`at 34% 30%`) so the highlight sits up and to
    the left, which is the same light the bricks' top rim implies. A centred
    radial reads as a glowing dot rather than as a lit sphere.

    The trail dots inherit all of it and only shrink and fade, so the tail is
    the same object at distance rather than a different, simpler one.
  */
  .ball {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    background: radial-gradient(circle at 34% 30%, #fff 0%, #f4f7ff 42%, #a9b6cf 100%);
    /* Tight and unoffset: the ball is its own light source, so this is a bloom
       rather than a shadow. Anything wider turns the rally into four smudges. */
    box-shadow: 0 0 calc(var(--size) * 0.6) rgb(255 255 255 / 0.35);
    opacity: var(--alpha);
    animation:
      ball-x 5.6s linear infinite alternate,
      ball-y 3.4s linear infinite alternate;
    animation-delay: calc(-2.4s + var(--lag)), calc(-1.3s + var(--lag));
    animation-play-state: paused;
  }

  .arcade[data-visible] .ball {
    animation-play-state: running;
  }

  /*
    No hover speed-up here, deliberately.

    Changing `animation-duration` mid-flight preserves the animation's current
    *time*, not its progress — so progress (time / duration) jumps the instant
    the value changes and the element teleports. Measured at ~396px against a
    ~30px normal frame, which is the "ball vanishes and restarts somewhere else"
    bug. The wall keeps its speed-up because one brick jumping mid-churn among
    identical neighbours is invisible; a single tracked object jumping is not.
  */

  @keyframes ball-x {
    to {
      left: calc(100% - var(--size));
    }
  }

  @keyframes ball-y {
    to {
      top: calc(100% - var(--size));
    }
  }

  /*
    A coin slot, not a key. Brushed-silver faceplate with a real slit milled
    into it — the thing the coin cursor is being offered to.

    **16-bit, matching the rack.** It used to be square-cornered with a
    stepped two-pixel bevel and zero blur anywhere, on the argument that one
    soft shadow turns 8-bit into skeuomorphism. That argument is sound and it is
    no longer the argument being made: the whole section moved to the later
    console idiom, and a hard-stepped plate beside gradient-faced bricks reads
    as two objects from two machines.

    What changed, and what did not: it keeps the milled slit, the two-tone
    frame, and the plate thickness that gives the press somewhere to go. It
    gains a small radius, a smoother ramp with more stops, softened rim lines,
    and one blurred shadow under the plate. It does **not** gain a glow, a
    gradient border, or an eased transition — the press still snaps in steps,
    because a coin mech has no in-between state whatever the era.
  */
  .play {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    /* Positive below `md` — see the note on the negative value in the media
       query below. */
    margin: clamp(1rem, 2.5vw, 1.5rem) auto 0;
    font-size: 1.1rem;
    letter-spacing: 0.08em;
    padding: 0.85em 1.7em;
    border: 0;
    border-radius: 4px;
    color: #10141a;
    /* More stops than the plate needs to look metal, because the extra pair is
       what puts a highlight *band* across the top third rather than a single
       ramp from light to dark. */
    background: linear-gradient(
      to bottom,
      #fbfdfe 0%,
      #e3e9ee 18%,
      #c3ccd4 46%,
      #aab4bd 62%,
      #8e98a1 100%
    );
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.95),
      inset 1px 0 0 rgb(255 255 255 / 0.4),
      inset -1px 0 0 rgb(0 0 0 / 0.18),
      inset 0 -1px 0 rgb(0 0 0 / 0.25),
      /* two-tone frame, thinner than the stepped one it replaced */
      0 0 0 2px #5b656e,
      0 0 0 4px #1b2026,
      /* the plate's own thickness, so pressing it has somewhere to go */
      0 7px 0 0 #1b2026,
      /* the one blur: the plate's shadow on the label behind it */
      0 12px 18px -6px rgb(0 0 0 / 0.65);
    /* Stepped, not eased: a coin mech has no in-between state. */
    transition:
      transform 80ms steps(2, end),
      box-shadow 80ms steps(2, end),
      filter 140ms ease;
  }

  /*
    Same scoping as the band's overlap, and for the same reason. From `md` the
    element directly above the button is the illustration, whose bottom 18% is
    masked away — so it has faded to nothing well before the panel's edge and
    left ~95px of dead panel under him. This lifts the slot to where he actually
    stops.

    Below `md` the element above the button is the *spec list*, and the same
    negative margin buried "Clear all 66 to win" behind the faceplate.

    `.play` is `position: relative`, so it paints in step 8 like the panel and
    lands *above* the figure rather than behind him — the right way round here
    where it is the wrong way round for the masthead. A launch button occluded
    by an illustration is a usability problem, not a composition.
  */
  @media (min-width: 48rem) {
    .play {
      margin-top: clamp(-5rem, -5.5vw, -1rem);
    }
  }

  .play:hover {
    filter: brightness(1.06);
  }

  .play:active {
    transform: translateY(5px);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.6),
      inset 1px 0 0 rgb(255 255 255 / 0.25),
      inset -1px 0 0 rgb(0 0 0 / 0.24),
      inset 0 -1px 0 rgb(0 0 0 / 0.3),
      0 0 0 2px #5b656e,
      0 0 0 4px #1b2026,
      0 2px 0 0 #1b2026,
      0 5px 10px -4px rgb(0 0 0 / 0.6);
  }

  /* The slit. Vertical, because that is the way a coin goes in — and recessed
     with a soft inner shadow now rather than a hard black rectangle, so it
     reads as milled depth rather than as a painted-on mark. */
  .play__slot {
    width: 0.36em;
    height: 1.45em;
    flex: none;
    border-radius: 2px;
    background: linear-gradient(to bottom, #05070a 0%, #171d24 100%);
    box-shadow:
      inset 0 1px 2px rgb(0 0 0 / 0.9),
      0 0 0 1px rgb(255 255 255 / 0.6),
      0 1px 2px rgb(255 255 255 / 0.35);
  }

  /* While the chunk is in flight. */
  .play[data-loading] {
    opacity: 0.6;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    /* The raster stays — it is composition. The roll is the one thing here that
       is *only* motion, so it goes entirely rather than parking somewhere
       arbitrary down the tube. */
    .crt::after {
      display: none;
    }

    .wall > i,
    .arcade:hover .wall > i,
    .arcade:focus-within .wall > i {
      animation: none;
      opacity: 0.92;
      transform: none;
    }

    /* The ball parks mid-stage rather than vanishing, so the composition still
       reads as a game in progress. */
    .ball,
    .arcade:hover .ball,
    .arcade:focus-within .ball {
      animation: none;
    }

    .ball {
      left: calc(50% - var(--size) / 2);
      top: 12%;
    }
  }
</style>

<script>
  /**
   * Delegated and globally guarded, matching the footer's copy handler: this
   * component carries `transition:persist`, so the listener has to survive
   * client-side navigation without ever binding twice.
   */
  const w = window as unknown as { __breakoutBound?: boolean };

  if (!w.__breakoutBound) {
    w.__breakoutBound = true;

    /**
     * Gate the wall's infinite churn on actually being on screen. The section
     * lives above the footer, so on most visits it is never reached at all —
     * without this, 72 elements animate forever against nothing.
     *
     * Idempotent via `data-observed`, and re-run on navigation: the component
     * carries `transition:persist` today, but a future layout change that drops
     * that would otherwise leave the wall frozen on every page but the first.
     */
    const observeWall = () => {
      const section = document.querySelector<HTMLElement>('.arcade');
      if (!section || section.dataset.observed !== undefined) return;
      section.dataset.observed = '';
      new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            section.toggleAttribute('data-visible', entry.isIntersecting);
          }
        },
        { rootMargin: '200px' },
      ).observe(section);
    };

    observeWall();
    document.addEventListener('astro:page-load', observeWall);

    // Kept as a promise, not a boolean — a hover followed immediately by a
    // click must reuse the in-flight request rather than start a second one.
    let pending: Promise<typeof import('../lib/breakout')> | null = null;
    const load = () => (pending ??= import('../lib/breakout'));

    // Warm the chunk on intent. Costs nothing on a visit that never plays.
    document.addEventListener(
      'pointerenter',
      (e) => {
        if ((e.target as Element | null)?.closest?.('[data-breakout-launch]')) void load();
      },
      { capture: true, passive: true },
    );

    document.addEventListener('click', async (e) => {
      const btn = (e.target as Element | null)?.closest<HTMLElement>('[data-breakout-launch]');
      if (!btn) return;

      btn.setAttribute('data-loading', '');
      try {
        const { openBreakout } = await load();
        openBreakout(btn);
      } catch (err) {
        console.error('[breakout] failed to load', err);
      } finally {
        btn.removeAttribute('data-loading');
      }
    });
  }
</script>
