---
import RuleCross from './RuleCross.astro';
import ToolHeader from './ToolHeader.astro';
import RichText from './RichText.astro';

/*
  Impeccable, in depth. The grid is its actual command set, grouped the way
  its README groups them, with descriptions kept close to the README's own one
  line each. Invocation is `/impeccable <command> <target>`; `pin` makes a
  standalone shortcut. The CI strip uses only documented behaviour: `npx
  impeccable detect` with `--github` annotations, deterministic rules (no count on the
  page — it changes between versions), exit code 2 on findings. Nothing about
  Impeccable here may be invented — it is the section most likely to be read
  by someone who uses the tool. `check:system` beside it is the project's own
  script, not an Impeccable command.
*/
const groups: { name: string; note: string; cmds: [string, string][] }[] = [
  {
    name: 'Plan',
    note: 'Before code exists',
    cmds: [
      ['init', 'Writes `PRODUCT.md` from the codebase'],
      ['document', 'Writes `DESIGN.md`'],
      ['shape', 'Plans the UX before code'],
      ['extract', 'Pulls repeats into the system'],
    ],
  },
  {
    name: 'Steer',
    note: 'Push it a direction',
    cmds: [
      ['bolder', 'Amplifies a safe design'],
      ['quieter', 'Tones down a loud one'],
      ['distill', 'Removes what isn’t needed'],
      ['typeset', 'Fonts, hierarchy, sizing'],
      ['layout', 'Spacing and rhythm'],
      ['colorize', 'Colour for a grey interface'],
      ['animate', 'Transitions and feedback'],
      ['delight', 'Adds personality'],
      ['overdrive', 'Shaders, springs, scroll effects'],
    ],
  },
  {
    name: 'Review & finish',
    note: 'Before it ships',
    cmds: [
      ['critique', 'A scored UX review'],
      ['audit', 'A technical quality report'],
      ['polish', 'The final pass'],
      ['harden', 'Errors, i18n, overflow, edge cases'],
      ['clarify', 'Rewrites unclear copy'],
      ['adapt', 'Screen sizes and devices'],
      ['optimize', 'Loading and rendering'],
      ['onboard', 'First-run and empty states'],
    ],
  },
  {
    name: 'Iterate live',
    note: 'In the browser',
    cmds: [
      ['live', 'Pick an element, cycle variants'],
      ['generate', 'Variants of a named element'],
    ],
  },
];
---

<section
  class="relative border-t border-line px-shell py-section"
  aria-labelledby="impeccable"
  data-blueprint="The Taste Layer"
>
  <RuleCross />
  <ToolHeader id="impeccable" brand="impeccable" eyebrow="Impeccable" title="Taste, as a command" dur="11.9s" delay="7s">
    <p>
      Agents write competent, forgettable UI by default. Impeccable is a design skill for coding
      agents, built on Anthropic’s frontend-design skill, that gives them a vocabulary for taste:
      commands I aim at a narrow target, judged against the <code class="code-inline">PRODUCT.md</code>
      and <code class="code-inline">DESIGN.md</code> it writes for the project.
    </p>
    <p>
      A narrow target beats a whole page. <code class="code-inline">/impeccable critique the pricing cards</code> gets a better answer than “make the site nicer” ever will.
    </p>
  </ToolHeader>

  <div class="relative -mx-shell-pad mt-16 grid grid-cols-1 border-y border-line sm:grid-cols-2 lg:grid-cols-4" data-anim="reveal-batch">
    <span class="bp-sq bp-sq--t bp-sq--l" aria-hidden="true"></span>
    <span class="bp-sq bp-sq--t bp-sq--r" aria-hidden="true"></span>
    <span class="bp-sq bp-sq--b bp-sq--l" aria-hidden="true"></span>
    <span class="bp-sq bp-sq--b bp-sq--r" aria-hidden="true"></span>
    {
      groups.map((g, i) => (
        <div
          class:list={[
            'relative px-shell-pad py-8',
            i > 0 && 'border-t border-line',
            i === 1 && 'sm:border-l sm:border-t-0',
            i === 2 && 'lg:border-l lg:border-t-0',
            i === 3 && 'sm:border-l lg:border-t-0',
          ]}
        >
          {/* Crossings: below sm each internal rule meets both rails; at sm
              (2×2) the row rule crosses the rails and the divider; at lg (1×4)
              the three dividers each meet both frame rules. */}
          {i > 0 && (
            <>
              <span class="bp-sq bp-sq--t bp-sq--l sm:hidden" aria-hidden="true" />
              <span class="bp-sq bp-sq--t bp-sq--r sm:hidden" aria-hidden="true" />
            </>
          )}
          {i === 1 && <span class="bp-sq bp-sq--t bp-sq--l hidden sm:block" aria-hidden="true" />}
          {i === 2 && <span class="bp-sq bp-sq--t bp-sq--l hidden sm:block" aria-hidden="true" />}
          {i === 3 && (
            <>
              <span class="bp-sq bp-sq--t bp-sq--l hidden sm:block lg:hidden" aria-hidden="true" />
              <span class="bp-sq bp-sq--t bp-sq--r hidden sm:block lg:hidden" aria-hidden="true" />
              <span class="bp-sq bp-sq--t bp-sq--l hidden lg:block" aria-hidden="true" />
              <span class="bp-sq bp-sq--b bp-sq--l hidden sm:block" aria-hidden="true" />
            </>
          )}
          {i === 1 && <span class="bp-sq bp-sq--b bp-sq--l hidden lg:block" aria-hidden="true" />}
          {i === 2 && <span class="bp-sq bp-sq--b bp-sq--l hidden lg:block" aria-hidden="true" />}

          <p class="text-[1.0625rem] font-medium text-ink">{g.name}</p>
          <p class="text-[0.9375rem] text-ink-faint">{g.note}</p>
          <ul class="mt-6 space-y-3">
            {g.cmds.map(([c, d]) => (
              <li class="grid grid-cols-[6.25rem_minmax(0,1fr)] items-baseline gap-3">
                <span class="imp-cmd">{c}</span>
                <span class="text-[0.8125rem] leading-snug text-ink-dim"><RichText text={d} /></span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  {/*
    The gates ------------------------------------------------------------
    Two deterministic checks, side by side, because they answer different
    questions. Impeccable asks whether the UI is good; `check:system` asks
    whether it's ours — a hand-built dialog can pass every taste rule and still
    bypass the component system. The system check is the project's own script
    (illustrative findings built on Tribute's real rules: `btn-primary` is
    daisyUI's primary, not the occasion colour — the v3-design skill's own
    non-negotiable; modals extend `BaseModal`; a contract that
    disagrees with its component's code fails. That compares content — classes,
    widths, regions — not whether the doc file was touched, which a one-word
    edit would satisfy). Neither has a
    model in the enforcement path, the State of AI in Design Systems study's
    strongest pattern.
  */}
  <div class="mt-16 max-w-2xl" data-anim="reveal">
    <p class="text-[1.0625rem] font-medium text-ink">Two gates, and neither one is an agent</p>
    <p class="mt-2 text-ink-dim">
      Impeccable judges whether the UI is good. It can’t tell whether it’s ours: a hand-built
      dialog can be beautiful and still go around the system. So a second check runs the system’s
      own rules: daisyUI for structure and the tribute’s theme for brand, documented components
      before new ones, a component’s contract matching its code, and axe for the basics. The agent runs both
      before it hands work back, and both annotate the pull request. Taste stops being a review
      comment someone has to remember to leave, and becomes a check that has to pass.
    </p>
  </div>

  <div class="mt-10 grid gap-6 lg:grid-cols-2" aria-hidden="true" data-anim="reveal-batch">
    <div class="gate">
      <p class="gate__head"><span>Is it good?</span><span>impeccable</span></p>
      <div class="gate__body">
        <p><span class="text-ink-faint"># the one I use most, as its own shortcut</span></p>
        <p><span class="text-accent-warm">/impeccable</span> <span class="text-accent">pin</span> audit</p>
        <p><span class="text-accent-warm">/audit</span></p>
        <p class="mt-3"><span class="text-ink-faint"># the same rules, no agent, on every PR</span></p>
        <p><span class="text-ink-faint">$</span> <span class="text-accent-warm">npx impeccable detect</span> <span class="text-accent">--github</span> src/</p>
        <p><span class="text-ink-faint">exit 2 · findings — the check fails</span></p>
      </div>
    </div>

    <div class="gate">
      <p class="gate__head"><span>Is it ours?</span><span>check:system</span></p>
      <div class="gate__body">
        <p><span class="text-ink-faint">$</span> <span class="text-accent-warm">bun run check:system</span></p>
        <ul class="mt-2 space-y-2">
          {
            [
              ['RecordStep.ts:58', '`btn-primary` on an occasion CTA', 'use `btn` + `--theme-primary-color`'],
              ['UploadSheet.ts:12', 'hand-built dialog', 'extend `BaseModal` · components/modal.md'],
              ['BaseModal.ts:88', 'allows `max-w-xl`; `modal.md` doesn’t list it', 'add it to the contract, or drop it'],
              ['ReviewStep.ts:31', 'button has no accessible name', 'axe · button-name'],
            ].map(([where, what, fix]) => (
              <li class="gate__find">
                <span class="block text-ink-faint">✖ {where}</span>
                <span class="block text-ink"><RichText text={what} /></span>
                <span class="block text-accent">→ <RichText text={fix} /></span>
              </li>
            ))
          }
        </ul>
        <p class="mt-3"><span class="text-ink-faint">exit 1 · 4 findings — the check fails</span></p>
      </div>
    </div>
  </div>
</section>

<style>
  .gate {
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-ui);
    background: var(--color-surface-lift);
  }
  .gate__head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.625rem 1.25rem;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-ink-faint);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }
  .gate__head > span:first-child {
    color: var(--color-ink);
  }
  .gate__body {
    padding: 1rem 1.25rem;
    color: var(--color-ink-dim);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.9;
  }
  .gate__find {
    line-height: 1.6;
  }
  .imp-cmd {
    justify-self: start;
    padding: 0.1rem 0.5rem;
    border: 1px dashed var(--color-line);
    border-radius: var(--radius-ui);
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
</style>
