---
import { brands, type Brand } from '../data/brands';

interface Props {
  name: Brand;
  class?: string;
  /** Decorative by default; pass `label` when the mark is the only thing naming the tool. */
  label?: boolean;
}

const { name, class: className = '', label = false } = Astro.props;
const b = brands[name];
---

<svg
  viewBox={b.viewBox}
  fill="currentColor"
  fill-rule="evenodd"
  class:list={['shrink-0', className]}
  role={label ? 'img' : undefined}
  aria-label={label ? b.title : undefined}
  aria-hidden={label ? undefined : 'true'}
>
  <path d={b.path} />
</svg>
