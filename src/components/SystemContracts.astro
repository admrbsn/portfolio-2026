---
import RuleCross from './RuleCross.astro';
import ToolHeader from './ToolHeader.astro';

/*
  The system (/how-i-work): the design system written for agents as much as
  for people. The setup is the real one — a DESIGN.md of principles, daisyUI
  theme tokens, and one Markdown contract per component — presented, like the
  rest of the page, as how I'd run it today.

  The direction comes from two sources, credited in the footnote:
  - State of AI in Design Systems (July 2026): agent docs that are compiled
    from one source rather than hand-written; enumerated components so
    anything else is provably invented; Atlassian's eval finding that a large
    DESIGN.md costs ~92% more tokens than structured lookup and pushes agents
    to re-create components instead of importing them.
  - Southleft, "What does AI-readiness mean in design systems?": one truth in
    one place, everything else an index; never hand-write lists of
    components or tokens; judgment only improves by running evals, scored on
    the Open Design System Bench axes (imports, apiFidelity, tokenDiscipline,
    a11yStatic, compile, judgment — judgment weighted 30%).
  No eval scores appear on the page: none have been published, and a made-up
  number here would undercut the whole section.

  The mock is CSS-only (radio + :checked), on the Fern pattern: every file in
  one grid cell, inactive ones `visibility: hidden`, so the window is as tall
  as its tallest file and never jumps. Class names are real daisyUI classes.
*/

type Lang = 'md' | 'json';
type Seg = { t: string; c?: string };

const files: { id: string; name: string; status?: 'stable' | 'generated'; lang: Lang; code: string }[] = [
  {
    id: 'button',
    name: 'button.md',
    status: 'stable',
    lang: 'md',
    code: `---
name: Button
status: stable
classes: [btn, btn-primary, btn-ghost, btn-sm, btn-lg]
states: [default, hover, focus, loading, disabled]
use_when: The user starts an action
avoid_when: Going to another page (use a link)
related: [link, icon-button]
a11y:
  - Visible label, or aria-label when icon-only
  - Loading keeps focus and sets aria-busy
---

# Button

One primary per view. Loading swaps the label for a
spinner but keeps the width, so nothing jumps under
a thumb.`,
  },
  {
    id: 'input',
    name: 'input.md',
    status: 'stable',
    lang: 'md',
    code: `---
name: Input
status: stable
classes: [input, input-sm, input-error]
states: [default, focus, error, disabled]
use_when: One line of free text
avoid_when: A fixed set of options (use select)
related: [textarea, select, form-field]
a11y:
  - The label stays visible; a placeholder isn't one
  - Errors are tied to the field with aria-describedby
---

# Input

Errors say what to do next, not what went wrong:
"Add a title so people know who it's for."`,
  },
  {
    id: 'modal',
    name: 'modal.md',
    status: 'stable',
    lang: 'md',
    code: `---
name: Modal
status: stable
classes: [modal, modal-box, modal-action]
states: [closed, open]
use_when: One decision that blocks the flow
avoid_when: More than one decision (use a page)
related: [sheet, alert]
a11y:
  - Native <dialog>; focus is trapped, Esc closes
  - Focus returns to the trigger on close
---

# Modal

Opens as a bottom sheet on a phone. Never stack two.`,
  },
  {
    id: 'index',
    name: 'index.json',
    status: 'generated',
    lang: 'json',
    code: `{
  "source": "docs/components/*.md",
  "note": "Generated on build. Do not edit.",
  "components": [
    { "name": "Button", "status": "stable",
      "use_when": "The user starts an action",
      "doc": "docs/components/button.md" },
    { "name": "Input", "status": "stable",
      "use_when": "One line of free text",
      "doc": "docs/components/input.md" },
    { "name": "Modal", "status": "stable",
      "use_when": "One decision that blocks the flow",
      "doc": "docs/components/modal.md" },
    { "name": "Banner", "status": "deprecated",
      "replaced_by": "Alert" }
  ]
}`,
  },
];

const DEFAULT_FILE = 'button';

/* A tiny highlighter: frontmatter keys and list markers in warm, values and
   JSON strings in the accent, Markdown headings in ink, prose dim. */
function highlight(src: string, lang: Lang): Seg[][] {
  let inFront = false;
  return src.split('\n').map((line): Seg[] => {
    if (lang === 'json') {
      const segs: Seg[] = [];
      const re = /("(?:[^"\\]|\\.)*")(\s*:)?/g;
      let last = 0;
      for (const m of line.matchAll(re)) {
        if (m.index! > last) segs.push({ t: line.slice(last, m.index), c: 'sy-p' });
        segs.push({ t: m[1], c: m[2] ? 'sy-k' : 'sy-v' });
        if (m[2]) segs.push({ t: m[2], c: 'sy-p' });
        last = m.index! + m[0].length;
      }
      if (last < line.length) segs.push({ t: line.slice(last), c: 'sy-p' });
      return segs;
    }
    if (line === '---') {
      inFront = !inFront;
      return [{ t: line, c: 'sy-p' }];
    }
    if (inFront) {
      const kv = line.match(/^([a-z_0-9]+)(:)(.*)$/);
      if (kv) return [{ t: kv[1], c: 'sy-k' }, { t: kv[2], c: 'sy-p' }, { t: kv[3], c: 'sy-v' }];
      const li = line.match(/^(\s*- )(.*)$/);
      if (li) return [{ t: li[1], c: 'sy-k' }, { t: li[2] }];
      return [{ t: line }];
    }
    if (line.startsWith('#')) return [{ t: line, c: 'sy-h' }];
    return [{ t: line }];
  });
}

const rendered = files.map((f) => ({ ...f, lines: highlight(f.code, f.lang) }));

const principles = [
  {
    t: 'Contracts, not prose',
    b: 'The frontmatter is what agents check against; the prose under it is for people. A variant that isn’t listed doesn’t exist.',
  },
  {
    t: 'Generated, never hand-listed',
    b: 'The index is built from the docs, and DESIGN.md points to it instead of repeating it. Hand-written lists are the first thing to go stale.',
  },
  {
    t: 'DESIGN.md stays principles',
    b: 'How it should feel and why, not every token. A long manifest teaches agents to rebuild components instead of reaching for them.',
  },
  {
    t: 'Measured, not assumed',
    b: 'Five real tasks, run with and without the system, scored on imports, API fidelity, token discipline, accessibility, compile and judgment. If the docs don’t move the score, they’re decoration.',
  },
];

const css = rendered
  .map(
    (f) =>
      `.sys #sys-f-${f.id}:checked ~ .sys-body .sys-file--${f.id}{visibility:visible}` +
      `.sys #sys-f-${f.id}:checked ~ .sys-body .sys-nav__item--${f.id}{background:var(--color-surface);color:var(--color-ink)}`,
  )
  .join('\n');
---

<section
  class="relative border-t border-line px-shell py-section"
  aria-labelledby="system"
  data-blueprint="The Contract"
  data-dead="bottom"
>
  <RuleCross />
  <ToolHeader id="system" eyebrow="The system" title="A system agents can read" dur="12.7s" delay="5s">
    <p>
      Agents don’t read a design system the way people do. They need to know what exists, what
      it’s for, and what they’re not allowed to invent. So ours is written for them as much as
      for us: <code class="code-inline">DESIGN.md</code> for the principles, and one contract per
      component in <code class="code-inline">docs/components</code>, built on daisyUI’s theme
      tokens. Class names come from daisyUI’s own docs, so ours only hold our decisions.
    </p>
    <p>
      Find the system first, check against it after. The agent reads the index before it builds,
      and the gates in the next section check that it used what it found.
    </p>
  </ToolHeader>

  {/* The docs folder ----------------------------------------------------- */}
  <div class="sys mt-16 overflow-hidden rounded-ui border border-line bg-surface-lift" aria-hidden="true" data-anim="reveal">
    {rendered.map((f) => <input type="radio" name="sys-file" id={`sys-f-${f.id}`} class="sr-only" tabindex="-1" checked={f.id === DEFAULT_FILE} />)}

    <div class="sys-body">
      <div class="flex items-center justify-between border-b border-line px-5 py-2.5 font-mono text-[0.6875rem] text-ink-faint">
        <span>docs / components</span>
        <span class="hidden sm:inline">one truth · everything else is an index</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-[12rem_minmax(0,1fr)]">
        {/* Files: a row that scrolls on phones, a column from md. */}
        <ul class="sys-nav flex overflow-x-auto border-b border-line py-2 font-mono text-[0.75rem] md:block md:overflow-visible md:border-b-0 md:border-r md:py-4" data-lenis-prevent>
          {
            rendered.map((f) => (
              <li class="shrink-0">
                <label for={`sys-f-${f.id}`} class={`sys-nav__item sys-nav__item--${f.id}`}>
                  {f.name}
                  {f.status === 'generated' && <span class="sys-tag">gen</span>}
                </label>
              </li>
            ))
          }
        </ul>

        <div class="sys-files">
          {
            rendered.map((f) => (
              <pre class={`sys-file sys-file--${f.id}`} data-lenis-prevent>
                {/* One row per line: whitespace inside a `pre` line renders. */}
                {f.lines.map((segs) => (
                  <span class="sys-line">{segs.map((s) => (s.c ? <span class={s.c}>{s.t}</span> : s.t))}</span>
                ))}
              </pre>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  {/* Above the ruled grid, not under it: the band below is hatched, and
      type doesn't go on the hatch. */}
  <p class="mt-6 max-w-2xl text-[0.8125rem] leading-relaxed text-ink-faint">
    Shaped by Kaelig Deloumeau-Prigent’s
    <a href="https://state-of-ai-in-design-systems.netlify.app/" class="sys-src">State of AI in Design Systems</a>
    (July 2026) and Southleft’s
    <a href="https://southleft.com/insights/design-systems/what-does-ai-readiness-mean-in-design-systems/" class="sys-src">What does AI-readiness mean in design systems?</a>
  </p>

  {/* The rules ----------------------------------------------------------- */}
  <div class="relative -mx-shell-pad mt-12 grid grid-cols-1 border-y border-line sm:grid-cols-2 lg:grid-cols-4" data-anim="reveal-batch">
    <span class="bp-sq bp-sq--t bp-sq--l" aria-hidden="true"></span>
    <span class="bp-sq bp-sq--t bp-sq--r" aria-hidden="true"></span>
    <span class="bp-sq bp-sq--b bp-sq--l" aria-hidden="true"></span>
    <span class="bp-sq bp-sq--b bp-sq--r" aria-hidden="true"></span>
    {
      principles.map((p, i) => (
        <div
          class:list={[
            'relative px-shell-pad py-8',
            i > 0 && 'border-t border-line',
            i === 1 && 'sm:border-l sm:border-t-0',
            i === 2 && 'lg:border-l lg:border-t-0',
            i === 3 && 'sm:border-l lg:border-t-0',
          ]}
        >
          {/* Crossings, as in the Impeccable grid: below sm each internal rule
              meets both rails; at sm (2×2) the row rule crosses the rails and
              the divider; at lg (1×4) each divider meets both frame rules. */}
          {i > 0 && (
            <>
              <span class="bp-sq bp-sq--t bp-sq--l sm:hidden" aria-hidden="true" />
              <span class="bp-sq bp-sq--t bp-sq--r sm:hidden" aria-hidden="true" />
            </>
          )}
          {i === 1 && <span class="bp-sq bp-sq--t bp-sq--l hidden sm:block" aria-hidden="true" />}
          {i === 2 && <span class="bp-sq bp-sq--t bp-sq--l hidden sm:block" aria-hidden="true" />}
          {i === 3 && (
            <>
              <span class="bp-sq bp-sq--t bp-sq--l hidden sm:block lg:hidden" aria-hidden="true" />
              <span class="bp-sq bp-sq--t bp-sq--r hidden sm:block lg:hidden" aria-hidden="true" />
              <span class="bp-sq bp-sq--t bp-sq--l hidden lg:block" aria-hidden="true" />
              <span class="bp-sq bp-sq--b bp-sq--l hidden sm:block" aria-hidden="true" />
            </>
          )}
          {i === 1 && <span class="bp-sq bp-sq--b bp-sq--l hidden lg:block" aria-hidden="true" />}
          {i === 2 && <span class="bp-sq bp-sq--b bp-sq--l hidden lg:block" aria-hidden="true" />}

          <p class="text-[1.0625rem] font-medium text-ink">{p.t}</p>
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-dim">{p.b}</p>
        </div>
      ))
    }
  </div>

</section>

<style is:inline set:html={css}></style>

<style>
  .sys-nav__item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 1.25rem;
    color: var(--color-ink-dim);
    white-space: nowrap;
    cursor: pointer;
    transition:
      color var(--dur-fast) ease,
      background-color var(--dur-fast) ease;
  }
  .sys-nav__item:hover {
    color: var(--color-ink);
  }
  .sys-tag {
    padding: 0 0.35rem;
    border: 1px dashed var(--color-line);
    border-radius: var(--radius-ui);
    color: var(--color-ink-faint);
    font-size: 0.625rem;
  }

  .sys-files {
    display: grid;
    min-width: 0;
  }
  .sys-file {
    grid-area: 1 / 1;
    visibility: hidden;
    margin: 0;
    padding: 1.5rem;
    overflow-x: auto;
    color: var(--color-ink-dim);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.7;
    /* `pre` on each line, not here: the template's own whitespace between
       the line spans would otherwise render as blank lines and indent. */
    white-space: normal;
  }
  .sys-line {
    display: block;
    min-height: 1.7em;
    white-space: pre;
  }

  .sy-k {
    color: var(--color-accent-warm);
  }
  .sy-v {
    color: var(--color-accent);
  }
  .sy-p {
    color: var(--color-ink-faint);
  }
  .sy-h {
    color: var(--color-ink);
  }

  .sys-src {
    color: var(--color-ink-dim);
    text-decoration: underline;
    text-decoration-color: var(--color-line);
    text-underline-offset: 4px;
    transition: color var(--dur-fast) ease;
  }
  .sys-src:hover {
    color: var(--color-accent);
  }
</style>
