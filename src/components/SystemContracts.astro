---
import RuleCross from './RuleCross.astro';
import ToolHeader from './ToolHeader.astro';

/*
  The system (/how-i-work): the design system written for agents as much as
  for people, drawn from the real Tribute repo (~/Sites/tribute):

  - PRODUCT.md at the root (Impeccable's product schema) — intent.
  - `.agents/skills/v3-design/SKILL.md` — first step and non-negotiables.
  - `docs/design/v3/README.md` — a router keyed by the paths being edited,
    so an agent opens only the doc it needs.
  - `daisy-components.md` — the daisyUI subset, linking daisyUI's llms.txt
    rather than vendoring it; daisyUI for structure, each tribute's theme
    variables (`--theme-primary-color`) for brand. `btn-primary` is daisyUI's
    primary, not the occasion colour — the real non-negotiable the gate
    finding in ImpeccableDeep is built on.

  The page tells the expert version of this setup and the repo is brought up
  to it afterwards (Adam's call, 2026-11-08): two files here, a
  per-component contract (`components/modal.md`, from the real
  `product-modals-slideouts.md` and `BaseModal.ts`) and an index generated
  from the contracts, are that version. So are the gates, the drift check and
  the evals the page describes. Keep the copy in the present tense; if the
  repo ever stops matching, fix the repo.

  Sources, credited in the footnote:
  - State of AI in Design Systems (July 2026): agent docs compiled from one
    source, not hand-written; enumerated components so anything else is
    provably invented; Atlassian's eval finding that a large DESIGN.md costs
    ~92% more tokens than structured lookup and pushes agents to re-create
    components instead of importing them.
  - Southleft, "What does AI-readiness mean in design systems?": one truth in
    one place, everything else an index; judgment only improves by running
    evals, on the Open Design System Bench axes. No eval scores on the page:
    none are published, and a made-up number would undercut the section.

  Interaction is CSS-only (radio + :checked). The trace steps and the file
  tabs are both labels for the same radios, so clicking a step opens the file
  the agent read at that step. Every file sits in one grid cell, inactive ones
  `visibility: hidden`, so the window never jumps.
*/

type Lang = 'md' | 'json';
type Seg = { t: string; c?: string };

const files: { id: string; name: string; tag?: string; lang: Lang; code: string }[] = [
  {
    id: 'skill',
    name: 'SKILL.md',
    lang: 'md',
    code: `---
name: v3-design
description: Tribute v3 UI conventions. Use when
  editing v3 templates, components or styles.
---

# V3 design system

## First step
Read docs/design/v3/README.md and open only the
linked doc for the files you are changing.

## Non-negotiables
1. No daisyUI on marketing pages.
2. Branded primary buttons: btn +
   var(--theme-primary-color), not btn-primary.
3. Modals extend BaseModal.`,
  },
  {
    id: 'router',
    name: 'README.md',
    lang: 'md',
    code: `# Tribute v3 design (for humans and agents)

## Which doc to open
| You are editing          | Read                  |
| tribute/v3/src/**        | product-app.md        |
| Modals or slideouts      | components/modal.md   |
| Daisy class names        | daisy-components.md   |
| templates/v3/homepage**  | marketing-pages.md    |

## Do not
- Add daisyUI classes to marketing templates.
- Copy daisyUI's llms.txt into the repo. Link it.

## Maintaining these docs
Change a token, update its table in the same PR.`,
  },
  {
    id: 'index',
    name: 'index.json',
    tag: 'gen',
    lang: 'json',
    code: `{
  "source": "docs/design/v3/components/*.md",
  "note": "Generated on build. Do not edit.",
  "components": [
    { "name": "Modal", "status": "stable",
      "extends": "BaseModal.ts",
      "doc": "components/modal.md" },
    { "name": "Slideout", "status": "stable",
      "extends": "BaseSlideout.ts",
      "doc": "components/slideout.md" },
    { "name": "Button", "status": "stable",
      "doc": "components/button.md" },
    { "name": "Alert", "status": "stable",
      "doc": "components/alert.md" }
  ]
}`,
  },
  {
    id: 'modal',
    name: 'modal.md',
    lang: 'md',
    code: `---
name: Modal
status: stable
extends: BaseModal.ts
classes: [modal, modal-box, modal-backdrop]
regions: [header, content, footer?]
widths: [max-w-md, max-w-lg, max-w-2xl]
use_when: One decision that blocks the flow
avoid_when: More than one decision (use a slideout)
a11y:
  - Native <dialog>; Esc and the backdrop close it
  - Focus returns to the trigger on close
---

# Modal

Pick the closest existing width before adding one.
Header and footer share the chrome colours,
--modal-header-bg and --modal-border.`,
  },
  {
    id: 'daisy',
    name: 'daisy-components.md',
    lang: 'md',
    code: `# daisyUI subset (product app)

Upstream: daisyui.com/llms.txt (linked, not copied)

## Daisy vs Tribute theme vars
| Need                    | Use                       |
| Occasion-branded action | btn + --theme-primary-... |
| Cancel, low emphasis    | btn btn-ghost             |
| Dialog structure        | modal, modal-box          |
| Status, warnings        | alert alert-soft          |

btn-primary is daisyUI's primary, not the occasion
colour. Avoid it for main actions.`,
  },
];

const DEFAULT_FILE = 'skill';

/* One task, the route the agent takes. `file` makes a step a label for that
   file's radio; steps without one are the task and the outcome. */
const trace: { file?: string; k: string; t: string; done?: boolean }[] = [
  { k: 'Task', t: 'Add a “ready to send?” confirm before a recording uploads' },
  { file: 'skill', k: 'Skill', t: 'v3-design loads: the edit is in tribute/v3/src' },
  { file: 'router', k: 'Route', t: 'The router opens one doc, not the whole system' },
  { file: 'index', k: 'Discover', t: 'Modal and Button already exist. Nothing new to invent' },
  { file: 'modal', k: 'Contract', t: 'Extend BaseModal, max-w-lg, header and footer regions' },
  { file: 'daisy', k: 'Tokens', t: 'The CTA is btn + the tribute’s theme colour, not btn-primary' },
  { k: 'Gates', t: 'check:system and impeccable detect both pass', done: true },
  { k: 'You', t: 'Review the pull request, then merge', done: true },
];

/* The pipeline the section sits in, left to right. The system is the one
   stop with parts, and the one this section opens. */
const stack: { k: string; t: string; parts?: string[] }[] = [
  { k: 'Explore', t: 'Relume · Claude Design' },
  { k: 'The system', t: 'What every agent reads first', parts: ['PRODUCT.md', 'daisyUI', 'Theme tokens', 'Component docs'] },
  { k: 'Build', t: 'Claude Code' },
  { k: 'Check', t: 'Two gates · review' },
  { k: 'Measure', t: 'PostHog' },
];

/* A tiny highlighter: frontmatter keys and list markers in warm, values and
   JSON strings in the accent, Markdown headings in ink, table pipes faint. */
function highlight(src: string, lang: Lang): Seg[][] {
  let inFront = false;
  return src.split('\n').map((line): Seg[] => {
    if (lang === 'json') {
      const segs: Seg[] = [];
      const re = /("(?:[^"\\]|\\.)*")(\s*:)?/g;
      let last = 0;
      for (const m of line.matchAll(re)) {
        if (m.index! > last) segs.push({ t: line.slice(last, m.index), c: 'sy-p' });
        segs.push({ t: m[1], c: m[2] ? 'sy-k' : 'sy-v' });
        if (m[2]) segs.push({ t: m[2], c: 'sy-p' });
        last = m.index! + m[0].length;
      }
      if (last < line.length) segs.push({ t: line.slice(last), c: 'sy-p' });
      return segs;
    }
    if (line === '---') {
      inFront = !inFront;
      return [{ t: line, c: 'sy-p' }];
    }
    if (inFront) {
      const kv = line.match(/^([a-z_0-9]+)(:)(.*)$/);
      if (kv) return [{ t: kv[1], c: 'sy-k' }, { t: kv[2], c: 'sy-p' }, { t: kv[3], c: 'sy-v' }];
      const li = line.match(/^(\s*- )(.*)$/);
      if (li) return [{ t: li[1], c: 'sy-k' }, { t: li[2] }];
      return [{ t: line }];
    }
    if (line.startsWith('|')) {
      return line.split(/(\|)/).filter(Boolean).map((p) => (p === '|' ? { t: p, c: 'sy-p' } : { t: p }));
    }
    if (line.startsWith('#')) return [{ t: line, c: 'sy-h' }];
    const li = line.match(/^(- |\d+\. )(.*)$/);
    if (li) return [{ t: li[1], c: 'sy-k' }, { t: li[2] }];
    return [{ t: line }];
  });
}

const rendered = files.map((f) => ({ ...f, lines: highlight(f.code, f.lang) }));

const principles = [
  {
    t: 'Route, don’t load',
    b: 'The skill reads one router and opens only the doc for the files being changed. One long manifest teaches agents to rebuild components instead of reaching for them.',
  },
  {
    t: 'Contracts, not prose',
    b: 'Each component doc opens with a short structured header: what it is, what it allows, when to use it. Agents and the gates check against that; the prose is for people. The index is built from the headers, never typed by hand.',
  },
  {
    t: 'Link, don’t copy',
    b: 'daisyUI’s own llms.txt stays upstream and the docs link to it. A copied vocabulary goes stale the day daisyUI ships, and our docs only hold our decisions.',
  },
  {
    t: 'Measured, not assumed',
    b: 'Five real tasks, run with and without the system, scored on reuse, token discipline, accessibility and judgment. If the docs don’t move the score, they’re decoration.',
  },
];

const css = rendered
  .map(
    (f) =>
      `.sys #sys-f-${f.id}:checked ~ .sys-body .sys-file--${f.id}{visibility:visible}` +
      `.sys #sys-f-${f.id}:checked ~ .sys-body .sys-tab--${f.id}{color:var(--color-ink);border-color:var(--color-accent)}` +
      `.sys #sys-f-${f.id}:checked ~ .sys-body .sys-step--${f.id}{background:var(--color-surface-lift);border-color:color-mix(in oklab,var(--color-accent) 55%,var(--color-line))}` +
      `.sys #sys-f-${f.id}:checked ~ .sys-body .sys-step--${f.id} .sys-step__k{color:var(--color-accent)}`,
  )
  .join('\n');
---

<section
  class="relative border-t border-line px-shell py-section"
  aria-labelledby="system"
  data-blueprint="The Contract"
  data-dead="bottom"
>
  <RuleCross />
  <ToolHeader id="system" eyebrow="The system" title="A system agents can read" dur="12.7s" delay="5s">
    <p>
      Agents don’t read a design system the way people do. They need to know what exists, what
      it’s for, and what they’re not allowed to invent. On Tribute that’s four layers:
      <code class="code-inline">PRODUCT.md</code> for the intent, daisyUI for structure, each
      tribute’s theme tokens for its brand, and component docs for the patterns, with a design
      skill that routes every edit to the one doc it needs.
    </p>
    <p>
      Find the system first, check against it after. Below is one real task, step by step. Click
      a step to open the file the agent read.
    </p>
  </ToolHeader>

  {/* The pipeline ------------------------------------------------------- */}
  <ol class="sys-stack mt-14" aria-label="Where the system sits" data-anim="reveal">
    {
      stack.map((s, i) => (
        <>
          {i > 0 && <li class="sys-stack__link" aria-hidden="true" />}
          <li class:list={['sys-stack__stop', s.parts && 'sys-stack__stop--here']}>
            <span class="block font-mono text-[0.625rem] uppercase tracking-[0.14em] text-ink-faint">{s.k}</span>
            <span class="mt-1 block text-[0.875rem] text-ink">{s.t}</span>
            {s.parts && (
              <span class="mt-3 flex flex-wrap gap-1.5">
                {s.parts.map((p) => (
                  <span class="sys-chip">{p}</span>
                ))}
              </span>
            )}
          </li>
        </>
      ))
    }
  </ol>

  {/* One task, traced ---------------------------------------------------- */}
  <div class="sys mt-12" data-anim="reveal">
    {rendered.map((f) => <input type="radio" name="sys-file" id={`sys-f-${f.id}`} class="sr-only" tabindex="-1" checked={f.id === DEFAULT_FILE} />)}

    <div class="sys-body grid gap-6 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]">
      <ol class="space-y-2" aria-hidden="true">
        {
          trace.map((s, i) => {
            const inner = (
              <>
                <span class="sys-step__n">{String(i).padStart(2, '0')}</span>
                <span class="min-w-0 flex-1">
                  <span class="sys-step__k">{s.k}</span>
                  <span class="mt-0.5 block text-[0.875rem] leading-snug text-ink">{s.t}</span>
                </span>
                {s.done && <span class="sys-step__ok">✓</span>}
              </>
            );
            return (
              <li>
                {s.file ? (
                  <label for={`sys-f-${s.file}`} class={`sys-step sys-step--link sys-step--${s.file}`}>
                    {inner}
                  </label>
                ) : (
                  <div class:list={['sys-step', i === 0 && 'sys-step--task']}>{inner}</div>
                )}
              </li>
            );
          })
        }
      </ol>

      <div class="min-w-0 overflow-hidden rounded-ui border border-line bg-surface-lift" aria-hidden="true">
        <div class="flex items-center justify-between border-b border-line px-5 py-2.5 font-mono text-[0.6875rem] text-ink-faint">
          <span>docs / design / v3</span>
          <span class="hidden sm:inline">one truth · everything else is an index</span>
        </div>
        <ul class="sys-tabs flex overflow-x-auto border-b border-line px-3 font-mono text-[0.6875rem]">
          {
            rendered.map((f) => (
              <li class="shrink-0">
                <label for={`sys-f-${f.id}`} class={`sys-tab sys-tab--${f.id}`}>
                  {f.name}
                  {f.tag && <span class="sys-tag">{f.tag}</span>}
                </label>
              </li>
            ))
          }
        </ul>
        <div class="sys-files">
          {
            rendered.map((f) => (
              <pre class={`sys-file sys-file--${f.id}`}>
                {/* One row per line: whitespace inside a `pre` line renders. */}
                {f.lines.map((segs) => (
                  <span class="sys-line">{segs.map((s) => (s.c ? <span class={s.c}>{s.t}</span> : s.t))}</span>
                ))}
              </pre>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  {/* Above the ruled grid, not under it: the band below is hatched, and
      type doesn't go on the hatch. */}
  <p class="mt-6 max-w-2xl text-[0.8125rem] leading-relaxed text-ink-faint">
    Trimmed from Tribute’s design docs. Shaped by Kaelig Deloumeau-Prigent’s
    <a href="https://state-of-ai-in-design-systems.netlify.app/" class="sys-src">State of AI in Design Systems</a>
    (July 2026) and Southleft’s
    <a href="https://southleft.com/insights/design-systems/what-does-ai-readiness-mean-in-design-systems/" class="sys-src">What does AI-readiness mean in design systems?</a>
  </p>

  {/* The rules ----------------------------------------------------------- */}
  <div class="relative -mx-shell-pad mt-12 grid grid-cols-1 border-y border-line sm:grid-cols-2 lg:grid-cols-4" data-anim="reveal-batch">
    <span class="bp-sq bp-sq--t bp-sq--l" aria-hidden="true"></span>
    <span class="bp-sq bp-sq--t bp-sq--r" aria-hidden="true"></span>
    <span class="bp-sq bp-sq--b bp-sq--l" aria-hidden="true"></span>
    <span class="bp-sq bp-sq--b bp-sq--r" aria-hidden="true"></span>
    {
      principles.map((p, i) => (
        <div
          class:list={[
            'relative px-shell-pad py-8',
            i > 0 && 'border-t border-line',
            i === 1 && 'sm:border-l sm:border-t-0',
            i === 2 && 'lg:border-l lg:border-t-0',
            i === 3 && 'sm:border-l lg:border-t-0',
          ]}
        >
          {/* Crossings, as in the Impeccable grid: below sm each internal rule
              meets both rails; at sm (2×2) the row rule crosses the rails and
              the divider; at lg (1×4) each divider meets both frame rules. */}
          {i > 0 && (
            <>
              <span class="bp-sq bp-sq--t bp-sq--l sm:hidden" aria-hidden="true" />
              <span class="bp-sq bp-sq--t bp-sq--r sm:hidden" aria-hidden="true" />
            </>
          )}
          {i === 1 && <span class="bp-sq bp-sq--t bp-sq--l hidden sm:block" aria-hidden="true" />}
          {i === 2 && <span class="bp-sq bp-sq--t bp-sq--l hidden sm:block" aria-hidden="true" />}
          {i === 3 && (
            <>
              <span class="bp-sq bp-sq--t bp-sq--l hidden sm:block lg:hidden" aria-hidden="true" />
              <span class="bp-sq bp-sq--t bp-sq--r hidden sm:block lg:hidden" aria-hidden="true" />
              <span class="bp-sq bp-sq--t bp-sq--l hidden lg:block" aria-hidden="true" />
              <span class="bp-sq bp-sq--b bp-sq--l hidden sm:block" aria-hidden="true" />
            </>
          )}
          {i === 1 && <span class="bp-sq bp-sq--b bp-sq--l hidden lg:block" aria-hidden="true" />}
          {i === 2 && <span class="bp-sq bp-sq--b bp-sq--l hidden lg:block" aria-hidden="true" />}

          <p class="text-[1.0625rem] font-medium text-ink">{p.t}</p>
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-dim">{p.b}</p>
        </div>
      ))
    }
  </div>
</section>

<style is:inline set:html={css}></style>

<style>
  /* The pipeline: dashed stops on solid links, the PostHog loop's grammar.
     A row from lg; below it a column, the links turning vertical. */
  .sys-stack {
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }
  .sys-stack__stop {
    padding: 0.75rem 1rem;
    border: 1px dashed var(--color-line);
    border-radius: var(--radius-ui);
    background: var(--color-surface);
  }
  .sys-stack__stop--here {
    border-style: solid;
    border-color: var(--color-accent);
    background: var(--color-surface-lift);
  }
  .sys-stack__link {
    align-self: center;
    width: 1px;
    height: 1rem;
    background: var(--color-line);
  }
  @media (min-width: 64rem) {
    .sys-stack {
      flex-direction: row;
      align-items: center;
    }
    .sys-stack__stop {
      flex: 0 1 auto;
    }
    .sys-stack__stop--here {
      flex: 1 1 22rem;
    }
    .sys-stack__link {
      flex: 1 1 1.5rem;
      min-width: 1rem;
      width: auto;
      height: 1px;
    }
  }
  .sys-chip {
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-ui);
    color: var(--color-ink-dim);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  /* The trace */
  .sys-step {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    padding: 0.625rem 0.875rem;
    border: 1px solid transparent;
    border-radius: var(--radius-ui);
    transition:
      background-color var(--dur-fast) ease,
      border-color var(--dur-fast) ease;
  }
  .sys-step--link {
    cursor: pointer;
  }
  .sys-step--link:hover {
    border-color: var(--color-line);
  }
  .sys-step--task {
    border: 1px dashed var(--color-line);
  }
  .sys-step__n {
    padding-top: 0.15rem;
    color: var(--color-ink-faint);
    font-family: var(--font-mono);
    font-size: 0.625rem;
  }
  .sys-step__k {
    display: block;
    color: var(--color-ink-faint);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: color var(--dur-fast) ease;
  }
  .sys-step__ok {
    color: var(--color-status);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  /* The file window */
  .sys-tabs {
    scrollbar-width: none;
  }
  .sys-tabs::-webkit-scrollbar {
    display: none;
  }
  .sys-tab {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.65rem;
    border-bottom: 1px solid transparent;
    margin-bottom: -1px;
    color: var(--color-ink-faint);
    white-space: nowrap;
    cursor: pointer;
    transition: color var(--dur-fast) ease;
  }
  .sys-tab:hover {
    color: var(--color-ink-dim);
  }
  .sys-tag {
    padding: 0 0.35rem;
    border: 1px dashed var(--color-line);
    border-radius: var(--radius-ui);
    color: var(--color-ink-faint);
    font-size: 0.625rem;
  }

  .sys-files {
    display: grid;
    min-width: 0;
  }
  .sys-file {
    grid-area: 1 / 1;
    visibility: hidden;
    margin: 0;
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
    color: var(--color-ink-dim);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.7;
    /* `pre` on each line, not here: the template's own whitespace between
       the line spans would otherwise render as blank lines and indent. */
    white-space: normal;
  }
  .sys-line {
    display: block;
    min-height: 1.7em;
    white-space: pre;
  }

  .sy-k {
    color: var(--color-accent-warm);
  }
  .sy-v {
    color: var(--color-accent);
  }
  .sy-p {
    color: var(--color-ink-faint);
  }
  .sy-h {
    color: var(--color-ink);
  }

  .sys-src {
    color: var(--color-ink-dim);
    text-decoration: underline;
    text-decoration-color: var(--color-line);
    text-underline-offset: 4px;
    transition: color var(--dur-fast) ease;
  }
  .sys-src:hover {
    color: var(--color-accent);
  }
</style>
