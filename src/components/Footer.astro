---
const socials = [
  { href: 'mailto:hi@adam.build', label: 'Email' },
  { href: 'https://dribbble.com/', label: 'Dribbble' },
  { href: 'https://www.linkedin.com/', label: 'LinkedIn' },
  { href: 'https://github.com/', label: 'GitHub' },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-line px-gutter py-14">
  <div class="flex flex-col gap-10 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-micro uppercase tracking-[0.14em] text-ink-faint">Available for work</p>
      <a
        href="mailto:hi@adam.build"
        class="mt-3 block font-display text-title text-ink transition-colors hover:text-accent"
      >
        hi@adam.build
      </a>
    </div>

    <ul class="flex flex-wrap gap-x-6 gap-y-2">
      {
        socials.map((s) => (
          <li>
            <a
              href={s.href}
              class="text-micro uppercase tracking-[0.14em] text-ink-dim transition-colors hover:text-ink"
              rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              target={s.href.startsWith('http') ? '_blank' : undefined}
            >
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <p class="mt-14 text-micro uppercase tracking-[0.14em] text-ink-faint">
    &copy; {year} — Colorado
  </p>
</footer>
