---

<footer class="relative border-t border-line px-gutter py-28 text-center" data-blueprint="Footer">
  <p class="text-micro uppercase tracking-[0.2em] text-ink-faint">Message me</p>

  {/* Click-to-copy. Real text underneath, so screen readers read the address;
      the label doubles as an aria-live region announcing "Copied".

      Deliberately NOT `uppercase`, unlike every other label in this footer.
      The rest are chrome, where caps is a typographic device; this one is a
      literal string a visitor is meant to read as an address and retype. Caps
      makes it look like a heading rather than an email — and implies a casing
      that isn't the one on the clipboard. */}
  {/* `data-cursor-label` is read by <Cursor>; the visible hint below stays as
      the non-JS / touch fallback and as the aria-live target. */}
  {/* The hover is the same `.accent-gradient` that carries "shampoo bottles" on
      the home page, not a flat accent — but `background-image` is not an
      animatable property, so it cannot be transitioned in over the ink.

      Instead the gradient is a second copy of the address stacked on top of the
      first, and only its *opacity* moves. It is a real `<span aria-hidden>`
      rather than a `::after` with `content: attr(data-copy)`: generated content
      duplicating visible text is announced by some screen readers, which would
      read the address twice on a button whose whole job is to hand it over once.

      The two copies align because the overlay inherits every metric that
      matters (family, size, `leading-none`, the footer's `text-center`) and the
      button has no padding for `inset: 0` to disagree with. */}
  <button
    type="button"
    data-copy={email}
    data-cursor-label="Click to copy"
    class="email-copy mx-auto mt-8 block font-display text-[clamp(2.25rem,7vw,5rem)] leading-none text-ink"
    aria-describedby="copy-hint"
  >
    {email}
    <span class="email-copy__accent accent-gradient" aria-hidden="true">{email}</span>
  </button>

  <p
    id="copy-hint"
    data-copy-label
    aria-live="polite"
    class="mt-8 text-micro uppercase tracking-[0.2em] text-ink-faint"
  >
    Click to copy
  </p>

  <ul class="mt-24 flex flex-wrap justify-center gap-x-8 gap-y-3">
    {
      socials.map((s) => (
        <li>
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            data-cursor-label="Visit"
            class="inline-flex items-center gap-2 text-micro uppercase tracking-[0.14em] text-ink-dim transition-colors hover:text-ink"
          >
            <svg
              viewBox={s.viewBox}
              fill="currentColor"
              aria-hidden="true"
              class="h-[1.15em] w-[1.15em] shrink-0"
            >
              <path fill-rule={s.fillRule} d={s.icon} />
            </svg>
            {s.label}
          </a>
        </li>
      ))
    }
  </ul>

  <p class="mt-12 text-micro uppercase tracking-[0.14em] text-ink-faint">
    &copy; {year} Adam Robertson. All rights reserved.
  </p>
</footer>

<style>
  .email-copy {
    position: relative;
  }

  .email-copy__accent {
    position: absolute;
    inset: 0;
    opacity: 0;
    /* Never intercepts the click — the button underneath owns it. */
    pointer-events: none;
    transition: opacity var(--dur-fast) ease;
  }

  /* `:focus-visible` too, so a keyboard visit gets the same signal the pointer
     does rather than only the focus ring. */
  .email-copy:hover .email-copy__accent,
  .email-copy:focus-visible .email-copy__accent {
    opacity: 1;
  }
</style>

<script is:inline>
  // Delegated + guarded so it binds exactly once and survives the footer's
  // transition:persist across client-side navigations.
  if (!window.__copyEmailBound) {
    window.__copyEmailBound = true;
    document.addEventListener('click', async (e) => {
      const btn = e.target.closest('[data-copy]');
      if (!btn) return;
      const value = btn.getAttribute('data-copy');
      let ok = true;
      try {
        await navigator.clipboard.writeText(value);
      } catch {
        ok = false;
      }
      const footer = btn.closest('footer');
      const label = footer && footer.querySelector('[data-copy-label]');
      if (!label) return;
      if (!label.dataset.default) label.dataset.default = label.textContent;
      clearTimeout(label._t);
      label.textContent = ok ? 'Copied!' : 'Press ⌘C to copy';
      label._t = setTimeout(() => {
        label.textContent = label.dataset.default;
      }, 2000);
    });
  }
</script>
