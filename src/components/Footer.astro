---
const email = 'hi@adamrobertson.co';
const year = new Date().getFullYear();

// LinkedIn and GitHub are the real handles from the resume; Dribbble and X.com
// point at the site root for now — swap in real profile URLs. Icons are the
// official brand marks (simple-icons); LinkedIn uses a 32-unit box and the
// even-odd fill rule, the rest a 24-unit box.
const socials: {
  label: string;
  href: string;
  viewBox: string;
  icon: string;
  /** Only LinkedIn's mark needs even-odd winding; the rest default to nonzero. */
  fillRule?: 'evenodd';
}[] = [
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/admrbsn',
    viewBox: '0 0 32 32',
    fillRule: 'evenodd',
    icon: 'M26.111,3H5.889c-1.595,0-2.889,1.293-2.889,2.889V26.111c0,1.595,1.293,2.889,2.889,2.889H26.111c1.595,0,2.889-1.293,2.889-2.889V5.889c0-1.595-1.293-2.889-2.889-2.889ZM10.861,25.389h-3.877V12.87h3.877v12.519Zm-1.957-14.158c-1.267,0-2.293-1.034-2.293-2.31s1.026-2.31,2.293-2.31,2.292,1.034,2.292,2.31-1.026,2.31-2.292,2.31Zm16.485,14.158h-3.858v-6.571c0-1.802-.685-2.809-2.111-2.809-1.551,0-2.362,1.048-2.362,2.809v6.571h-3.718V12.87h3.718v1.686s1.118-2.069,3.775-2.069,4.556,1.621,4.556,4.975v7.926Z',
  },
