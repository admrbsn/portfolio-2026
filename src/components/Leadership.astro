---
// Home-page "Leadership" teaser. Each point is a real result pulled from the
// how-i-lead write-up; the full argument lives on /about.

const points = [
  {
    lead: 'Led product design at Tribute',
    rest: 'through 20× growth in two years.',
  },
  {
    lead: 'Took Figma off the critical path',
    rest: 'with an AI-driven system that outputs working code, not static files.',
  },
  {
    lead: 'Shipped a 4.6-star iOS app',
    rest: 'in 90 days — 10,000+ downloads, featured by Apple.',
  },
  {
    lead: 'Ran design and engineering across two continents',
    rest: 'on a fully asynchronous cycle.',
  },
];
---

<section class="px-gutter py-section text-center" aria-labelledby="leadership">
  <p class="text-micro uppercase tracking-[0.14em]" data-anim="reveal">
    <span class="accent-gradient">Why me</span>
  </p>

  <h2
    id="leadership"
    class="mt-5 font-display text-title font-normal text-ink"
    data-anim="reveal-heading"
  >
    Leadership
  </h2>

  <p class="mx-auto mt-6 max-w-2xl text-lead text-ink-dim" data-anim="reveal">
    I build teams that ship things no one could build alone.
  </p>

  <ul class="mx-auto mt-16 grid max-w-5xl gap-5 text-left sm:grid-cols-2" data-anim="reveal-batch">
    {
      points.map((point) => (
        <li class="rounded-2xl border border-line bg-surface-lift/40 p-6 sm:p-7">
          <p class="flex gap-4 text-ink-dim">
            <span class="accent-gradient mt-1 shrink-0 text-sm leading-none" aria-hidden="true">
              ◆
            </span>
            <span>
              <span class="font-medium text-ink">{point.lead}</span> {point.rest}
            </span>
          </p>
        </li>
      ))
    }
  </ul>

  <div class="mt-14" data-anim="reveal">
    <a
      href="/about"
      class="group inline-flex items-center gap-3 text-micro uppercase tracking-[0.14em] text-ink transition-colors hover:text-accent"
    >
      How I lead
      <span
        class="transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:translate-x-1"
        aria-hidden="true">→</span
      >
    </a>
  </div>
</section>
