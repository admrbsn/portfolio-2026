---
import { Image } from 'astro:assets';
import portrait from '../assets/home/portrait.jpg';
import workspace from '../assets/home/workspace.jpg';

// Home-page "About me" module. Content drawn from the leadership write-up; the
// full argument, principles and experience live on /about. Images are
// placeholders for now.

const toolkit = ['Figma', 'Webflow', 'Tailwind', 'Vue', 'TypeScript', 'Astro'];
---

<section class="px-gutter py-section" aria-labelledby="about-me">
  <div class="grid items-stretch gap-8 lg:grid-cols-[0.85fr_1fr_0.9fr] lg:gap-12">
    {/* Left: intro + toolkit, pinned top and bottom */}
    <div class="flex flex-col" data-anim="reveal">
      <p class="text-micro uppercase tracking-[0.14em] text-ink-faint">About me</p>

      <h2
        id="about-me"
        class="mt-6 font-display text-[clamp(2rem,3.4vw,3.25rem)] font-normal leading-[1.05] text-ink"
      >
        Where design meets code, and teams do their best work<span class="accent-gradient">.</span>
      </h2>

      <ul class="mt-auto flex flex-wrap gap-2.5 pt-12">
        {
          toolkit.map((tool) => (
            <li class="rounded-full border border-line px-4 py-2 text-micro text-ink-dim">{tool}</li>
          ))
        }
      </ul>
    </div>

    {/* Centre: portrait */}
    <Image
      src={portrait}
      alt="Adam Robertson"
      widths={[420, 700, 900]}
      sizes="(min-width: 1024px) 34vw, 92vw"
      class="h-full w-full rounded-xl object-cover"
      data-anim="reveal"
    />

    {/* Right: workspace image, copy, link */}
    <div class="flex flex-col" data-anim="reveal">
      <Image
        src={workspace}
        alt="A stack of design and development books — The Design of Everyday Things, Don't Make Me Think, Grid Systems, and more"
        widths={[420, 700, 1000]}
        sizes="(min-width: 1024px) 30vw, 92vw"
        class="w-full rounded-xl object-cover"
      />

      <p class="mt-8 max-w-md text-lead text-ink-dim">
        I came up doing both design and development — two disciplines that rarely sit in one person.
        Somewhere along the way it clicked that I could do more by improving how a team thinks than
        by executing faster myself.
      </p>

      <a
        href="/about"
        class="group mt-8 inline-flex items-center gap-2 self-start text-ink transition-colors hover:text-accent"
      >
        Learn more about how I lead
        <span
          class="transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:translate-x-1 group-hover:-translate-y-1"
          aria-hidden="true">↗</span
        >
      </a>
    </div>
  </div>
</section>
