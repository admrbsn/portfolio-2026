---
import RuleCross from './RuleCross.astro';
import BrandMark from './BrandMark.astro';

/*
  Relume — the structure layer, between the brief and the code. Every claim is
  from Relume's own pages: 1,000+ components for Figma, Webflow and React; React
  export as Tailwind + shadcn/ui; the Library MCP (natural-language search,
  code vendored as editable files; Claude, Cursor, Lovable, Cline named); and
  the Claude Design export (tokens, type scale, spacing, components in one
  import). The example prompt in cell 3 is the one Relume's MCP page uses.
*/
const relume = [
  {
    title: 'Sitemaps first',
    body: 'A prompt becomes a sitemap, then a wireframe per page. The fastest way I know to agree on structure before anyone argues about pixels.',
    art: 'map',
  },
  {
    title: 'Brand guidelines',
    body: 'The Style Guide Builder turns a palette and a type pairing into a working system: colours, scales, buttons, forms.',
    art: 'brand',
  },
  {
    title: 'A React component library',
    body: 'Over a thousand sections as React, Tailwind and shadcn/ui. Through the Relume MCP an agent searches it in plain language and vendors the code as editable files.',
    art: 'mcp',
  },
  {
    title: 'Into Claude Design',
    body: 'The design system exports to Claude Design as one import, so first drafts start on-brand instead of being dragged there.',
    art: 'handoff',
  },
] as const;
---

<section
  class="relative border-t border-line px-shell py-section"
  aria-labelledby="relume"
  data-blueprint="The Skeleton"
  data-dead="bottom"
>
  <RuleCross />
  <BrandMark name="relume" class="mb-8 h-10 w-10 text-ink-dim" label />

  <div class="max-w-2xl" data-anim="reveal">
    <p class="text-micro uppercase tracking-[0.14em] text-ink-faint">The skeleton</p>
    <h2
      id="relume"
      class="signal mt-6 scroll-mt-32 font-display text-title text-ink"
      data-text="Relume, for the structure"
      style="--signal-dur: 16.1s; --signal-delay: 8s"
    >
      Relume, for the structure
    </h2>
    <p class="mt-5 text-ink-dim">
      Before there’s code there’s a sitemap. Relume is where the skeleton comes from: page
      structure, wireframes and a brand system, exported to Figma, Webflow or React, and now
      straight into the agents.
    </p>
  </div>

  {/*
    Ruled like the homepage Capabilities index: pulled to the rails, top and
    bottom rules rail to rail (squares at all four corners), and at `lg` three
    internal dividers, each squared where it meets both rules. Below `lg` the
    cells stack and each internal rule crosses both rails instead.
  */}
  <div
    class="relative -mx-shell-pad mt-12 grid grid-cols-1 border-y border-line lg:grid-cols-4"
    data-anim="reveal-batch"
  >
    {
      relume.map((r, i) => (
        <div
          class:list={[
            'relative px-shell-pad py-8',
            i > 0 && 'border-t border-line lg:border-l lg:border-t-0',
          ]}
        >
          {i > 0 && (
            <>
              <span class="bp-sq bp-sq--t bp-sq--l lg:hidden" aria-hidden="true" />
              <span class="bp-sq bp-sq--t bp-sq--r lg:hidden" aria-hidden="true" />
              <span class="bp-sq bp-sq--t bp-sq--l hidden lg:block" aria-hidden="true" />
              <span class="bp-sq bp-sq--b bp-sq--l hidden lg:block" aria-hidden="true" />
            </>
          )}

          <div class="rl-art flex h-32 items-center" aria-hidden="true">
            {r.art === 'map' && (
              <svg viewBox="0 0 200 112" class="h-full w-auto max-w-full">
                <g class="rl-lines">
                  <path d="M100 26v12M36 38h128M36 38v10M100 38v10M164 38v10M100 72v8M66 80h68M66 80v8M134 80v8" />
                </g>
                <g class="rl-node">
                  <rect x="76" y="6" width="48" height="20" rx="3" />
                  <rect x="12" y="48" width="48" height="24" rx="3" />
                  <rect x="76" y="48" width="48" height="24" rx="3" class="rl-node--on" />
                  <rect x="140" y="48" width="48" height="24" rx="3" />
                  <rect x="42" y="88" width="48" height="20" rx="3" />
                  <rect x="110" y="88" width="48" height="20" rx="3" />
                </g>
                <g class="rl-label">
                  <text x="100" y="19">Home</text>
                  <text x="36" y="63">About</text>
                  <text x="100" y="63">Work</text>
                  <text x="164" y="63">Contact</text>
                  <text x="66" y="101">Case study</text>
                  <text x="134" y="101">Archive</text>
                </g>
              </svg>
            )}

            {r.art === 'brand' && (
              <div class="flex w-full items-end gap-5">
                <div class="grid grid-cols-2 gap-1.5">
                  <span class="rl-swatch bg-accent" />
                  <span class="rl-swatch bg-accent-warm" />
                  <span class="rl-swatch bg-ink" />
                  <span class="rl-swatch border border-line bg-surface" />
                </div>
                <div class="leading-none">
                  <span class="block text-[2.75rem] font-semibold tracking-[-0.02em] text-ink">Aa</span>
                  <span class="mt-2 block font-mono text-[0.625rem] uppercase tracking-[0.14em] text-ink-faint">
                    Display · Body · Mono
                  </span>
                </div>
              </div>
            )}

            {r.art === 'mcp' && (
              <div class="w-full rounded-ui border border-line bg-surface-lift px-3.5 py-3 font-mono text-[0.6875rem] leading-[1.7] text-ink-dim">
                <span class="block text-ink-faint">relume-library-mcp</span>
                <span class="block">
                  <span class="text-accent-warm">›</span> A pricing section with three tiers.
                </span>
                <span class="block text-accent">→ editable React · Tailwind · shadcn/ui</span>
              </div>
            )}

            {r.art === 'handoff' && (
              <div class="flex w-full items-center gap-3 font-mono text-[0.6875rem]">
                <span class="rounded-ui border border-line bg-surface-lift px-3 py-2 text-ink">Relume</span>
                <span class="rl-flow h-px flex-1" />
                <span class="rounded-ui border border-accent bg-surface-lift px-3 py-2 text-ink">Claude Design</span>
              </div>
            )}
          </div>

          <span class="mt-6 block font-mono text-micro tracking-[0.14em] text-ink-faint">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h4 class="mt-2 text-[1.0625rem] font-medium text-ink">{r.title}</h4>
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-dim">{r.body}</p>
        </div>
      ))
    }

    <span class="bp-sq bp-sq--t bp-sq--l" aria-hidden="true"></span>
    <span class="bp-sq bp-sq--t bp-sq--r" aria-hidden="true"></span>
    <span class="bp-sq bp-sq--b bp-sq--l" aria-hidden="true"></span>
    <span class="bp-sq bp-sq--b bp-sq--r" aria-hidden="true"></span>
  </div>
</section>

<style>
  /* Relume cells */
  .rl-lines path {
    fill: none;
    stroke: var(--color-line);
    stroke-width: 1;
  }
  .rl-node rect {
    fill: var(--color-surface-lift);
    stroke: var(--color-line);
    stroke-width: 1;
  }
  .rl-node .rl-node--on {
    stroke: var(--color-accent);
  }
  .rl-label text {
    fill: var(--color-ink-dim);
    font-family: var(--font-mono);
    font-size: 7.5px;
    text-anchor: middle;
  }
  .rl-swatch {
    display: block;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: var(--radius-ui);
  }
  /* The handoff line: a dashed rule with a packet travelling along it. */
  .rl-flow {
    position: relative;
    background-image: linear-gradient(to right, var(--color-line) 50%, transparent 50%);
    background-size: 6px 1px;
  }
  .rl-flow::after {
    content: '';
    position: absolute;
    top: -2px;
    left: 0;
    width: 5px;
    height: 5px;
    background: var(--color-accent);
    animation: rl-packet 2.6s var(--ease-in-out-quart) infinite;
  }
  @keyframes rl-packet {
    0% { left: 0; opacity: 0; }
    15% { opacity: 1; }
    85% { opacity: 1; }
    100% { left: calc(100% - 5px); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .rl-flow::after {
      animation: none;
      left: calc(50% - 2.5px);
    }
  }
  :global(html[data-motion='reduced']) .rl-flow::after,
  :global(html[data-motion='failed']) .rl-flow::after {
    animation: none;
    left: calc(50% - 2.5px);
  }
</style>
