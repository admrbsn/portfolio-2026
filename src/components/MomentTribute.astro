---
import tributeLogo from '../assets/about/tribute-logo.svg';

/**
 * The Tribute leadership-moment graphic, rebuilt in code.
 *
 * Replaces a flat export so it can carry the portfolio's own tokens — surface,
 * line, accent — rather than the cream-on-charcoal of the original, and so the
 * type stays real text (selectable, searchable, and sharp at any zoom) instead
 * of pixels.
 *
 * Deliberately square-cornered: it sits inside a ruled grid whose whole point is
 * straight lines meeting at right angles, and a radius here fought that.
 */

/*
 * The sprint-cycle nodes drifting behind the card. Positions and rotations are
 * hand-placed rather than generated — they need to read as a diagram caught
 * mid-thought, and random placement kept colliding with the centre stack.
 */
const nodes = [
  { label: 'Design & Prototype', sub: 'Exploration + build during week', x: -4, y: 6, r: -8, d: 0 },
  { label: 'Continuous Product Build', sub: 'Next sprint', x: 24, y: 20, r: 5, d: 0 },
  { label: 'Engineering', sub: 'Integrated into live product', x: 68, y: 4, r: 7, d: 0 },
  { label: 'Weekly Share-Out', sub: 'Team review & alignment', x: 58, y: 30, r: -5, d: 0 },
  { label: 'Iteration', sub: 'Refinement based on feedback', x: 12, y: 72, r: 6, d: 0 },
  { label: 'Continuous Product Build', sub: 'Next sprint', x: 62, y: 80, r: -7, d: 0 },
  { label: 'Engineering', sub: 'Integrated into live product', x: -6, y: 44, r: 4, d: 0 },
  { label: 'Design & Prototype', sub: 'Exploration + build', x: 78, y: 58, r: -6, d: 0 },
];
---

<div class="moment" data-anim="moment-reveal" role="img" aria-label="Lovable and Tribute, captioned “We cut Figma out of the critical path.”">
  {/* Drifting sprint-cycle diagram, purely atmospheric. */}
  <div class="moment__field" aria-hidden="true">
    {
      nodes.map((n, i) => (
        <span
          class="moment__node"
          style={`left:${n.x}%;top:${n.y}%;--r:${n.r}deg;--i:${i}`}
        >
          <span class="moment__node-box" data-type-pop>
            <span class="moment__node-label">{n.label}</span>
            <span class="moment__node-sub">{n.sub}</span>
          </span>
        </span>
      ))
    }
  </div>

  <div class="moment__stack">
    <div class="moment__logos" data-type-rise>
      {/* Lovable's mark keeps its own gradient — it is their brand, and it is
          the one spot of outside colour the card earns. */}
      <svg class="moment__lovable" viewBox="0 0 755 129" fill="none" aria-hidden="true">
        <path
          fill="currentColor"
          d="M303.603 30.94c9.149 0 17.163 1.982 24.04 5.945 6.876 3.963 12.18 9.616 15.91 16.959 3.788 7.285 5.682 15.852 5.682 25.7 0 9.85-1.894 18.447-5.682 25.79-3.73 7.343-9.034 12.996-15.91 16.959-6.877 3.963-14.891 5.944-24.04 5.944-9.15 0-17.193-1.981-24.128-5.944-6.877-3.963-12.21-9.616-15.998-16.959-3.73-7.343-5.595-15.94-5.595-25.79 0-9.848 1.865-18.415 5.595-25.7 3.788-7.343 9.121-12.996 15.998-16.96 6.935-3.962 14.978-5.944 24.128-5.944Zm176.168 0c8.683 0 16.026 1.428 22.029 4.284 6.002 2.797 10.519 6.818 13.55 12.063 3.088 5.245 4.633 11.511 4.633 18.796v38.464c0 4.138.292 7.984.874 11.539.641 3.497 1.545 5.712 2.71 6.644v2.972H496.03c-.641-2.506-1.136-5.332-1.486-8.479-.116-1.04-.214-2.1-.298-3.178a32.537 32.537 0 0 1-2.149 2.828c-2.914 3.438-6.674 6.207-11.278 8.305-4.545 2.039-9.732 3.059-15.56 3.059-5.77 0-10.957-1.136-15.561-3.409-4.546-2.273-8.13-5.507-10.753-9.703-2.564-4.254-3.846-9.208-3.846-14.861 0-8.626 2.535-15.211 7.605-19.757 5.07-4.604 12.385-7.605 21.942-9.004l15.999-2.273c3.205-.467 5.74-1.05 7.605-1.749 1.865-.699 3.234-1.632 4.108-2.797.875-1.224 1.312-2.768 1.312-4.633 0-1.923-.524-3.672-1.573-5.245-.991-1.632-2.507-2.915-4.546-3.847-1.982-.99-4.4-1.486-7.256-1.486-4.546 0-8.189 1.195-10.928 3.585-2.739 2.33-4.225 5.536-4.458 9.615h-27.362c.233-6.178 2.098-11.656 5.595-16.435 3.555-4.837 8.479-8.596 14.773-11.277 6.294-2.68 13.58-4.02 21.856-4.02Zm78.465 15.936a31.342 31.342 0 0 1 3.148-4.92c2.797-3.556 6.206-6.267 10.227-8.132 4.022-1.923 8.538-2.884 13.55-2.884 7.518 0 14.046 1.952 19.582 5.857 5.537 3.905 9.792 9.529 12.764 16.872 2.972 7.285 4.458 15.94 4.458 25.964 0 9.965-1.516 18.62-4.546 25.963-3.031 7.285-7.372 12.879-13.025 16.784-5.595 3.905-12.151 5.857-19.669 5.857-5.012 0-9.5-.873-13.463-2.622-3.905-1.748-7.227-4.371-9.966-7.868a31.218 31.218 0 0 1-3.321-5.4v13.355h-26.227V.342h26.488v46.534ZM710.451 30.94c8.567 0 16.173 1.865 22.817 5.595 6.643 3.73 11.802 9.15 15.473 16.26 3.73 7.11 5.595 15.619 5.595 25.526 0 3.555-.03 6.382-.088 8.48h-63.814c.251 4.09 1.038 7.645 2.359 10.665 1.632 3.73 3.963 6.556 6.993 8.479 3.031 1.865 6.615 2.798 10.753 2.798 4.546 0 8.305-1.166 11.277-3.497 2.972-2.389 4.838-5.74 5.595-10.053h26.487c-.815 6.761-3.117 12.618-6.905 17.572-3.73 4.953-8.713 8.771-14.949 11.452-6.236 2.681-13.492 4.02-21.768 4.02-9.324 0-17.425-1.777-24.302-5.332-6.877-3.613-12.239-9.033-16.085-16.259-3.788-7.227-5.682-16.173-5.682-26.838 0-10.14 1.981-18.883 5.944-26.226 3.963-7.401 9.441-13.026 16.435-16.872 6.993-3.846 14.949-5.77 23.865-5.77Zm-502.536 69.546h32.087c23.362 0 20.196 25.163 20.189 25.216h-79.726V.342h27.45v100.144Zm185.126-2.03 19.101-64.981h27.362l-31.908 92.227h-29.46l-33.132-92.227h28.148l19.889 64.981Zm263.245 27.246h-26.488V.342h26.488v125.36ZM493.845 80.731a13.951 13.951 0 0 1-3.06 1.961c-2.04.991-4.808 1.836-8.305 2.536l-6.731 1.311c-4.487.874-7.868 2.214-10.141 4.02-2.214 1.807-3.322 4.343-3.322 7.606s1.195 5.857 3.584 7.78c2.39 1.924 5.45 2.886 9.18 2.886 3.73 0 7.022-.816 9.878-2.448 2.855-1.69 5.041-4.021 6.556-6.993 1.574-2.972 2.361-6.353 2.361-10.141v-8.518Zm82.662-29.597c-3.905 0-7.256 1.194-10.053 3.584-2.739 2.33-4.808 5.653-6.207 9.966-1.399 4.254-2.098 9.237-2.098 14.949 0 5.77.699 10.782 2.098 15.036s3.468 7.547 6.207 9.878c2.797 2.331 6.148 3.497 10.053 3.497 3.963 0 7.285-1.166 9.966-3.497 2.739-2.331 4.778-5.624 6.119-9.878 1.398-4.254 2.098-9.267 2.098-15.036 0-5.77-.7-10.782-2.098-15.036-1.341-4.255-3.38-7.548-6.119-9.88-2.681-2.389-6.003-3.583-9.966-3.583Zm-272.904.088c-3.847 0-7.169 1.078-9.966 3.234-2.739 2.098-4.838 5.274-6.295 9.528-1.457 4.196-2.185 9.383-2.185 15.56 0 6.178.728 11.395 2.185 15.65 1.457 4.254 3.556 7.459 6.295 9.616 2.797 2.097 6.119 3.146 9.966 3.146 3.846 0 7.138-1.049 9.877-3.146 2.74-2.157 4.837-5.334 6.294-9.53 1.457-4.254 2.186-9.5 2.186-15.735 0-9.266-1.602-16.289-4.808-21.068-3.205-4.837-7.722-7.255-13.549-7.255Zm406.237-1.137c-3.905 0-7.343.962-10.316 2.885-2.914 1.865-5.187 4.662-6.819 8.392-.893 2.117-1.532 4.477-1.918 7.081h36.494c-.261-3.3-.917-6.156-1.969-8.567-1.34-3.264-3.321-5.712-5.944-7.344-2.622-1.631-5.799-2.447-9.528-2.447Z"
        ></path>
        <mask id="mt-mark" width="124" height="126" x="0" y="0" maskUnits="userSpaceOnUse" style="mask-type: alpha;">
          <path
            fill="#fff"
            fill-rule="evenodd"
            d="M37.3.343c20.43 0 36.991 16.605 36.991 37.088v14.095h12.31c20.43 0 36.991 16.605 36.991 37.088s-16.561 37.088-36.99 37.088H.31V37.431C.31 16.948 16.87.343 37.3.343Z"
            clip-rule="evenodd"></path>
        </mask>
        <g mask="url(#mt-mark)">
          <g filter="url(#mt-blur)"><circle cx="54.389" cy="67.257" r="83.452" fill="#4B73FF"></circle></g>
          <g filter="url(#mt-blur)"><ellipse cx="63.557" cy="21.462" fill="#FF66F4" rx="106.879" ry="83.452"></ellipse></g>
          <g filter="url(#mt-blur)"><ellipse cx="80.992" cy="5.757" fill="#FF0105" rx="83.452" ry="73.289"></ellipse></g>
          <g filter="url(#mt-blur)"><circle cx="65.043" cy="21.442" r="50.188" fill="#FE7B02"></circle></g>
        </g>
        <defs>
          <filter id="mt-blur" x="-120" y="-120" width="400" height="400" filterUnits="userSpaceOnUse">
            <feGaussianBlur stdDeviation="18.7"></feGaussianBlur>
          </filter>
        </defs>
      </svg>

      <span class="moment__plus" aria-hidden="true">+</span>

      <img class="moment__tribute" src={tributeLogo.src} alt="" aria-hidden="true" />
    </div>

    <p class="moment__line" data-type-rise>We cut Figma out of the critical path.</p>

    {/* The prompt box is the punchline — the deliverable became a prompt, not a
        file — so it is rendered as a real control rather than a screenshot. */}
    <div class="moment__prompt" aria-hidden="true">
      <span class="moment__placeholder"><span data-type-target>Help me create…</span><span class="moment__caret"></span></span>
      <span class="moment__actions">
        <span class="moment__chip">Plan</span>
        <svg class="moment__mic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z" />
          <path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v3" />
        </svg>
        <span class="moment__send">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 19V5M5 12l7-7 7 7" />
          </svg>
        </span>
      </span>
    </div>
  </div>
</div>

<style>
  .moment {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background:
      radial-gradient(120% 90% at 50% 0%, color-mix(in oklab, var(--color-accent) 7%, transparent), transparent 60%),
      var(--color-surface);
  }

  /* Background diagram ------------------------------------------------ */

  .moment__field {
    position: absolute;
    inset: 0;
    pointer-events: none;
    /* Fade toward the middle so the centre stack always sits on quiet ground. */
    -webkit-mask-image: radial-gradient(75% 60% at 50% 50%, transparent 15%, #000 75%);
    mask-image: radial-gradient(75% 60% at 50% 50%, transparent 15%, #000 75%);
  }

  /* Outer node owns position and the idle drift — transform here is CSS's. */
  .moment__node {
    position: absolute;
    /* Each node drifts on its own clock. `--i` staggers the delay so the field
       never pulses in unison, which would read as a single moving layer. */
    animation: moment-drift calc(14s + var(--i) * 1.7s) ease-in-out infinite;
    animation-delay: calc(var(--i) * -2.3s);
    opacity: 0.72;
  }

  /* Inner box owns the entrance — transform here belongs to GSAP, which pops
     it in on scroll. Keeping the two on separate elements is what stops the
     drift and the pop overwriting each other. */
  .moment__node-box {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    width: max-content;
    max-width: 11rem;
    padding: 0.5rem 0.75rem;
    /* Filled, not just outlined. At `--color-line` over the node's own opacity
       the border landed near 7% and the box was effectively invisible — so the
       scale animation looked like only the text was moving. */
    border: 1px solid color-mix(in oklab, var(--color-ink) 16%, transparent);
    border-radius: 0.5rem;
    background: color-mix(in oklab, var(--color-surface-lift) 85%, transparent);
    box-shadow: 0 8px 24px -12px oklch(0 0 0 / 0.6);
  }

  .moment__node-label {
    font-size: 0.6rem;
    line-height: 1.2;
    color: var(--color-ink);
  }

  .moment__node-sub {
    font-size: 0.5rem;
    line-height: 1.2;
    color: var(--color-ink-faint);
  }

  /* Centre stack ------------------------------------------------------- */

  .moment__stack {
    position: relative;
    display: flex;
    width: min(78%, 30rem);
    flex-direction: column;
    align-items: center;
    gap: clamp(0.75rem, 2.5cqw, 1.5rem);
  }

  .moment__logos {
    display: flex;
    align-items: center;
    gap: clamp(0.6rem, 2cqw, 1.1rem);
    color: var(--color-ink);
  }

  .moment__lovable {
    height: clamp(0.9rem, 3.4cqw, 1.5rem);
    width: auto;
  }

  .moment__tribute {
    height: clamp(1.1rem, 4.2cqw, 1.9rem);
    width: auto;
  }

  .moment__plus {
    font-size: clamp(0.7rem, 2.4cqw, 1.05rem);
    color: var(--color-ink-faint);
  }

  .moment__line {
    margin: 0;
    text-align: center;
    text-wrap: balance;
    font-size: clamp(0.85rem, 3.2cqw, 1.4rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  /* Prompt ------------------------------------------------------------- */

  .moment__prompt {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: clamp(0.5rem, 1.8cqw, 0.85rem);
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    background: color-mix(in oklab, var(--color-surface-lift) 70%, transparent);
  }

  .moment__placeholder {
    display: inline-flex;
    align-items: center;
    font-size: clamp(0.6rem, 2cqw, 0.85rem);
    color: var(--color-ink-faint);
  }

  .moment__caret {
    display: inline-block;
    width: 1px;
    height: 1em;
    margin-left: 1px;
    background: #fff;
  }

  /* The caret only blinks once the typing run has finished — while characters
     are still landing it stays solid, which is how a real cursor behaves. */
  .moment[data-typed='done'] .moment__caret {
    animation: moment-caret 1.1s steps(1, end) infinite;
  }

  @keyframes moment-caret {
    0%,
    50% {
      opacity: 1;
    }
    50.01%,
    100% {
      opacity: 0;
    }
  }

  @keyframes moment-drift {
    0%,
    100% {
      transform: rotate(var(--r)) translate3d(0, 0, 0);
    }
    50% {
      transform: rotate(var(--r)) translate3d(0, -10px, 0);
    }
  }

  /* Motion here is decorative in full. Under reduced motion the card still
     reads: nodes sit still, the caret stops blinking, and `initMotion` never
     runs the typing effect, so the placeholder is simply present. */
  @media (prefers-reduced-motion: reduce) {
    .moment__node,
    .moment[data-typed='done'] .moment__caret {
      animation: none;
    }
  }

  .moment__actions {
    display: flex;
    align-items: center;
    gap: clamp(0.35rem, 1.4cqw, 0.6rem);
    color: var(--color-ink-faint);
  }

  .moment__chip {
    padding: 0.2rem 0.5rem;
    border-radius: 0.3rem;
    background: color-mix(in oklab, var(--color-ink) 8%, transparent);
    font-size: clamp(0.55rem, 1.7cqw, 0.72rem);
    color: var(--color-ink-dim);
  }

  .moment__mic {
    width: clamp(0.65rem, 2cqw, 0.9rem);
    height: clamp(0.65rem, 2cqw, 0.9rem);
  }

  .moment__send {
    display: grid;
    place-items: center;
    width: clamp(1.1rem, 3.4cqw, 1.6rem);
    height: clamp(1.1rem, 3.4cqw, 1.6rem);
    border-radius: 0.3rem;
    background: var(--color-accent);
    color: var(--color-surface);
  }

  .moment__send svg {
    width: 60%;
    height: 60%;
  }
</style>
