---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** `full` breaks the prose column for a full-bleed moment. */
  width?: 'prose' | 'wide' | 'full';
}

const { src, alt, caption, width = 'wide' } = Astro.props;

const widthClass = {
  prose: 'max-w-prose',
  wide: 'max-w-5xl',
  full: 'max-w-none',
}[width];
---

<figure class={`mx-auto my-16 ${widthClass}`} data-anim="reveal">
  <div class="overflow-hidden rounded-lg bg-surface-lift">
    <Image src={src} alt={alt} widths={[640, 1024, 1600]} sizes="(min-width: 1024px) 70vw, 92vw" />
  </div>
  {
    caption && (
      <figcaption class="mt-3 text-micro uppercase tracking-[0.14em] text-ink-faint">
        {caption}
      </figcaption>
    )
  }
</figure>
