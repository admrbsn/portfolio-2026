---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: ImageMetadata[];
  /**
   * Off by default — a grid of thumbnails does not need to be labelled "Images
   * of the Process". The section keeps an aria-label so it is still announced.
   */
  heading?: string | null;
  /** `contain` letterboxes tall phone captures instead of cropping them. */
  fit?: 'cover' | 'contain';
  /** `inline` sheds the section padding so the row sits inside prose. */
  variant?: 'section' | 'inline';
  alt?: string[];
}

const {
  images,
  heading = null,
  fit = 'cover',
  variant = 'section',
  alt = [],
} = Astro.props;

const inline = variant === 'inline';

/*
  Two renditions per image: a cropped thumbnail for the grid, and a large one
  the lightbox loads only when that item is opened. The full sizes are resolved
  at build time so the markup can carry a plain href — which also means the
  grid degrades to a working set of image links with JS off.
*/
/*
  3200 rather than a viewport-ish 2000: several of these are wide contact
  sheets (one is 7535px), and at 2000 the individual screens inside them are
  illegible even zoomed. The cap keeps the largest source honest without
  flattening the detail the zoom exists to show.
*/
const items = await Promise.all(
  images.map(async (src) => {
    const full = await getImage({ src, width: Math.min(src.width, 3200), format: 'webp' });
    return { src, full: full.src, wide: src.width / src.height > 2.4 };
  }),
);
---

{
  items.length > 0 && (
    <section
      class={inline ? 'my-12' : 'mx-auto max-w-6xl px-gutter py-section'}
      aria-label={heading ?? 'Process images'}
    >
      {heading && <h2 class="font-display text-title font-normal text-ink">{heading}</h2>}

      <ul
        class:list={[
          'grid grid-cols-2 gap-2 md:grid-cols-4 md:gap-3',
          heading && 'mt-10',
        ]}
        data-gallery
        data-anim="reveal-batch"
      >
        {items.map((item, i) => (
          <li>
            <a
              href={item.full}
              class="gallery-item"
              data-gallery-item
              data-index={i}
              data-cursor="grow"
              aria-label={alt[i] ? `${alt[i]} — open larger image` : `Open image ${i + 1} of ${items.length}`}
            >
              <Image
                src={item.src}
                alt=""
                widths={[320, 640]}
                sizes="(min-width: 768px) 22vw, 45vw"
                loading="lazy"
                class={fit === 'contain' ? 'h-full w-full object-contain' : 'h-full w-full object-cover'}
              />
            </a>
          </li>
        ))}
      </ul>

      {/*
        One dialog for the whole grid rather than one per image — <dialog> gives
        focus trapping, inertness of the page behind, and Escape-to-close for
        free, so the script below only has to swap the source and move the index.
      */}
      <dialog class="gallery-dialog" data-gallery-dialog aria-label="Image viewer">
        <button
          type="button"
          class="gallery-close"
          data-gallery-close
          aria-label="Close image viewer"
        >
          ✕
        </button>

        <button
          type="button"
          class="gallery-nav gallery-nav--prev"
          data-gallery-prev
          aria-label="Previous image"
        >
          ‹
        </button>

        {/*
          The zoom viewport: scrolls in both axes once the image is expanded
          past it, which is what makes the wide contact sheets readable.
        */}
        <div class="gallery-stage" data-gallery-stage data-lenis-prevent>
          <img class="gallery-full" data-gallery-full alt="" />
        </div>

        <button
          type="button"
          class="gallery-nav gallery-nav--next"
          data-gallery-next
          aria-label="Next image"
        >
          ›
        </button>

        <p class="gallery-counter" data-gallery-counter aria-live="polite" />
        <button type="button" class="gallery-zoom" data-gallery-zoom aria-pressed="false">
          Zoom
        </button>
      </dialog>
    </section>
  )
}

<script>
  import { getLenis } from '../../lib/motion/lenis';

  function initGallery(root: HTMLElement) {
    const dialog = root.querySelector<HTMLDialogElement>('[data-gallery-dialog]');
    const full = root.querySelector<HTMLImageElement>('[data-gallery-full]');
    const stage = root.querySelector<HTMLElement>('[data-gallery-stage]');
    const counter = root.querySelector<HTMLElement>('[data-gallery-counter]');
    const zoomBtn = root.querySelector<HTMLButtonElement>('[data-gallery-zoom]');
    const links = [...root.querySelectorAll<HTMLAnchorElement>('[data-gallery-item]')];
    if (!dialog || !full || links.length === 0) return () => {};

    let index = 0;

    function setZoom(on: boolean) {
      dialog!.classList.toggle('is-zoomed', on);
      zoomBtn?.setAttribute('aria-pressed', String(on));
      if (zoomBtn) zoomBtn.textContent = on ? 'Fit' : 'Zoom';
      if (!on && stage) {
        stage.scrollLeft = 0;
        stage.scrollTop = 0;
      }
    }

    function show(next: number) {
      // Wrap, so the arrows never dead-end on the first or last image.
      index = (next + links.length) % links.length;
      full!.src = links[index].href;
      if (counter) counter.textContent = `${index + 1} / ${links.length}`;
      // Zoom is per-image: carrying it across a change lands the reader in the
      // middle of a picture they have not seen whole yet.
      setZoom(false);
    }

    function open(event: MouseEvent, i: number) {
      // Let modified clicks fall through to the browser — the href is a real
      // image URL, so "open in new tab" should keep working.
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
      event.preventDefault();
      show(i);
      dialog!.showModal();
      // Lenis drives the page scroll and does not know the dialog exists; without
      // this the page creeps behind the backdrop while the viewer is up.
      getLenis()?.stop();
    }

    const onClicks = links.map((link, i) => {
      const handler = (event: MouseEvent) => open(event, i);
      link.addEventListener('click', handler);
      return handler;
    });

    const onKey = (event: KeyboardEvent) => {
      if (!dialog.open) return;
      if (event.key === 'ArrowRight') show(index + 1);
      if (event.key === 'ArrowLeft') show(index - 1);
    };

    const onClose = () => {
      getLenis()?.start();
      setZoom(false);
      // Drop the decoded full-size frame when the viewer closes — several of
      // these decode to tens of megapixels.
      full.removeAttribute('src');
    };

    // Clicking outside the image closes. The dialog is its own backdrop, and
    // the stage is the empty space around the image, so a hit on either (but
    // never on the image itself) means "outside".
    const onDialogClick = (event: MouseEvent) => {
      if (event.target === dialog || event.target === stage) dialog.close();
    };

    const prev = root.querySelector('[data-gallery-prev]');
    const next = root.querySelector('[data-gallery-next]');
    const close = root.querySelector('[data-gallery-close]');
    const onPrev = () => show(index - 1);
    const onNext = () => show(index + 1);
    const onCloseClick = () => dialog.close();
    const onZoom = () => setZoom(!dialog.classList.contains('is-zoomed'));

    prev?.addEventListener('click', onPrev);
    next?.addEventListener('click', onNext);
    close?.addEventListener('click', onCloseClick);
    zoomBtn?.addEventListener('click', onZoom);
    full.addEventListener('click', onZoom);
    dialog.addEventListener('click', onDialogClick);
    dialog.addEventListener('close', onClose);
    document.addEventListener('keydown', onKey);

    return () => {
      links.forEach((link, i) => link.removeEventListener('click', onClicks[i]));
      prev?.removeEventListener('click', onPrev);
      next?.removeEventListener('click', onNext);
      close?.removeEventListener('click', onCloseClick);
      zoomBtn?.removeEventListener('click', onZoom);
      full.removeEventListener('click', onZoom);
      dialog.removeEventListener('click', onDialogClick);
      dialog.removeEventListener('close', onClose);
      document.removeEventListener('keydown', onKey);
      if (dialog.open) dialog.close();
    };
  }

  /*
    Same teardown contract the motion registry uses: the ClientRouter swaps the
    page body, so listeners bound to the old DOM (and the document-level key
    handler especially) have to come off on navigation or they accumulate.
  */
  let teardowns: (() => void)[] = [];

  function mount() {
    teardowns = [...document.querySelectorAll<HTMLElement>('[data-gallery]')]
      .map((grid) => grid.closest('section'))
      .filter((section): section is HTMLElement => section !== null)
      .map(initGallery);
  }

  function unmount() {
    teardowns.forEach((fn) => fn());
    teardowns = [];
  }

  document.addEventListener('astro:page-load', mount);
  document.addEventListener('astro:before-swap', unmount);
</script>

<style>
  .gallery-item {
    display: block;
    overflow: hidden;
    border-radius: 0.375rem;
    aspect-ratio: 4 / 3;
    background: var(--color-surface-lift);
    border: 1px solid transparent;
    transition:
      border-color var(--dur-fast) var(--ease-out-expo),
      transform var(--dur-fast) var(--ease-out-expo);
  }

  .gallery-item:hover,
  .gallery-item:focus-visible {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .gallery-dialog {
    /* Fill the viewport rather than sitting in the UA's centred content box. */
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: clamp(1rem, 4vw, 3rem);
    border: 0;
    background: transparent;
    color: var(--color-ink);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(0.5rem, 2vw, 1.5rem);
  }

  .gallery-dialog:not([open]) {
    display: none;
  }

  .gallery-dialog::backdrop {
    background: oklch(0.12 0.004 240 / 0.94);
    backdrop-filter: blur(8px);
  }

  .gallery-stage {
    grid-column: 2;
    display: grid;
    place-items: center;
    max-height: 85dvh;
    overflow: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--color-line) transparent;
  }

  .gallery-full {
    max-width: 100%;
    max-height: 85dvh;
    width: auto;
    height: auto;
    border-radius: 0.5rem;
    box-shadow: 0 30px 80px -20px oklch(0 0 0 / 0.8);
    cursor: zoom-in;
  }

  /* Zoomed: the image drops its fit constraints and the stage becomes the
     scroll port, so wide contact sheets can be panned at full detail. */
  .gallery-dialog.is-zoomed .gallery-stage {
    place-items: start;
  }

  .gallery-dialog.is-zoomed .gallery-full {
    max-width: none;
    max-height: none;
    border-radius: 0;
    cursor: zoom-out;
  }

  .gallery-zoom {
    position: absolute;
    bottom: clamp(1rem, 4vw, 3rem);
    right: clamp(1rem, 4vw, 3rem);
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    background: var(--color-surface-lift);
    color: var(--color-ink);
    font-size: var(--text-micro);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .gallery-zoom:hover {
    background: color-mix(in oklab, var(--color-surface-lift) 70%, white);
  }

  .gallery-nav,
  .gallery-close {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    background: var(--color-surface-lift);
    color: var(--color-ink);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease-out-expo);
  }

  .gallery-nav:hover,
  .gallery-close:hover {
    background: color-mix(in oklab, var(--color-surface-lift) 70%, white);
  }

  .gallery-nav--prev {
    grid-column: 1;
  }
  .gallery-nav--next {
    grid-column: 3;
  }

  .gallery-close {
    position: absolute;
    top: clamp(1rem, 4vw, 3rem);
    right: clamp(1rem, 4vw, 3rem);
    font-size: 1rem;
  }

  .gallery-counter {
    position: absolute;
    bottom: clamp(1rem, 4vw, 3rem);
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    font-size: var(--text-micro);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-item,
    .gallery-nav,
    .gallery-close {
      transition: none;
    }
    .gallery-item:hover,
    .gallery-item:focus-visible {
      transform: none;
    }
  }
</style>
