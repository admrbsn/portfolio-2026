---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** Landscape tablet by default; `phone` gives a tall portrait frame. */
  frame?: 'tablet' | 'phone';
}

const { src, alt, caption, frame = 'tablet' } = Astro.props;
---

{/*
  A device frame whose screen is a scroll port: these sources are full-page
  captures many times taller than the viewport they sit in, so the frame shows
  a window onto them and the reader scrolls the rest.
*/}
<figure class="device mx-auto my-16 max-w-5xl" data-anim="reveal">
  <div class={`device-bezel device-bezel--${frame}`}>
    {/*
      tabindex makes the scroll port reachable by keyboard — a scrollable region
      that can't be focused is unreachable without a pointer. data-lenis-prevent
      keeps Lenis from swallowing the wheel event and scrolling the page
      instead of the frame.
    */}
    <div
      class="device-screen"
      data-lenis-prevent
      tabindex="0"
      role="group"
      aria-label={caption ? `${caption} — scrollable preview` : 'Scrollable preview'}
    >
      <Image
        src={src}
        alt={alt}
        widths={[640, 1024, 1600]}
        sizes="(min-width: 1024px) 70vw, 92vw"
        class="block w-full"
      />
      <span class="device-hint" aria-hidden="true">Scroll ↓</span>
    </div>
  </div>
  {
    caption && (
      <figcaption class="mt-4 text-micro uppercase tracking-[0.14em] text-ink-faint">
        {caption}
      </figcaption>
    )
  }
</figure>

<style>
  .device-bezel {
    position: relative;
    border-radius: 1rem;
    background: linear-gradient(
      145deg,
      var(--color-surface-lift),
      color-mix(in oklab, var(--color-surface-lift) 60%, black)
    );
    border: 1px solid var(--color-line);
    /* Bezel is asymmetric on the wide edge to make room for the home button,
       matching how a landscape tablet actually reads. */
    padding: 0.75rem;
    box-shadow:
      0 1px 0 oklch(1 0 0 / 0.06) inset,
      0 24px 60px -20px oklch(0 0 0 / 0.7);
  }

  @media (min-width: 48rem) {
    .device-bezel--tablet {
      padding: 1.25rem 2.75rem 1.25rem 1.75rem;
    }

    /* Home button, trailing edge. */
    .device-bezel--tablet::after {
      content: '';
      position: absolute;
      right: 0.85rem;
      inset-block: 0;
      margin-block: auto;
      width: 1.4rem;
      height: 1.4rem;
      border-radius: 999px;
      border: 1px solid var(--color-line);
      background: color-mix(in oklab, var(--color-surface-lift) 70%, black);
    }

    /* Camera, leading edge. */
    .device-bezel--tablet::before {
      content: '';
      position: absolute;
      left: 0.7rem;
      inset-block: 0;
      margin-block: auto;
      width: 0.35rem;
      height: 0.35rem;
      border-radius: 999px;
      background: color-mix(in oklab, var(--color-surface-lift) 40%, black);
    }
  }

  .device-screen {
    position: relative;
    display: block;
    overflow-y: auto;
    overflow-x: hidden;
    border-radius: 0.375rem;
    background: var(--color-surface);
    /* The window the capture is read through. */
    aspect-ratio: 16 / 10;
    box-shadow: 0 0 0 1px oklch(0 0 0 / 0.5) inset;
    /* Momentum on touch, and stop the page from taking over at the ends. */
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--color-line) transparent;
  }

  /* Constrain the whole frame, not just the screen inside it — bounding only
     the screen leaves a full-width slab of bezel around a narrow phone. */
  .device-bezel--phone {
    max-width: 22rem;
    margin-inline: auto;
    border-radius: 2rem;
    padding: 0.6rem;
  }

  .device-bezel--phone .device-screen {
    aspect-ratio: 9 / 16;
    border-radius: 1.5rem;
  }

  .device-screen::-webkit-scrollbar {
    width: 6px;
  }
  .device-screen::-webkit-scrollbar-thumb {
    background: var(--color-line);
    border-radius: 999px;
  }

  /* Nothing about a static screenshot says "this scrolls", so say it — and get
     out of the way as soon as the reader acts on it. */
  .device-hint {
    position: sticky;
    bottom: 0.75rem;
    float: right;
    margin-right: 0.75rem;
    /* Sticky needs the element in flow; float keeps it off the capture's edge
       without reserving a row of its own. */
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    background: oklch(0 0 0 / 0.72);
    color: var(--color-ink);
    font-size: var(--text-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    backdrop-filter: blur(4px);
    transition: opacity var(--dur-fast) var(--ease-out-expo);
  }

  .device-screen:hover .device-hint,
  .device-screen:focus-within .device-hint {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .device-hint {
      transition: none;
    }
  }
</style>
