    traits: [
      { label: 'Age', value: '65+' },
      { label: 'Gender', value: 'Female skew' },
      { label: 'Income', value: '$100k–$150k+' },
      { label: 'Education', value: 'College' },
      { label: 'Occupation', value: 'Retired / Healthcare / Religious' },
      { label: 'Location', value: 'Virginia, Iowa, Vermont' },
    ],
    signals: [
      { label: '65+ index 128 (peak)', strong: true },
      { label: 'Virginia index 291', strong: true },
      { label: 'Iowa index 556', strong: true },
      { label: 'Religious Leader index 106' },
      { label: 'General Health index 128' },
      { label: 'Vermont index 355' },
    ],
