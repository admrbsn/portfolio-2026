---

{/*
  Ruled, not boxed. The four archetypes share one grid of rules the way the
  homepage's Capabilities index does: horizontals running the full width of the
  viewport, a single vertical between the columns, and a square at every
  crossing. Four rounded panels read as four separate objects; one ruled grid
  reads as one dataset cut four ways, which is what these are.

  The horizontal rules are their own grid items rather than cell borders. A cell
  border stops at the content column, and `margin-inline: calc(50% - 50vw)` only
  reaches the viewport from an element that is itself centred in it — which a
  full-width row is and a left-hand cell is not.

  `--tight` rules only exist below `md`, where the grid collapses to one column
  and every card boundary needs its own rule. At `md` they are `display: none`,
  which takes them out of grid flow entirely so the 2x2 lays out untouched.
*/}
<div class="personas my-12" data-anim="reveal">
  <ul class="personas__grid">
    <li class="personas__rule" aria-hidden="true"><RuleCross /></li>
    {
      personas.map((p, i) => (
        <>
          {/* Between the two cards of a stacked row, below `md` only. */}
          {i % 2 === 1 && (
            <li class="personas__rule personas__rule--tight" aria-hidden="true">
              <RuleCross />
            </li>
          )}

          <li class:list={['persona', i % 2 === 1 && 'persona--right']}>
            {/*
              The divider is the only vertical, so it carries the only
              crossings: the rule above each right-hand cell, and the closing
              rule below the last one. Stacked, there is no divider and nothing
              is marked — same rule the Impact band follows.
            */}
            {i % 2 === 1 && (
              <>
                <span class="bp-sq bp-sq--t bp-sq--l" aria-hidden="true" />
                {i === personas.length - 1 && (
                  <span class="bp-sq bp-sq--b bp-sq--l" aria-hidden="true" />
                )}
              </>
            )}

          <div class="persona__head">
            {/* Icon sits inline with the name rather than on its own line —
                four cards of stacked icons cost a lot of height for nothing. */}
            <h3 class="persona__name">
              <span aria-hidden="true">{p.icon}</span>
              {p.name}
            </h3>
            <p class="persona__archetype">{p.archetype}</p>
            <p class="persona__blurb">{p.blurb}</p>
          </div>

          <dl class="persona__traits">
            {p.traits.map((t) => (
              <div>
                <dt>{t.label}</dt>
                <dd>{t.value}</dd>
              </div>
            ))}
          </dl>

          <div class="persona__signals">
            <p class="persona__signals-label">Key signals</p>
            <ul>
              {p.signals.map((s) => (
                <li class={s.strong ? 'is-strong' : undefined}>{s.label}</li>
              ))}
            </ul>
          </div>
          </li>

          {/* Row rule. After the second of a pair at `md`, after every card
              below it — same element, the grid just has fewer columns. */}
          {i % 2 === 1 && (
            <li class="personas__rule" aria-hidden="true">
              <RuleCross />
            </li>
          )}
        </>
      ))
    }
  </ul>

  <p class="personas__method">
    <strong>Methodology:</strong> Personas are synthesized from Dun &amp; Bradstreet audience
    intelligence across demographics, occupation, industry, and geography. Signal tags show the most
    statistically significant index values (100 = US average) driving each archetype. The
    Celebration Planner represents the core acquisition target; the Executive Organizer represents
    the highest LTV opportunity.
  </p>
</div>

<style>
  /*
    List reset, deliberately over-specified.

    `.case-body` styles prose `ul`/`li` as body copy. Its rules now skip
    classed lists (`ul:not([class])`), but naming the wrapper here as well is
    cheap insurance — this component is the one that carries chips inside cells
    inside a list, and a stray disc anywhere in that stack is very visible.
  */
  .personas .persona__signals ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Same reset, but this one also carries the pull-out margin below — declaring
     `margin: 0` for it in the shared rule silently beat that. */
  .personas .personas__grid {
    list-style: none;
    padding: 0;
    margin-block: 0;
    margin-inline: calc(-1 * var(--cell-pad));
  }

  .personas .persona,
  .personas .persona__signals li {
    margin: 0;
  }

  .personas__grid {
    /* One padding value for every cell, and the pull-out that keeps the copy on
       the body column's rail despite it. Both read this. */
    --cell-pad: 1.5rem;
    position: relative;
    display: grid;
    gap: 0;
  }

  @media (min-width: 48rem) {
    .personas__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /*
    A rule, as a grid item spanning every column. The negative inline margin is
    the standard full-bleed escape: `50%` resolves against the content column
    and `50vw` against the viewport, so a centred row reaches both edges. The
    body carries `overflow-x: clip`, which is what keeps that from producing a
    horizontal scrollbar.
  */
  .personas__rule {
    position: relative;
    grid-column: 1 / -1;
    height: 0;
    border-top: 1px solid var(--color-line);
    margin-inline: calc(50% - 50vw);
  }

  @media (min-width: 48rem) {
    /* One column becomes two; the per-card rules have nothing left to separate.
       `display: none` also drops them out of grid flow, so the 2x2 is clean. */
    .personas__rule--tight {
      display: none;
    }
  }

  /*
    One padding value on all four sides of every cell, so the gap to a rule is
    the same wherever you measure it — and the grid is pulled out by exactly
    that much (`--cell-pad`) so the text still lands on the body column's rail
    rather than stepping in from it. Cell padding and grid margin are the same
    token for that reason: change one and the copy drifts off the rail.
  */
  .persona {
    position: relative; /* containing block for this cell's own squares */
    display: flex;
    flex-direction: column;
    padding: var(--cell-pad);
  }

  @media (min-width: 48rem) {
    .persona--right {
      border-left: 1px solid var(--color-line);
    }
  }

  /* No divider below `md`, so nothing crosses and nothing is marked. */
  .persona .bp-sq {
    display: none;
  }

  @media (min-width: 48rem) {
    .persona .bp-sq {
      display: block;
    }
  }

  .persona__name {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .persona__archetype {
    margin: 0.25rem 0 0;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .persona__blurb {
    margin: 0.55rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-ink-dim);
  }

  /* Traits ---------------------------------------------------------- */

  /*
    The internal rules are gone with the card that carried them. Sections are
    separated by space now — with the grid's own rules doing the dividing, a
    second order of hairline inside each cell read as clutter.
  */
  .persona__traits {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.55rem 1rem;
    margin: 0.9rem 0 0;
    padding: 0;
  }

  .persona__traits dt {
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }

  .persona__traits dd {
    margin: 0.15rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--color-ink);
  }

  /* Signals ---------------------------------------------------------- */

  .persona__signals {
    margin-top: 0.9rem;
    padding: 0;
  }

  .persona__signals-label {
    margin: 0 0 0.5rem;
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }

  .persona__signals ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.28rem;
  }

  .persona__signals li {
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    font-size: 0.6875rem;
    line-height: 1.35;
    color: var(--color-ink-faint);
  }

  /* The signals that actually drove the archetype, rather than merely
     describing it — the accent is the whole distinction being drawn. */
  .persona__signals li.is-strong {
    border-color: color-mix(in oklab, var(--color-accent) 45%, transparent);
    color: var(--color-accent);
  }

  /* Methodology ------------------------------------------------------ */

  /* Unboxed too — it is a footnote under a ruled grid, and a panel here would
     reintroduce the shape the grid just got rid of. */
  .personas__method {
    margin: 0.9rem 0 0;
    padding: 0;
    font-size: 0.75rem;
    line-height: 1.55;
    color: var(--color-ink-faint);
  }

  .personas__method strong {
    color: var(--color-ink-dim);
    font-weight: 600;
  }
</style>
