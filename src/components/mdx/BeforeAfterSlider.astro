---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  beforeLabel?: string;
  afterLabel?: string;
  caption?: string;
}

const {
  before,
  after,
  beforeLabel = 'Before',
  afterLabel = 'After',
  caption,
} = Astro.props;
---

<figure class="mx-auto my-16 max-w-5xl" data-anim="reveal">
  <div class="ba" data-before-after>
    <div class="ba__stage">
      <div class="ba__layer">
        <Image
          src={before}
          alt={`${beforeLabel}: ${caption ?? 'design'}`}
          widths={[640, 1024, 1600]}
          sizes="(min-width: 1024px) 70vw, 92vw"
          class="ba__img"
        />
        <span class="ba__label ba__label--before" aria-hidden="true">{beforeLabel}</span>
      </div>

      {/* Clipped over the top; the handle moves the clip edge. */}
      <div class="ba__layer ba__layer--after" data-after>
        <Image
          src={after}
          alt={`${afterLabel}: ${caption ?? 'design'}`}
          widths={[640, 1024, 1600]}
          sizes="(min-width: 1024px) 70vw, 92vw"
          class="ba__img"
        />
        <span class="ba__label ba__label--after" aria-hidden="true">{afterLabel}</span>
      </div>

      <div
        class="ba__handle"
        data-handle
        role="slider"
        aria-label={`Reveal ${afterLabel.toLowerCase()} over ${beforeLabel.toLowerCase()}`}
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="50"
        tabindex="0"
      >
        <span class="ba__line"></span>
        <span class="ba__grip">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M9 7L4 12L9 17M15 7L20 12L15 17"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </span>
      </div>
    </div>
  </div>

  {
    caption && (
      <figcaption class="mt-4 text-micro uppercase tracking-[0.14em] text-ink-faint">
        {caption}
      </figcaption>
    )
  }
</figure>

<script>
  function initSlider(root: HTMLElement) {
    const stage = root.querySelector<HTMLElement>('.ba__stage');
    const after = root.querySelector<HTMLElement>('[data-after]');
    const handle = root.querySelector<HTMLElement>('[data-handle]');
    if (!stage || !after || !handle) return () => {};

    let dragging = false;
    let pointerId: number | null = null;

    function setPercent(percent: number) {
      const clamped = Math.max(0, Math.min(100, percent));
      after!.style.clipPath = `inset(0 0 0 ${clamped}%)`;
      handle!.style.left = `${clamped}%`;
      handle!.setAttribute('aria-valuenow', Math.round(clamped).toString());
    }

    function setFromClientX(clientX: number) {
      const rect = stage!.getBoundingClientRect();
      if (!rect.width) return;
      setPercent(((clientX - rect.left) / rect.width) * 100);
    }

    const onPointerDown = (event: PointerEvent) => {
      event.preventDefault();
      dragging = true;
      pointerId = event.pointerId;
      handle.setPointerCapture(event.pointerId);
      setFromClientX(event.clientX);
    };

    const onPointerMove = (event: PointerEvent) => {
      if (dragging) setFromClientX(event.clientX);
    };

    const onPointerUp = (event: PointerEvent) => {
      if (!dragging || pointerId === null || event.pointerId !== pointerId) return;
      dragging = false;
      try {
        handle.releasePointerCapture(pointerId);
      } catch {
        /* already released */
      }
      pointerId = null;
    };

    const onKeyDown = (event: KeyboardEvent) => {
      const current = Number(handle.getAttribute('aria-valuenow') ?? 50);
      // Shift jumps by ten, matching the convention for native range inputs.
      const step = event.shiftKey ? 10 : 2;
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        setPercent(current - step);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        setPercent(current + step);
      } else if (event.key === 'Home') {
        event.preventDefault();
        setPercent(0);
      } else if (event.key === 'End') {
        event.preventDefault();
        setPercent(100);
      }
    };

    handle.addEventListener('pointerdown', onPointerDown);
    window.addEventListener('pointermove', onPointerMove);
    window.addEventListener('pointerup', onPointerUp);
    window.addEventListener('pointercancel', onPointerUp);
    handle.addEventListener('keydown', onKeyDown);

    setPercent(50);

    return () => {
      handle.removeEventListener('pointerdown', onPointerDown);
      window.removeEventListener('pointermove', onPointerMove);
      window.removeEventListener('pointerup', onPointerUp);
      window.removeEventListener('pointercancel', onPointerUp);
      handle.removeEventListener('keydown', onKeyDown);
    };
  }

  /*
    Same teardown contract as the motion registry — the window-level pointer
    listeners would otherwise pile up against detached DOM on every client-side
    navigation.
  */
  let teardowns: (() => void)[] = [];

  document.addEventListener('astro:page-load', () => {
    teardowns = [...document.querySelectorAll<HTMLElement>('[data-before-after]')].map(initSlider);
  });

  document.addEventListener('astro:before-swap', () => {
    teardowns.forEach((fn) => fn());
    teardowns = [];
  });
</script>

<style>
  .ba {
    overflow: hidden;
    border-radius: 0.5rem;
    border: 1px solid var(--color-line);
    background: var(--color-surface-lift);
  }

  .ba__stage {
    position: relative;
    aspect-ratio: 16 / 10;
    min-height: 200px;
    /* The handle is dragged horizontally; let the browser keep vertical
       panning so the page still scrolls from on top of the image. */
    touch-action: pan-y;
  }

  .ba__layer {
    position: absolute;
    inset: 0;
  }

  .ba__layer--after {
    clip-path: inset(0 0 0 50%);
    /* Pointer events belong to the handle, not the clipped layer. */
    pointer-events: none;
  }

  .ba__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ba__label {
    position: absolute;
    bottom: 0.75rem;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    background: oklch(0 0 0 / 0.66);
    color: oklch(1 0 0);
    font-size: var(--text-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ba__label--before {
    left: 0.75rem;
  }
  .ba__label--after {
    right: 0.75rem;
  }

  .ba__handle {
    position: absolute;
    inset-block: 0;
    left: 50%;
    width: 2.75rem;
    transform: translateX(-50%);
    display: grid;
    place-items: center;
    cursor: ew-resize;
    touch-action: none;
  }

  .ba__line {
    position: absolute;
    inset-block: 0;
    left: 50%;
    width: 2px;
    transform: translateX(-50%);
    background: oklch(1 0 0);
    box-shadow: 0 0 6px oklch(0 0 0 / 0.5);
  }

  .ba__grip {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background: oklch(1 0 0);
    color: oklch(0.25 0 0);
    box-shadow: 0 2px 10px oklch(0 0 0 / 0.35);
  }

  .ba__handle:focus {
    outline: none;
  }

  .ba__handle:focus-visible .ba__grip {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
</style>
