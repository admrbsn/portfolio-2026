---
import { experience } from '../data/experience';

// Home résumé. Editorial two-column layout: a sticky intro on the left, the
// role list on the right. Rows stagger in on scroll (reveal-batch) and lift on
// hover. The detailed version, with bullets, lives on /about.
---

<section class="px-gutter py-section" aria-labelledby="experience-heading">
  <div class="grid gap-12 lg:grid-cols-[minmax(0,19rem)_1fr] lg:gap-20">
    {/* Left: sticky intro. Adapts the reference's testimonial column into a
        first-person framing; drop a real quote in here if one lands. */}
    <div class="lg:sticky lg:top-32 lg:self-start" data-anim="reveal">
      <p class="text-micro uppercase tracking-[0.14em] text-ink-faint">Experience</p>

      <h2
        id="experience-heading"
        class="mt-6 font-display text-[clamp(1.75rem,3vw,2.75rem)] font-normal leading-[1.05] text-ink"
      >
        Nearly twenty years across design and code<span class="accent-gradient">.</span>
      </h2>

      <p class="mt-6 max-w-xs text-ink-dim">
        From Apple's bench to leading product design at Tribute, most of it spent living on both
        sides of the design and engineering line.
      </p>

      <a
        href="/about"
        class="group mt-8 inline-flex items-center gap-2 text-micro uppercase tracking-[0.14em] text-ink-dim transition-colors hover:text-accent"
      >
        See the full story
        <span
          class="transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:translate-x-1 group-hover:-translate-y-1"
          aria-hidden="true">↗</span
        >
      </a>
    </div>

    {/* Right: role list. Divide-y draws the hairlines between rows only. */}
    <ol class="divide-y divide-line" data-anim="reveal-batch">
      {
        experience.map((job) => (
          <li class="group py-7 md:py-9">
            <div class="flex flex-col gap-2 md:flex-row md:items-baseline md:justify-between md:gap-8">
              <div class="md:transition-transform md:duration-500 md:ease-[var(--ease-out-expo)] md:group-hover:translate-x-2">
                <h3 class="font-display text-[clamp(1.375rem,2.4vw,2.15rem)] font-normal leading-[1.05] tracking-tight text-balance text-ink transition-colors duration-500 group-hover:text-accent">{job.role}<span class="text-accent">.</span></h3>
                <p class="mt-2 text-micro uppercase tracking-[0.14em] text-ink-faint">{job.company}</p>
              </div>

              <p class="shrink-0 text-micro uppercase tracking-[0.14em] text-ink-faint md:text-right">
                {job.period}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
