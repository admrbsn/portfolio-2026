---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { shots, dribbbleUrl } from '../data/dribbble';

// Full-bleed grid of self-hosted Dribbble thumbnails (see src/data/dribbble.ts).
// Images are imported eagerly so Astro optimises each one; look them up by file.
const images = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/dribbble/*.{png,jpg,jpeg}',
  { eager: true },
);
const imageByFile = Object.fromEntries(
  Object.entries(images).map(([path, mod]) => [path.split('/').pop(), mod.default]),
);
---

<section id="dribbble" class="relative py-section" aria-labelledby="recent-work" data-blueprint="The Sketchbook">
  <div class="flex items-end justify-between gap-6 px-shell">
    <div>
      <p class="text-micro uppercase tracking-[0.14em] text-ink-faint">What I've been up to</p>
      <h2
        id="recent-work"
        class="mt-4 font-display text-title font-normal text-ink"
        data-anim="reveal-heading"
      >
        Dribbble Shots
      </h2>
    </div>

    <a
      href={dribbbleUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="group hidden shrink-0 items-center gap-2 text-micro uppercase tracking-[0.14em] text-ink-dim transition-colors hover:text-accent sm:inline-flex"
    >
      See more on Dribbble
      <span
        class="transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:translate-x-1 group-hover:-translate-y-1"
        aria-hidden="true">↗</span
      >
    </a>
  </div>

  {/* Full-bleed, tightly packed grid — a thin gutter keeps tiles off the edge. */}
  <ul
    class="mt-12 grid grid-cols-3 gap-1 px-1 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 xl:grid-cols-8"
    data-anim="reveal-batch"
  >
    {
      shots.map((shot) => (
        <li>
          <a
            href={shot.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Dribbble shot: ${shot.title}`}
            class="group relative block aspect-[4/3] overflow-hidden rounded-md bg-surface-lift"
            data-cursor="grow"
          >
            <Image
              src={imageByFile[shot.file]}
              alt={shot.title}
              widths={[200, 320, 480]}
              sizes="(min-width: 1280px) 12.5vw, (min-width: 1024px) 16vw, (min-width: 768px) 20vw, (min-width: 640px) 25vw, 33vw"
              class="h-full w-full object-cover transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:scale-[1.06]"
              loading="lazy"
            />
            <div class="pointer-events-none absolute inset-0 flex items-end bg-gradient-to-t from-black/85 via-black/10 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100">
              <p class="line-clamp-2 p-2.5 text-[11px] leading-snug text-white/90">{shot.title}</p>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</section>
