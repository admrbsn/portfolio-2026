---
import RuleCross from './RuleCross.astro';
import BrandMark from './BrandMark.astro';
import ToolHeader from './ToolHeader.astro';
import RichText from './RichText.astro';

/*
  Fern — dev and API docs. The mock is an API reference page of the kind Fern
  generates from a spec: sidebar, endpoint, parameter table, and a request in
  the SDK languages it generates. The endpoint is the illustrative upload API
  the PRD mock cites (`POST /v1/uploads`), so the two sections point at the
  same thing.

  Claims, all from Fern's own pages: specs in (OpenAPI, AsyncAPI, gRPC,
  OpenRPC), SDKs out in nine languages, generated interactive docs, Ask Fern
  AI search, `/llms.txt` + `.md` versions of every page, and a hosted MCP
  server for AI clients.

  The language tabs are CSS-only (radio inputs), so there is no script to tear
  down and the default reads with JS off.
*/
const params: { name: string; type: string; req?: boolean; note: string }[] = [
  { name: 'tribute_id', type: 'string', req: true, note: 'The tribute the video belongs to' },
  { name: 'part', type: 'integer', req: true, note: 'Chunk index, from 1' },
  { name: 'content_type', type: 'string', note: 'video/mp4 or video/webm' },
];

const langs = [
  {
    id: 'ts',
    label: 'TypeScript',
    code: [
      ['k', 'await '],
      ['', 'client.uploads.'],
      ['f', 'create'],
      ['', '({\n  tribute_id: '],
      ['s', "'trb_8f2k'"],
      ['', ',\n  part: '],
      ['n', '1'],
      ['', ',\n});'],
    ],
  },
  {
    id: 'py',
    label: 'Python',
    code: [
      ['', 'client.uploads.'],
      ['f', 'create'],
      ['', '(\n    tribute_id='],
      ['s', '"trb_8f2k"'],
      ['', ',\n    part='],
      ['n', '1'],
      ['', ',\n)'],
    ],
  },
  {
    id: 'go',
    label: 'Go',
    code: [
      ['', 'client.Uploads.'],
      ['f', 'Create'],
      ['', '(ctx, &api.UploadRequest{\n  TributeID: '],
      ['s', '"trb_8f2k"'],
      ['', ',\n  Part:      '],
      ['n', '1'],
      ['', ',\n})'],
    ],
  },
];

const nav = ['Overview', 'Authentication', 'Tributes', 'Uploads', 'Webhooks'];

const gives = [
  { t: 'One spec, every surface', b: 'The reference, the SDKs and the changelog all regenerate from the spec, so the docs can’t fall behind the API.' },
  { t: 'Docs agents can read', b: 'Every page has a Markdown twin and an `llms.txt` index, so an agent reads the reference instead of guessing at it.' },
  { t: 'An MCP server for the docs', b: 'Notion’s agent, Claude Code or Cursor can ask the docs directly — which is how the PRD knew the upload limit.' },
  { t: 'The dev wiki, too', b: 'Guides, runbooks and how-tos live beside the reference, versioned with the code they describe.' },
];
---

<section
  class="relative border-t border-line px-shell py-section"
  aria-labelledby="fern"
  data-blueprint="The Reference"
  data-dead="bottom"
>
  <RuleCross />
  <ToolHeader id="fern" brand="fern" eyebrow="Fern · Dev & API docs" title="Docs that write themselves from the spec" dur="16.7s" delay="2s">
    <p>
      An API is only as usable as its docs, and hand-written docs rot the week after launch. Fern
      generates the reference and the SDKs from the spec, and serves the whole thing in a form
      agents can read as easily as people can.
    </p>
  </ToolHeader>

  {/* The reference page ------------------------------------------------ */}
  <div class="fern mt-16 overflow-hidden rounded-ui border border-line bg-surface-lift" aria-hidden="true" data-anim="reveal">
    <div class="flex items-center justify-between border-b border-line px-5 py-2.5 font-mono text-[0.6875rem] text-ink-faint">
      <span class="flex items-center gap-2"><BrandMark name="fern" class="h-3.5 w-3.5 text-ink-dim" /> docs / api-reference</span>
      <span class="hidden sm:inline">Ask AI ⌘K</span>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-[11rem_minmax(0,1fr)] lg:grid-cols-[11rem_minmax(0,1.2fr)_minmax(0,1fr)]">
      <ul class="hidden border-r border-line py-4 text-[0.8125rem] md:block">
        {
          nav.map((n) => (
            <li class:list={['px-5 py-1.5', n === 'Uploads' ? 'bg-surface text-ink' : 'text-ink-dim']}>{n}</li>
          ))
        }
      </ul>

      <div class="px-6 py-7">
        <p class="flex items-center gap-3">
          <span class="fern-verb">POST</span>
          <span class="font-mono text-[0.875rem] text-ink">/v1/uploads</span>
        </p>
        <p class="mt-3 text-[1.25rem] font-medium text-ink">Create an upload</p>
        <p class="mt-2 text-[0.875rem] leading-relaxed text-ink-dim">
          Starts a chunked upload for a contributor’s video. Large takes are split into parts and
          resumed if the connection drops.
        </p>
        <p class="mt-6 font-mono text-[0.625rem] uppercase tracking-[0.14em] text-ink-faint">Body</p>
        <ul class="mt-2 border-t border-line">
          {
            params.map((p) => (
              <li class="border-b border-line py-2.5">
                <span class="font-mono text-[0.8125rem] text-ink">{p.name}</span>
                <span class="ml-2 font-mono text-[0.6875rem] text-ink-faint">{p.type}</span>
                {p.req && <span class="ml-2 font-mono text-[0.625rem] uppercase tracking-[0.14em] text-accent-warm">required</span>}
                <span class="mt-0.5 block text-[0.8125rem] text-ink-dim">{p.note}</span>
              </li>
            ))
          }
        </ul>
      </div>

      {/* The request, in the generated SDKs. CSS-only tabs. */}
      <div class="fern-req border-t border-line bg-surface lg:border-l lg:border-t-0">
        {langs.map((l, i) => <input type="radio" name="fern-lang" id={`fern-${l.id}`} class="sr-only" tabindex="-1" checked={i === 0} />)}
        <div class="flex gap-4 border-b border-line px-5 py-2.5 font-mono text-[0.6875rem]">
          {langs.map((l) => <label for={`fern-${l.id}`} class={`fern-tab fern-tab--${l.id}`}>{l.label}</label>)}
        </div>
        {
          langs.map((l) => (
            <pre class={`fern-code fern-code--${l.id} px-5 py-5 font-mono text-[0.75rem] leading-[1.8]`}><code>{l.code.map(([c, t]) => (c ? <span class={`tk-${c}`}>{t}</span> : t))}</code></pre>
          ))
        }
      </div>
    </div>
  </div>

  {/* What it gives ------------------------------------------------------ */}
  <div class="relative -mx-shell-pad mt-16 grid grid-cols-1 border-y border-line md:grid-cols-2 lg:grid-cols-4" data-anim="reveal-batch">
    <span class="bp-sq bp-sq--t bp-sq--l" aria-hidden="true"></span>
    <span class="bp-sq bp-sq--t bp-sq--r" aria-hidden="true"></span>
    <span class="bp-sq bp-sq--b bp-sq--l" aria-hidden="true"></span>
    <span class="bp-sq bp-sq--b bp-sq--r" aria-hidden="true"></span>
    {
      gives.map((g, i) => (
        <div
          class:list={[
            'relative px-shell-pad py-8',
            i > 0 && 'border-t border-line',
            i === 1 && 'md:border-l md:border-t-0',
            i === 2 && 'lg:border-l lg:border-t-0',
            i === 3 && 'md:border-l lg:border-t-0',
          ]}
        >
          {i > 0 && (
            <>
              <span class="bp-sq bp-sq--t bp-sq--l md:hidden" aria-hidden="true" />
              <span class="bp-sq bp-sq--t bp-sq--r md:hidden" aria-hidden="true" />
            </>
          )}
          {i === 1 && <span class="bp-sq bp-sq--t bp-sq--l hidden md:block" aria-hidden="true" />}
          {i === 2 && <span class="bp-sq bp-sq--t bp-sq--l hidden md:block" aria-hidden="true" />}
          {i === 3 && (
            <>
              <span class="bp-sq bp-sq--t bp-sq--l hidden md:block lg:hidden" aria-hidden="true" />
              <span class="bp-sq bp-sq--t bp-sq--r hidden md:block lg:hidden" aria-hidden="true" />
              <span class="bp-sq bp-sq--t bp-sq--l hidden lg:block" aria-hidden="true" />
              <span class="bp-sq bp-sq--b bp-sq--l hidden md:block" aria-hidden="true" />
            </>
          )}
          {(i === 1 || i === 2) && <span class="bp-sq bp-sq--b bp-sq--l hidden lg:block" aria-hidden="true" />}
          <p class="text-[1.0625rem] font-medium text-ink">{g.t}</p>
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-dim"><RichText text={g.b} /></p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .fern-verb {
    padding: 0.1rem 0.45rem;
    border-radius: var(--radius-ui);
    background: color-mix(in oklab, var(--color-accent) 16%, transparent);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
  }
  .fern-tab {
    cursor: pointer;
    color: var(--color-ink-faint);
    transition: color var(--dur-fast) ease;
  }
  .fern-tab:hover {
    color: var(--color-ink-dim);
  }
  .fern-code {
    display: none;
    margin: 0;
    white-space: pre;
    overflow-x: auto;
    color: var(--color-ink-dim);
  }
  #fern-ts:checked ~ div .fern-tab--ts,
  #fern-py:checked ~ div .fern-tab--py,
  #fern-go:checked ~ div .fern-tab--go {
    color: var(--color-ink);
  }
  #fern-ts:checked ~ .fern-code--ts,
  #fern-py:checked ~ .fern-code--py,
  #fern-go:checked ~ .fern-code--go {
    display: block;
  }
  .tk-k {
    color: var(--color-accent-warm);
  }
  .tk-f {
    color: var(--color-accent);
  }
  .tk-s {
    color: var(--color-ink);
  }
  .tk-n {
    color: var(--color-accent-warm);
  }
</style>
