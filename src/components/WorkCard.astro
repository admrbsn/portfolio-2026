---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
  /** Index in the grid — drives the alternating offset. */
  index?: number;
}

const { entry, index = 0 } = Astro.props;
const { title, client, year, summary, cover, coverAlt, accent } = entry.data;
---

<a
  href={`/work/${entry.id}`}
  class="group block"
  style={accent ? `--card-accent: ${accent}` : undefined}
  data-cursor="grow"
>
  <figure class="relative overflow-hidden rounded-lg bg-surface-lift">
    {/* transition:name pairs this image with the case study hero, so the
        ClientRouter morphs one into the other instead of cross-fading. */}
    <Image
      src={cover}
      alt={coverAlt}
      widths={[480, 800, 1200]}
      sizes="(min-width: 1024px) 46vw, 92vw"
      class="aspect-[4/3] w-full object-cover transition-transform duration-[900ms] ease-[var(--ease-out-expo)] group-hover:scale-[1.045]"
      transition:name={`cover-${entry.id}`}
      loading={index < 2 ? 'eager' : 'lazy'}
    />

    <div
      class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100"
      style="background: linear-gradient(to top, color-mix(in oklab, var(--card-accent, var(--color-accent)) 26%, transparent), transparent 55%)"
    >
    </div>
  </figure>

  <div class="mt-5 flex items-baseline justify-between gap-4">
    <h3 class="text-lead font-medium tracking-tight text-ink">
      {title}
    </h3>
    <span class="shrink-0 text-micro uppercase tracking-[0.14em] text-ink-faint">
      {year}
    </span>
  </div>

  <p class="mt-1 text-micro uppercase tracking-[0.14em] text-ink-faint">{client}</p>
  <p class="mt-3 max-w-prose text-ink-dim">{summary}</p>
</a>
