---
import BaseLayout from '../layouts/BaseLayout.astro';
import NoiseGradient from '../components/NoiseGradient.astro';
import RuleCross from '../components/RuleCross.astro';
import ArrowUpRight from '../components/ArrowUpRight.astro';
import NotionHub from '../components/NotionHub.astro';
import Workbench from '../components/Workbench.astro';
import RelumeGrid from '../components/RelumeGrid.astro';
import FigmaNow from '../components/FigmaNow.astro';
import NotionPrd from '../components/NotionPrd.astro';
import SystemContracts from '../components/SystemContracts.astro';
import ImpeccableDeep from '../components/ImpeccableDeep.astro';
import FernDocs from '../components/FernDocs.astro';
import LinearBoard from '../components/LinearBoard.astro';
import PostHogLoop from '../components/PostHogLoop.astro';
import TeamSystem from '../components/TeamSystem.astro';
import ClawdParade from '../components/ClawdParade.astro';
import BrandMark from '../components/BrandMark.astro';
import type { Brand } from '../data/brands';

/*
  How I work with AI. Its own page because it grew past a section — it is a
  process story, where the homepage is outcomes and /about is how I lead. Both
  link here through `WorkbenchCta`, and the nav carries it as "AI".

  Order is the argument, and it follows one piece of work (the recording-flow
  redesign) through the whole chain: where it is coordinated (the Notion hub),
  how it is specified (PRDs), how it is made (the workbench, Impeccable),
  where its structure and contracts come from (Relume, Fern), how it is
  planned (Linear), how it is judged once live (PostHog), how it scales past
  me (the team), and what Figma is for now. It is framed — in the hero, on
  purpose — as how I'd run that redesign *today*: it shipped in 2024, before
  most of these tools existed.
*/
// The close: the two case studies this page draws on, with their real outcomes.
const receipts = [
  {
    href: '/work/recording-flow',
    client: 'Tribute Recording Flow',
    figure: '33% → 66.58%',
    label: 'submission rate on the core flow',
    title: 'Doubling submissions on a core flow',
  },
  {
    href: '/work/tribute-v3',
    client: 'Tribute V3',
    figure: '3 months',
    label: 'to rebuild a decade-old platform, team of four',
    title: 'Re-architecting a decade-old platform',
  },
];

const chapters: { href: string; label: string; brand?: Brand }[] = [
  { href: '#point-guard', label: 'The hub', brand: 'notion' },
  { href: '#prds', label: 'PRDs', brand: 'notion' },
  { href: '#workbench', label: 'Workbench' },
  { href: '#system', label: 'The system' },
  { href: '#impeccable', label: 'Impeccable', brand: 'impeccable' },
  { href: '#relume', label: 'Relume', brand: 'relume' },
  { href: '#fern', label: 'Fern', brand: 'fern' },
  { href: '#linear', label: 'Linear', brand: 'linear' },
  { href: '#posthog', label: 'PostHog', brand: 'posthog' },
  { href: '#team', label: 'The team' },
  { href: '#figma-now', label: 'Figma', brand: 'figma' },
];
---

<BaseLayout
  title="How I work with AI · Adam Robertson"
  description="One redesign through an AI-first toolchain: Notion as the hub for MCP-connected agents, evidence-cited PRDs, briefs for Claude Code, a design system agents can read, two deterministic gates, Impeccable taste passes, Relume, Fern docs, Linear, and PostHog’s self-driving loop."
>
  <div class="page-rails signal-page">
    {/* Hero — text-first, on the about page's pattern and scale. No
        `data-blueprint`: its caption would collide with the nav's. */}
    <section class="relative flex min-h-[62svh] flex-col overflow-hidden px-shell pb-28 pt-36">
      <NoiseGradient intensity="soft" />
      <div class="hero-crt" aria-hidden="true"></div>
      {/* Agents, doing the legwork — along the rule under the hero. */}
      <ClawdParade />
      <div class="relative z-10 my-auto w-full">
        {/*
          Headline across the full width, one sentence per line from `md` up,
          then the lead under it on the right. Beside the lead (the /about
          pattern) the h1 got ~60% of the row, and in the wide display face that broke it into
          three ragged lines that split the gradient phrase mid-sentence.
        */}
        <div class="grid gap-y-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,34rem)]">
          {/* No eyebrow: the page heroes match /about's — headline, then lead. */}
          <div class="lg:col-span-2">
            <h1
              class="font-display text-[clamp(2rem,4.3vw,3.75rem)] leading-[1.2] tracking-[-0.02em] text-ink"
              data-anim="reveal-heading"
            >
              Agents do the <span class="outage outage--a" data-text="legwork"><span class="outage__tear" data-text="legwork">legwork</span></span>.<br class="hidden md:block" />
              {' '}I bring the <span class="phrase-gradient">judgment.</span>
            </h1>
          </div>
          {/*
            One paragraph, and it carries the framing on purpose: the thread
            through the page is the recording-flow redesign, which shipped in
            2024 — before most of these tools existed — so it is presented as
            how I'd run it *today*. Keep that clause if this is ever rewritten.
          */}
          <p
            class="max-w-xl text-[clamp(1.0625rem,1.35vw,1.3rem)] leading-[1.55] text-ink-lead lg:col-start-2"
            data-anim="reveal"
          >
            I brief agents the way I used to brief engineers, and put working prototypes in front of
            people in days, not sprints. This page follows one real redesign, the
            <a href="/work/recording-flow" class="text-ink underline decoration-line underline-offset-4 transition-colors hover:text-accent hover:decoration-accent">recording flow</a>
            (33% → 66.58%), run the way I’d run it today.
          </p>
        </div>
      </div>
    </section>

    {/* Chapters — one ruled row of links, the way a long docs page opens.
        It scrolls sideways on a phone rather than wrapping into a block.
        It sticks under the nav (and rides up with it when the nav retracts),
        and a single highlight glides to the section you're reading, filling
        with your progress through it — see the script at the foot. */}
    <nav aria-label="On this page" class="chapter-nav relative border-t border-line" data-chapter-nav>
      <RuleCross />
      <ul class="chapters relative flex gap-2 overflow-x-auto px-shell py-4">
        <li class="chapter-ind" aria-hidden="true"><span class="chapter-ind__fill"></span></li>
        {
          chapters.map((c, i) => (
            <li class="shrink-0">
              <a href={c.href} class="chapter" data-chapter={c.href}>
                <span class="font-mono text-[0.625rem] text-ink-faint">{String(i + 1).padStart(2, '0')}</span>
                {c.brand && <BrandMark name={c.brand} class="h-3.5 w-3.5" />}
                {c.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <NotionHub />
    <NotionPrd />
    <Workbench />
    <SystemContracts />
    <ImpeccableDeep />
    <RelumeGrid />
    <FernDocs />
    <LinearBoard />
    <PostHogLoop />
    <TeamSystem />
    <FigmaNow />

    {/*
      Close — back to what it produced. The grid owns the section's top edge
      (no top padding, no second top rule), so the dividers run up into the
      section rule and cross it — those crossings are the RuleCross squares'
      siblings, drawn by each cell. One ruled row, the page's own grammar:
      the heading cell, then one cell per case study the page draws on, each
      a link carrying its real outcome. Replaces a heading-left / lone-link-
      right layout that left the middle of the band empty.
    */}
    <section class="relative border-t border-line px-shell pb-section" data-blueprint="The Receipts" data-dead="bottom">
      <RuleCross />
      <div class="relative -mx-shell-pad grid grid-cols-1 border-b border-line lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)_minmax(0,1fr)]">
        <span class="bp-sq bp-sq--b bp-sq--l" aria-hidden="true"></span>
        <span class="bp-sq bp-sq--b bp-sq--r" aria-hidden="true"></span>

        <div class="flex flex-col gap-8 px-shell-pad pb-10 pt-16">
          <h2 class="font-display text-title text-ink" data-anim="reveal-heading">See what it shipped</h2>
          <a
            href="/#work"
            class="group inline-flex items-center gap-2 self-start text-micro uppercase tracking-[0.14em] text-ink-dim transition-colors hover:text-accent"
          >
            All work <ArrowUpRight />
          </a>
        </div>

        {
          receipts.map((r) => (
            <a
              href={r.href}
              class="receipt group relative flex flex-col border-t border-line px-shell-pad py-10 lg:border-l lg:border-t-0 lg:pt-16"
            >
              <span class="bp-sq bp-sq--t bp-sq--l lg:hidden" aria-hidden="true" />
              <span class="bp-sq bp-sq--t bp-sq--r lg:hidden" aria-hidden="true" />
              <span class="bp-sq bp-sq--b bp-sq--l hidden lg:block" aria-hidden="true" />
              <span class="bp-sq bp-sq--t bp-sq--l hidden lg:block" aria-hidden="true" />
              <span class="text-micro uppercase tracking-[0.14em] text-ink-faint">{r.client}</span>
              <span class="receipt__fig mt-6 text-ink">{r.figure}</span>
              <span class="mt-2 text-[0.9375rem] text-ink-dim">{r.label}</span>
              <span class="mt-8 inline-flex items-center gap-2 text-[0.9375rem] font-medium text-ink transition-colors group-hover:text-accent">
                {r.title} <ArrowUpRight />
              </span>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .receipt__fig {
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: lining-nums tabular-nums;
  }
  .receipt {
    transition: background-color var(--dur-fast) ease;
  }
  .receipt:hover {
    background: color-mix(in oklab, var(--color-surface-lift) 60%, transparent);
  }
  .chapters {
    scrollbar-width: none;
  }
  .chapters::-webkit-scrollbar {
    display: none;
  }
  .chapter {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.8rem;
    border: 1px dashed var(--color-line);
    border-radius: var(--radius-ui);
    /* Opaque, so on a phone the strip slides over the dashed rails rather
       than the rails showing through the chips. */
    background: var(--color-surface);
    color: var(--color-ink-dim);
    font-size: 0.8125rem;
    white-space: nowrap;
    transition:
      color var(--dur-fast) ease,
      border-color var(--dur-fast) ease;
  }
  .chapter:hover,
  .chapter:focus-visible {
    border-style: solid;
    border-color: color-mix(in oklab, var(--color-accent) 55%, var(--color-line));
    color: var(--color-ink);
  }
  .chapter[aria-current='true'] {
    color: var(--color-ink);
  }

  /*
    Sticky strip. It sits right under the nav and rides up to the viewport
    edge when the nav retracts, over the nav's own 500ms so the two move as
    one. Under reduced motion the nav never retracts, so the strip stays put.
    Opaque, with a rule under it, so the page scrolls cleanly beneath.
  */
  .chapter-nav {
    position: sticky;
    top: var(--nav-h, 4.3125rem);
    z-index: 30;
    background: color-mix(in oklab, var(--color-surface) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-line);
    transition: top 500ms var(--ease-out-expo);
  }
  :global([data-nav][data-nav-state='hidden']) ~ :global(main) .chapter-nav {
    top: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    :global([data-nav][data-nav-state='hidden']) ~ :global(main) .chapter-nav {
      top: var(--nav-h, 4.3125rem);
    }
  }

  /*
    The highlight: one element, not a state on each chip, so it can travel.
    The script sets its x and width to the active chip's box; it glides there
    on an expo ease, then lands with a short signal flicker (the page's zap
    vocabulary: a sideways jitter and a blue/purple split). The fill along its
    foot is progress through the section, 0→1, from `--p`.
  */
  .chapter-ind {
    position: absolute;
    top: 1rem;
    bottom: 1rem;
    left: 0;
    width: var(--w, 0);
    transform: translateX(var(--x, 0));
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-ui);
    background: color-mix(in oklab, var(--color-accent) 9%, transparent);
    opacity: 0;
    pointer-events: none;
    z-index: 1;
    transition:
      transform 650ms var(--ease-out-expo),
      width 650ms var(--ease-out-expo),
      opacity 300ms ease;
  }
  .chapter-ind.is-on {
    opacity: 1;
  }
  .chapter-ind__fill {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--color-accent);
    transform-origin: left;
    transform: scaleX(var(--p, 0));
  }
  .chapter-ind.is-landing {
    animation: chapter-land 420ms steps(1, end);
  }
  @keyframes chapter-land {
    0% { translate: 0 0; filter: none; }
    20% { translate: 2px 0; filter: drop-shadow(-2px 0 0 var(--color-accent)) drop-shadow(2px 0 0 var(--color-accent-warm)); opacity: 0.55; }
    40% { translate: -1px 0; filter: drop-shadow(1px 0 0 var(--color-accent-warm)); opacity: 1; }
    60% { translate: 0 0; filter: none; opacity: 0.75; }
    80%, 100% { translate: 0 0; filter: none; opacity: 1; }
  }
  /* The chips sit above the highlight's tint, so their text stays crisp. */
  .chapters > li:not(.chapter-ind) {
    position: relative;
    z-index: 2;
  }
  .chapter[aria-current='true'] {
    border-color: transparent;
    background: transparent;
  }

  @media (prefers-reduced-motion: reduce) {
    .chapter-ind {
      transition: opacity 300ms ease;
    }
    .chapter-ind.is-landing {
      animation: none;
    }
  }
  :global(html[data-motion='reduced']) .chapter-ind,
  :global(html[data-motion='failed']) .chapter-ind {
    transition: opacity 300ms ease;
  }
  :global(html[data-motion='reduced']) .chapter-ind.is-landing,
  :global(html[data-motion='failed']) .chapter-ind.is-landing {
    animation: none;
  }
</style>

<script>
  import { getLenis } from '../lib/motion/lenis';

  /*
    Chapter strip: which section you're in, how far through it, and a click
    that lands the section's top just under the strip (native anchors would
    park it behind the sticky bar). Resolves its elements on each page load
    and returns a teardown, per the motion contract.
  */
  function initChapters(nav: HTMLElement) {
    const list = nav.querySelector<HTMLElement>('.chapters')!;
    const ind = nav.querySelector<HTMLElement>('.chapter-ind')!;
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('[data-chapter]')];
    const targets = links.map((a) => {
      const el = document.querySelector<HTMLElement>(a.getAttribute('href')!);
      return (el?.closest('section') as HTMLElement | null) ?? el;
    });
    const reduced = () =>
      window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
      ['reduced', 'failed'].includes(document.documentElement.dataset.motion ?? '');

    let active = -1;
    let frame = 0;
    let landTimer = 0;
    let touchedAt = -Infinity;

    // Measured off each chip's <li>, not the link: the <li> is positioned
    // (it stacks the chip above the highlight), so a link's offsetLeft is
    // relative to its own <li> and always 0.
    const chip = (i: number) => links[i].parentElement as HTMLElement;
    const place = (i: number) => {
      const li = chip(i);
      ind.style.setProperty('--x', `${li.offsetLeft}px`);
      ind.style.setProperty('--w', `${li.offsetWidth}px`);
    };

    const setActive = (i: number) => {
      if (i === active) return;
      const first = active === -1;
      active = i;
      links.forEach((a, j) => a.setAttribute('aria-current', j === i ? 'true' : 'false'));
      if (i < 0) {
        ind.classList.remove('is-on');
        return;
      }
      // First appearance: jump into place, then fade in, rather than gliding
      // in from the strip's left edge.
      if (first) {
        ind.style.transition = 'none';
        place(i);
        void ind.offsetWidth;
        ind.style.transition = '';
      } else {
        place(i);
      }
      ind.classList.add('is-on');
      if (!reduced()) {
        window.clearTimeout(landTimer);
        ind.classList.remove('is-landing');
        landTimer = window.setTimeout(() => {
          void ind.offsetWidth;
          ind.classList.add('is-landing');
        }, first ? 0 : 450);
      }
      // On a phone, keep the live chip in view — unless the reader is
      // scrolling the strip themselves.
      if (list.scrollWidth > list.clientWidth && performance.now() - touchedAt > 3000) {
        const li = chip(i);
        list.scrollTo({ left: li.offsetLeft + li.offsetWidth / 2 - list.clientWidth / 2, behavior: reduced() ? 'auto' : 'smooth' });
      }
    };

    const measure = () => {
      frame = 0;
      // The reading line: just under the strip, a third of the way down what's left.
      const stripBottom = nav.getBoundingClientRect().bottom;
      const line = stripBottom + (window.innerHeight - stripBottom) * 0.33;
      let i = -1;
      targets.forEach((t, j) => {
        if (t && t.getBoundingClientRect().top <= line) i = j;
      });
      if (i >= 0) {
        const r = targets[i]!.getBoundingClientRect();
        const p = Math.min(1, Math.max(0, (line - r.top) / r.height));
        ind.style.setProperty('--p', p.toFixed(3));
      }
      setActive(i);
    };
    const onScroll = () => {
      if (!frame) frame = requestAnimationFrame(measure);
    };
    const onResize = () => {
      if (active >= 0) place(active);
      onScroll();
    };

    const onClick = (e: MouseEvent) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('[data-chapter]');
      if (!a) return;
      const t = targets[links.indexOf(a)];
      if (!t) return;
      e.preventDefault();
      const y = t.getBoundingClientRect().top + window.scrollY;
      // Going down, the nav retracts and only the strip is above the section;
      // going up, the nav comes back as well.
      const navH = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--nav-h')) || 69;
      const above = nav.offsetHeight + (y < window.scrollY ? navH : 0);
      const top = Math.max(0, y - above + 1);
      const lenis = getLenis();
      if (lenis) lenis.scrollTo(top, { duration: 1.2 });
      else window.scrollTo({ top, behavior: reduced() ? 'auto' : 'smooth' });
      history.replaceState(null, '', a.getAttribute('href'));
    };
    const onTouch = () => (touchedAt = performance.now());

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onResize);
    nav.addEventListener('click', onClick);
    list.addEventListener('pointerdown', onTouch);
    list.addEventListener('wheel', onTouch, { passive: true });
    // Webfonts change chip widths after first paint.
    document.fonts?.ready.then(onResize);
    measure();

    return () => {
      cancelAnimationFrame(frame);
      window.clearTimeout(landTimer);
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onResize);
      nav.removeEventListener('click', onClick);
      list.removeEventListener('pointerdown', onTouch);
      list.removeEventListener('wheel', onTouch);
    };
  }

  let teardown: (() => void) | null = null;

  document.addEventListener('astro:page-load', () => {
    const nav = document.querySelector<HTMLElement>('[data-chapter-nav]');
    teardown = nav ? initChapters(nav) : null;
  });

  document.addEventListener('astro:before-swap', () => {
    teardown?.();
    teardown = null;
  });
</script>
