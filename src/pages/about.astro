<style>
  /* Process pipeline — dashed stations, solid connectors, a dashed return. */
  .process-pipe {
    position: relative;
    max-width: 46rem;
    margin-inline: auto;
  }
  .process-pipe__row {
    position: relative;
    display: flex;
    align-items: center;
  }
  /* Each station is a diagram node, cloudflare.com's request-path style: the
     icon stacked over the label. A shared min-width keeps the end stops'
     centres at 3.25rem in, where the return loop's ends are drawn. */
  .process-pipe__stop {
    position: relative;
    z-index: 1;
    display: inline-flex;
    flex: 0 0 auto;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 6.5rem;
    padding: 0.85rem 1rem 0.75rem;
    border: 1px dashed var(--color-line);
    border-radius: var(--radius-ui);
    background: var(--color-surface);
    color: var(--color-ink);
    font-size: 0.875rem;
  }
  /* No callout panel here: the caption calls the stages one loop, and
     colouring one read as a selected step. */
  .process-pipe__stop svg {
    color: var(--color-ink-dim);
  }
  .process-pipe__link {
    flex: 1 1 auto;
    min-width: 0.75rem;
    height: 1px;
    background: var(--color-line);
  }
  /* The return: from under Check back to under Research — a bracket drawn in
     the same dash as the stations, with an arrowhead pointing back up. */
  .process-pipe__loop {
    position: absolute;
    left: 3.25rem;
    right: 3.25rem;
    top: calc(100% - 3.5rem);
    height: 1.5rem;
    border: 1px dashed var(--color-line);
    border-top: 0;
    border-radius: 0 0 var(--radius-ui) var(--radius-ui);
  }
  .process-pipe__loop::before {
    content: '';
    position: absolute;
    left: -4px;
    top: -1px;
    border: 4px solid transparent;
    border-bottom: 6px solid var(--color-ink-faint);
    transform: translateY(-100%);
  }
  @media (max-width: 47.9375rem) {
    .process-pipe__row {
      flex-wrap: wrap;
      gap: 0.5rem;
      justify-content: center;
    }
    .process-pipe__link,
    .process-pipe__loop {
      display: none;
    }
  }

  .process-chip {
    padding: 0.25rem 0.625rem;
    border: 1px dashed var(--color-line);
    border-radius: var(--radius-ui);
    color: var(--color-ink-dim);
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  /*
    Ruled principles grid.

    Squares mark where lines meet: the four outer corners of the block, and the
    top and bottom of every internal vertical divider. They are real elements
    rather than pseudo-elements because each needs both a surface fill (to punch
    through the rule it sits on) and a 1px border — a single pseudo-element
    cannot carry two bordered boxes.

    `--sq` is the side length; every placement offsets by half of it so the
    square sits centred on the line rather than beside it.
  */
  .principles,
  .moments {
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .principle,
  .moment-cell {
    position: relative;
  }

  /* The moments grid reuses the principles' rule and square treatment; the
     container query context lets <MomentTribute> scale its type to the cell. */
  .moment-cell {
    container-type: inline-size;
  }

  /* Internal dividers only exist once the grid actually has columns. The
     squares that mark them are hidden with Tailwind on the elements themselves. */
  @media (min-width: 64rem) {
    .principle[data-rule]::before,
    .moment-cell[data-rule]::before {
      content: '';
      position: absolute;
      inset-block: 0;
      left: 0;
      width: 1px;
      background: var(--color-line);
    }
  }

  /*
    Principle icons as medallions — cloudflare.com's product-grid treatment:
    each glyph in a filled disc of the site's blue-to-purple ramp, white line
    work, a thin outer ring held off by a surface gap. It sets this section
    apart from the process diagram's bare line icons, and reads as one family.
  */
  .principle__icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    background: linear-gradient(
      135deg,
      color-mix(in oklab, var(--color-accent) 70%, var(--color-surface)),
      color-mix(in oklab, var(--color-accent-warm) 62%, var(--color-surface))
    );
    box-shadow:
      0 0 0 3px var(--color-surface),
      0 0 0 4px color-mix(in oklab, var(--color-accent) 40%, var(--color-line));
    color: var(--color-ink);
  }

  .principle__icon svg {
    width: 1.3rem;
    height: 1.3rem;
  }

  /*
    The Point of view photo, alive: drifting clouds, a few birds, and a rare
    UFO. All of it sits over the image and under `.signal-photo`'s scanlines
    (z-index 1), so it's on the same tube. All of it goes under reduced
    motion: frozen, a bird reads as a speck on the lens.

    Birds are specks on wandering loops, not drawn birds crossing the frame:
    drawn wings looked fake, and a straight line at a steady speed reads as
    a plane. The UFO is greys only — a blue glow read as a brand element.
  */
  .signal-photo :global(img) {
    position: relative;
    z-index: -1;
  }
  .photo-clouds,
  .photo-birds {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  /* Clouds: a strip twice the frame's width, sliding one frame-width left
     per cycle and wrapping (stitched noise tiles seamlessly), masked to the
     sky so it never crosses the ridge. */
  .photo-clouds {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 14%, transparent 36%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 14%, transparent 36%);
    mix-blend-mode: screen;
    opacity: 0.42;
  }
  .photo-clouds svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 200%;
    height: 40%;
    animation: clouds-drift 90s linear infinite;
    will-change: transform;
  }
  @keyframes clouds-drift {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* Birds: a speck per bird, wandering a loop around (--x, --y). The outer
     span owns the path (`translate` through waypoints, in px so the loop is
     the same size on any frame); the speck owns its shape, fluttering between
     wide-and-flat and narrow-and-tall at a slightly irregular rhythm, which
     at this size reads as wingbeats without drawing wings. */
  .bird {
    position: absolute;
    top: var(--y);
    left: var(--x);
    animation: var(--path) var(--dur) ease-in-out infinite;
    animation-delay: var(--delay);
  }
  .bird--a {
    --path: bird-loop-a;
  }
  .bird--b {
    --path: bird-loop-b;
  }
  .bird--c {
    --path: bird-loop-c;
  }
  .bird__speck {
    display: block;
    width: var(--size);
    height: calc(var(--size) * 0.6);
    border-radius: 9999px;
    background: color-mix(in oklab, var(--color-surface) 85%, transparent);
    filter: blur(0.2px);
    animation: bird-flutter 0.74s steps(1, end) infinite;
    animation-delay: var(--delay);
  }
  @keyframes bird-flutter {
    0% { transform: scale(1.5, 0.6) rotate(-6deg); }
    18% { transform: scale(0.9, 1.25) rotate(4deg); }
    34% { transform: scale(1.4, 0.7); }
    46% { transform: scale(1, 1.15) rotate(-3deg); }
    /* a glide: held flat for most of the second half */
    58%, 100% { transform: scale(1.6, 0.55) rotate(2deg); }
  }
  /* Three loops: a wide circle with a dip, a figure-eight drift, and a
     wander that doubles back. Waypoints in px, relative to the patch. */
  @keyframes bird-loop-a {
    0%, 100% { translate: 0 0; }
    15% { translate: 38px -10px; }
    30% { translate: 62px 4px; }
    45% { translate: 40px 16px; }
    60% { translate: 6px 10px; }
    75% { translate: -22px -4px; }
    88% { translate: -12px -12px; }
  }
  @keyframes bird-loop-b {
    0%, 100% { translate: 0 0; }
    20% { translate: -30px 8px; }
    35% { translate: -52px -6px; }
    50% { translate: -28px -14px; }
    65% { translate: 4px 2px; }
    80% { translate: 30px 10px; }
    90% { translate: 18px -6px; }
  }
  @keyframes bird-loop-c {
    0%, 100% { translate: 0 0; }
    25% { translate: 44px -8px; }
    40% { translate: 70px -2px; }
    55% { translate: 52px 10px; }
    70% { translate: 18px 6px; }
    85% { translate: -10px -10px; }
  }

  /* The UFO: hidden for most of a 75s cycle; slides in from the right over
     the ridge, hovers with a wobble while its lights blink, then zips off up
     and left. First pass ~20s after load. */
  .ufo {
    position: absolute;
    top: 14%;
    left: 0;
    z-index: 0;
    width: 15px;
    opacity: 0;
    pointer-events: none;
    filter: drop-shadow(0 0 2px color-mix(in oklab, var(--color-ink) 35%, transparent));
    /* First visit ~20s after load: the right-hand route starts at 30.7%
       of 225s (69s), so start the clock 49s in. */
    animation: ufo-pass 225s linear infinite;
    animation-delay: -49s;
  }
  .ufo svg {
    display: block;
    width: 100%;
    height: auto;
    animation: ufo-wobble 1.6s ease-in-out infinite;
  }
  .ufo__hull {
    fill: color-mix(in oklab, var(--color-surface) 75%, var(--color-ink));
  }
  .ufo__dome {
    fill: color-mix(in oklab, var(--color-ink-faint) 70%, var(--color-ink));
    opacity: 0.8;
  }
  .ufo__light {
    fill: var(--color-ink);
    animation: ufo-blink 0.9s steps(1, end) infinite;
  }
  .ufo__light:nth-child(4) {
    animation-delay: -0.3s;
  }
  .ufo__light:nth-child(5) {
    animation-delay: -0.6s;
  }
  /* Three routes in one 225s cycle, one visit every ~75s: in from the
     right and off to the upper left; in low from the left and off climbing
     right; down from above and back up the way it came. Between visits it is
     invisible and waits at the next route's start, so no jump ever shows. */
  @keyframes ufo-pass {
    0%, 30.6% { left: 104%; top: 16%; opacity: 0; }
    30.7% { left: 102%; top: 16%; opacity: 1; }
    31.4% { left: 68%; top: 12%; opacity: 1; }
    32.5% { left: 64%; top: 13%; opacity: 1; }
    33.1% { left: -6%; top: 2%; opacity: 1; }
    33.2% { left: -6%; top: 2%; opacity: 0; }

    33.3%, 63.9% { left: -6%; top: 18%; opacity: 0; }
    64% { left: -5%; top: 18%; opacity: 1; }
    64.8% { left: 22%; top: 9%; opacity: 1; }
    65.9% { left: 25%; top: 10%; opacity: 1; }
    66.5% { left: 106%; top: -4%; opacity: 1; }
    66.6% { left: 106%; top: -4%; opacity: 0; }

    66.7%, 97.2% { left: 47%; top: -12%; opacity: 0; }
    97.3% { left: 47%; top: -10%; opacity: 1; }
    98.1% { left: 47%; top: 7%; opacity: 1; }
    99.2% { left: 49%; top: 6%; opacity: 1; }
    99.8% { left: 50%; top: -14%; opacity: 1; }
    99.9%, 100% { left: 50%; top: -14%; opacity: 0; }
  }
  @keyframes ufo-wobble {
    0%, 100% { transform: translateY(0) rotate(-4deg); }
    50% { transform: translateY(-1.5px) rotate(4deg); }
  }
  @keyframes ufo-blink {
    0% { opacity: 1; }
    50% { opacity: 0.2; }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-clouds,
    .photo-birds,
    .ufo {
      display: none;
    }
  }
  :global(html[data-motion='reduced']) .photo-clouds,
  :global(html[data-motion='failed']) .photo-clouds,
  :global(html[data-motion='reduced']) .photo-birds,
  :global(html[data-motion='failed']) .photo-birds,
  :global(html[data-motion='reduced']) .ufo,
  :global(html[data-motion='failed']) .ufo {
    display: none;
  }
