/*
 * Birds over the Point of view photo: far-off specks, not drawn birds. Each
 * wanders a looping path (one of three, `path`) around its own patch of sky —
 * circling, doubling back, rising and dipping — because a speck crossing in a
 * straight line at a steady speed reads as a plane. `x`/`y` are the patch's
 * centre (% of the frame), `dur` the loop in seconds, `delay` negative so
 * they're mid-flight on load. Two share a patch and a path, offset, as a
 * loose pair. No Math.random(): SSG output stays byte-stable.
 */
const birds = [
  { x: 24, y: 11, path: 'a', dur: 23, delay: -4, size: 3.2 },
  { x: 27, y: 12, path: 'a', dur: 23, delay: -6.5, size: 2.6 },
  { x: 71, y: 8, path: 'b', dur: 31, delay: -14, size: 2.8 },
