---
import { getCollection } from 'astro:content';
import TegakiRenderer from 'tegaki/astro';
import signatureBundle from 'tegaki/fonts/caveat';
// The bundle's `fontUrl` is an absolute file:// path baked in for Tegaki's CLI;
// the browser engine loads the font from it and needs a real URL. Import the
// TTF through Vite (relative path sidesteps the package's `exports` map) to get
// a served, hashed asset URL, then repoint the bundle at it before rendering.
import signatureTtf from '../../node_modules/tegaki/dist/fonts/caveat/caveat-3dc76002.ttf?url';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import NoiseGradient from '../components/NoiseGradient.astro';

// Copy the bundle with the served font URL rather than mutating the shared import.
const signatureFont = { ...signatureBundle, fontUrl: signatureTtf };

const featured = (await getCollection('work', ({ data }) => !data.draft && data.featured)).sort(
  (a, b) => a.data.order - b.data.order || b.data.year - a.data.year,
);

/*
 * Hero stats. `20×` is the Tribute growth figure; the second is a suggested
 * placeholder — swap the value/label for a real metric before shipping.
 */
const stats = [
  { value: '20×', label: 'Growth at Tribute' },
  { value: '0→1', label: 'Products shipped' },
];

const capabilities = [
  'Product design',
  'Design systems',
  'Frontend',
  'Prototyping',
  'Research',
  'Motion',
  'Figma',
  'Astro',
  'Svelte',
  'Tailwind',
];

/*
 * Origin story — read one beat at a time as the section scrolls. Draft copy;
 * `set:html` renders the accent spans, so keep these strings authored (not
 * user input). Each string is one on-screen beat.
 */
const story = [
  'It started with <span class="accent-gradient">shampoo bottles</span>.',
  'Late 1980s — first the bath, then the shower.',
  "I'd turn the bottle over. Study the label, the cap, the curve of it. Decide what I'd change.",
  'Then I&rsquo;d pitch my redesign out loud &mdash; to a boardroom of nobody.',
  'I didn&rsquo;t know &ldquo;designer&rdquo; was a job yet.',
  'I just knew I couldn&rsquo;t leave things alone.',
];
---

<BaseLayout
  title="Adam Robertson — Product designer & developer"
  description="Product designer and developer in Colorado. Head of Product Design, building interfaces where the details carry the weight."
>
  {/* Hero -------------------------------------------------------------
      `mt-auto` on the inner wrapper rather than `justify-end` on the section:
      with justify-end, content taller than the container overflows past the
      *top* padding and collides with the fixed nav. mt-auto collapses to 0
      instead, so tall content flows down and short content still sits at the
      bottom of the viewport. */}
  <section class="relative flex min-h-svh flex-col overflow-hidden px-gutter pb-[10vh] pt-32">
    {/* Swap variant="violet" to go back to the brand wash. */}
    <NoiseGradient variant="teal" />
    {/* `my-auto` centres the block in the leftover space. Like mt-auto it
        collapses to 0 when content is taller than the viewport, so it keeps
        the overflow-safety that justify-center would lose. `relative z-10`
        keeps it above the decorative backdrop. */}
    <div class="relative z-10 my-auto" data-anim="hero-fade">
      <h1 class="font-display text-display font-normal text-ink" data-anim="reveal-heading">
        Product Designer With Technical Roots<span class="accent-gradient">.</span>
      </h1>

      {/* Stats left, positioning statement right — the reference splits these
          across the base of the hero rather than stacking them. */}
      <div class="mt-14 grid gap-10 lg:grid-cols-2 lg:gap-16">
        <dl class="flex gap-12 sm:gap-16" data-anim="reveal">
          {
            stats.map((stat) => (
              <div>
                <dd class="font-display text-stat text-ink">{stat.value}</dd>
                <dt class="mt-3 text-micro uppercase tracking-[0.14em] text-ink-faint">
                  {stat.label}
                </dt>
              </div>
            ))
          }
        </dl>

        <p class="max-w-xl text-white/90 lg:justify-self-end" data-anim="reveal">
          I'm a Colorado-based product designer and developer with technical roots and grit. I work
          end to end — research through shipped frontend — turning complex product problems into
          interfaces that hold up under real use.
        </p>
      </div>
    </div>
  </section>

  {/* Origin story -----------------------------------------------------
      A scroll-told narrative. Each line is scrub-linked (see storyLine in
      effects.ts): it fades and rises in as it enters, holds full through the
      centre, then dims — so the eye follows one beat at a time. The hero above
      fades out on scroll to hand off the viewport. */}
  <section class="px-gutter pb-[22vh] pt-[8vh]" aria-label="How I found design">
    <div class="mx-auto flex max-w-2xl flex-col items-center gap-[24vh] text-center">
      {
        story.map((line) => (
          <p
            class="text-balance text-[clamp(1.5rem,3.2vw,2.6rem)] leading-[1.3] text-ink"
            data-anim="story-line"
            set:html={line}
          />
        ))
      }

      {/* Signature — Tegaki draws it stroke by stroke (real glyph skeletons),
          triggered on scroll-in by the `signature` effect. The canvas is
          decorative (aria-hidden); the sr-only name and noscript fallback carry
          it for assistive tech and no-JS. */}
      {/* Slight negative margin trims the 24vh flex gap inherited from the
          story column, without crowding the last line. */}
      <div class="-mt-[4vh]">
        {/* Controlled at 0 so it renders blank and never runs a playback loop
            at rest (uncontrolled autoplay races the async font load and
            fast-forwards to the end). The `signature` effect switches it to
            uncontrolled and restarts it on scroll-in. */}
        <TegakiRenderer
          text="Adam Robertson"
          font={signatureFont}
          time="0%"
          class="signature-canvas"
          aria-hidden="true"
        />
        <span class="sr-only">Adam Robertson</span>
        <noscript>
          <span class="font-display text-title text-ink">Adam Robertson</span>
        </noscript>
      </div>
    </div>
  </section>

  {/* Marquee ---------------------------------------------------------- */}
  <section class="overflow-hidden border-y border-line py-6" data-anim="marquee" data-speed="34">
    <div class="marquee-track">
      {/* Duplicated so the -50% translate lands on an identical frame. */}
      {
        [0, 1].map((copy) => (
          <ul class="flex shrink-0" aria-hidden={copy === 1 ? 'true' : undefined}>
            {capabilities.map((c) => (
              <li class="flex items-center whitespace-nowrap px-8 text-micro uppercase tracking-[0.14em] text-ink-dim">
                <span class="mr-8 text-accent" aria-hidden="true">
                  ✳
                </span>
                {c}
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </section>

  {/* Featured work ---------------------------------------------------- */}
  <section class="px-gutter py-section">
    <div class="mb-16 flex items-end justify-between gap-6">
      <h2 class="font-display text-title font-normal text-ink" data-anim="reveal-heading">Selected work</h2>
      <a
        href="/work"
        class="shrink-0 text-micro uppercase tracking-[0.14em] text-ink-dim transition-colors hover:text-accent"
      >
        All projects →
      </a>
    </div>

    <div class="grid gap-x-10 gap-y-20 lg:grid-cols-2" data-anim="reveal-batch">
      {featured.map((entry, i) => <WorkCard entry={entry} index={i} />)}
    </div>
  </section>

  {/* Contact ---------------------------------------------------------- */}
  <section class="px-gutter py-section text-center">
    <h2 class="font-display text-display font-normal text-ink" data-anim="reveal-heading">
      Let's make <span class="text-accent">something</span>.
    </h2>

    <div class="mt-16 inline-block" data-anim="magnetic" data-strength="0.4">
      <a
        href="mailto:hi@adam.build"
        class="inline-flex items-center gap-3 rounded-full border border-line px-9 py-4 text-micro uppercase tracking-[0.14em] text-ink transition-colors hover:border-accent hover:text-accent"
      >
        hi@adam.build
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>
