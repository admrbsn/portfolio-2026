---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import TegakiRenderer from 'tegaki/astro';
import { createBundle } from 'tegaki/core';
import type { TegakiGlyphData } from 'tegaki';
// Custom signature font: a Reenie Beanie bundle generated with tegaki-generator
// (skeletons + stroke order from the Google Font). We ship only the subset TTF
// (the letters in "Adam Robertson") plus the glyph skeleton JSON. Tegaki draws
// the strokes from glyphData and paints the letterforms with the font itself,
// so the TTF has to resolve to a real served URL — hence the Vite `?url` import.
import signatureGlyphData from '../assets/fonts/reenie-beanie/glyphData.json';
import signatureTtf from '../assets/fonts/reenie-beanie/reenie-beanie.ttf?url';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkRow from '../components/WorkRow.astro';
import WorkbenchCta from '../components/WorkbenchCta.astro';
import NoiseGradient from '../components/NoiseGradient.astro';
import Leadership from '../components/Leadership.astro';
import Experience from '../components/Experience.astro';
import Dribbble from '../components/Dribbble.astro';
import RuleCross from '../components/RuleCross.astro';

// Metrics come straight from the generated bundle.ts. createBundle assembles the
// runtime bundle from these parts, which is the supported path when the prebuilt
// font module isn't shipped in the package.
const signatureFont = createBundle({
  family: 'Reenie Beanie Tegaki ff4a336b',
  fullFamily: 'Reenie Beanie',
  fontUrl: signatureTtf,
  fullFontUrl: signatureTtf,
  glyphData: signatureGlyphData as unknown as Record<string, TegakiGlyphData>,
  lineCap: 'round',
  unitsPerEm: 1000,
  ascender: 750,
  descender: -250,
});

// All published case studies, laid out as a ruled text index on the home page
// (no separate work index). Sorted by manual order, ties break on year.
const work = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order || b.data.year - a.data.year,
);

/*
 * Covers for the hover preview, keyed by entry id. Only rows that link
 * somewhere get one; the coming-soon entry has nothing to preview.
 */
const previews = work.filter((e) => e.data.cover && e.data.coverAlt && !e.data.comingSoon);

/*
 * Hero stats. `20×` is the Tribute growth figure; the second is a suggested
 * placeholder — swap the figures/labels for a real metric before shipping.
 * `op` picks the inline icon (× or →); `opWord` is its screen-reader spoken form.
 */
const stats = [
  { num: '20', op: 'times', opWord: 'times', tail: '', label: 'Growth at Tribute' },
  { num: '0', op: 'arrow', opWord: 'to', tail: '1', label: 'Products shipped' },
];

// Résumé skill set, grouped into a scannable capabilities index (one column
// per cluster) — the breadth without the fast-moving ticker.
const capabilities = [
  {
    name: 'Design',
    items: [
      'Product strategy',
      'Design systems',
      'Design tokens',
      'Design sprints',
      'Rapid prototyping',
      'Accessibility',
      'iOS & responsive',
      'Figma',
      'Framer',
      'Webflow',
      'Design mentorship',
    ],
  },
  {
    name: 'Engineering',
    items: [
      'Frontend architecture',
      'TypeScript',
      'JavaScript',
      'React',
      'Vue',
      'Tailwind',
      'HTML',
      'CSS / SCSS',
      'Git',
      'REST APIs',
      'Performance optimization',
    ],
  },
  {
    name: 'Research & growth',
    items: [
      'UX research',
      'Qualitative research',
      'Usability testing',
      'A/B testing',
      'Conversion optimization',
      'Growth design',
      'User journey mapping',
      'JTBD',
      'User activation & retention',
      'Lean UX',
      'PostHog',
      'GA4',
    ],
  },
  {
    name: 'AI & leadership',
    items: [
      'AI-native workflows',
      'LLM-powered design',
      'Claude Code',
      'Cursor',
      'Cross-functional leadership',
      'Roadmap planning',
      'Agile / Scrum',
      'Early-stage startups',
    ],
  },
];

/*
 * Origin story — read one beat at a time as the section scrolls. Draft copy;
 * `set:html` renders the accent spans, so keep these strings authored (not
 * user input). Each string is one on-screen beat.
 */
const story = [
  'It started with <span class="accent-gradient" data-anim="jiggle">shampoo bottles.</span>',
  'Late 1980s. First the bath, then the shower.',
  "I'd turn the bottle over. Study the label, the cap, the curve of it. Decide what I'd change.",
  'Then I&rsquo;d pitch my redesign out loud &mdash; to a boardroom of nobody.',
  'I didn&rsquo;t know &ldquo;designer&rdquo; was a job yet.',
  'I just knew I couldn&rsquo;t leave things alone.',
];
---

<BaseLayout
  title="Adam Robertson · Product designer & developer"
  description="Product designer and developer in Colorado. Head of Product Design, building interfaces where the details carry the weight."
>
  {/* Blueprint frame: faint vertical rails at the gutter + border-t between
      sections segment the page into a subtle grid. */}
  <div class="page-rails home-signal">
  {/* Hero -------------------------------------------------------------
      `mt-auto` on the inner wrapper rather than `justify-end` on the section:
      with justify-end, content taller than the container overflows past the
      *top* padding and collides with the fixed nav. mt-auto collapses to 0
      instead, so tall content flows down and short content still sits at the
      bottom of the viewport. */}
  {/* The height is `100svh` *minus the nav*, not `100svh`: the bar is fixed and
      overlays the top of this section, so a full-viewport hero puts the rule at
      its foot exactly on the fold, where it takes a scroll to reveal. Subtracting
      the nav band makes the two together fill one viewport and lands that rule on
      screen. `--nav-h` is measured and published by `nav.ts`; the fallback is the
      bar's height at rest, for the pre-JS frame and reduced-motion visits. */}
  {/* Padding is a clamp of `vh` both ends, and the ceiling is 50rem (was 42 with
      `pt-32 pb-[8vh]`): with the bolder Syne hero the block read as crammed
      between the nav and the next rule. The type is the same height; the air
      around it is what changed.

      The ceiling on top of that is what stops the hero *growing* with the
      display. Height came from the viewport alone, so on a 16:10 desktop the
      block sat in ~830px with the type occupying 300 of it and `my-auto`
      distributing the rest as two bands of empty wash — the hero read as
      under-filled at exactly the sizes it was meant to look best at. Capped, the
      composition holds its proportions and the next section's rule breaks the
      fold, which is also the more honest signal that the page continues. */}
  <section
    class="relative flex min-h-[min(50rem,calc(100svh-var(--nav-h,4.3125rem)))] flex-col overflow-hidden px-shell pb-[clamp(5rem,14vh,9rem)] pt-[clamp(9rem,22vh,13rem)]"
    data-blueprint="The Hook"
    style="--bp-top: calc(var(--nav-h, 4.3125rem) + 0.85rem)"
  >
    {/* No `variant`: this takes the site-wide default (`sunset`), which is what
        `--color-accent` is tuned against. Pass one only to trial a palette. */}
    <NoiseGradient />
    {/* The tube the hero is shown on — scanlines over the wash, two roll bands
        and a faint flicker. Between the wash and the content, so no line ever
        crosses the headline. See `.hero-crt` in the style block. */}
    <div class="hero-crt" aria-hidden="true"></div>
    {/* `my-auto` centres the block in the leftover space. Like mt-auto it
        collapses to 0 when content is taller than the viewport, so it keeps
        the overflow-safety that justify-center would lose. `relative z-10`
        keeps it above the decorative backdrop. */}
    <div class="relative z-10 my-auto" data-anim="hero-fade">
      {/* No eyebrow above the h1. There was one — a selection chip reading
          "Still redesigning the shampoo bottle", set up as a hook that paid off
          two screens down when the Story section opens "It started with shampoo
          bottles." It was cut, and the callback still works without it: the
          Story line lands on its own rather than repeating a promise the hero
          already made. If anything goes back here it has to earn the h1 losing
          the first mark on the page, and it must not be a restatement of the
          headline or a list of categories — which is what the draft before the
          chip ("Colorado · Design & frontend") was. */}
      {/* Bolder than the 600 every other heading takes. Syne widens as it gets
          heavier, so this is the one place the extended cut is allowed — the
          hero is a statement, and the width is part of it. */}
      <div class="relative">
      <h1 class="font-display text-display font-bold text-ink" data-anim="reveal-heading">
        Product Design Leader With <span class="outage outage--a" data-text="Technical"><span class="outage__tear" data-text="Technical">Technical</span></span>
        <span class="outage outage--b" data-text="Roots"><span class="outage__tear" data-text="Roots">Roots</span></span>
      </h1>
      {/* Signal debris for the glitch bursts — decoration only, outside the h1
          so SplitText never sees it. Generated; see the style block. */}
      <div class="debris-field" aria-hidden="true">
        <span class="debris debris--a1">
          <i style="left:33%;top:75%;width:46px;height:3px;background:var(--color-surface)"></i>
          <i style="left:56%;top:78%;width:41px;height:3px;background:var(--color-accent)"></i>
          <i style="left:32%;top:96%;width:19px;height:2px;background:var(--color-surface)"></i>
          <i style="left:56%;top:98%;width:39px;height:3px;background:var(--color-accent)"></i>
          <i style="left:22%;top:104%;width:30px;height:3px;background:var(--color-surface)"></i>
          <i style="left:56%;top:49%;width:45px;height:3px;background:var(--color-accent)"></i>
          <i style="left:18%;top:68%;width:28px;height:3px;background:var(--color-ink)"></i>
          <i style="left:47%;top:99%;width:19px;height:3px;background:var(--color-accent)"></i>
          <i style="left:33%;top:64%;width:28px;height:3px;background:var(--color-ink)"></i>
          <i style="left:10%;top:84%;width:54%;height:2px;background:var(--color-ink)"></i>
        </span>
        <span class="debris debris--a2">
          <i style="left:39%;top:72%;width:12px;height:3px;background:var(--color-ink)"></i>
          <i style="left:46%;top:96%;width:44px;height:3px;background:var(--color-accent-warm)"></i>
          <i style="left:58%;top:102%;width:33px;height:2px;background:var(--color-ink)"></i>
          <i style="left:46%;top:56%;width:40px;height:3px;background:var(--color-ink)"></i>
          <i style="left:30%;top:89%;width:24px;height:2px;background:var(--color-ink)"></i>
          <i style="left:26%;top:92%;width:18px;height:3px;background:var(--color-surface)"></i>
          <i style="left:21%;top:99%;width:21px;height:3px;background:var(--color-accent-warm)"></i>
          <i style="left:50%;top:91%;width:36px;height:3px;background:var(--color-accent)"></i>
          <i style="left:53%;top:97%;width:12px;height:2px;background:var(--color-accent-warm)"></i>
        </span>
        <span class="debris debris--b1">
          <i style="left:71%;top:84%;width:7px;height:3px;background:var(--color-accent)"></i>
          <i style="left:71%;top:55%;width:45px;height:2px;background:var(--color-ink)"></i>
          <i style="left:81%;top:49%;width:37px;height:3px;background:var(--color-surface)"></i>
          <i style="left:61%;top:89%;width:31px;height:2px;background:var(--color-surface)"></i>
          <i style="left:78%;top:70%;width:38px;height:2px;background:var(--color-surface)"></i>
          <i style="left:69%;top:57%;width:24px;height:2px;background:var(--color-accent-warm)"></i>
          <i style="left:67%;top:77%;width:10px;height:2px;background:var(--color-ink)"></i>
          <i style="left:69%;top:92%;width:13px;height:3px;background:var(--color-accent)"></i>
          <i style="left:61%;top:57%;width:30px;height:3px;background:var(--color-accent-warm)"></i>
          <i style="left:54%;top:72%;width:42%;height:2px;background:var(--color-ink)"></i>
        </span>
        <span class="debris debris--b2">
          <i style="left:64%;top:47%;width:44px;height:3px;background:var(--color-accent)"></i>
          <i style="left:75%;top:83%;width:11px;height:3px;background:var(--color-ink)"></i>
          <i style="left:76%;top:46%;width:15px;height:2px;background:var(--color-accent-warm)"></i>
          <i style="left:58%;top:75%;width:34px;height:2px;background:var(--color-ink)"></i>
          <i style="left:80%;top:71%;width:14px;height:2px;background:var(--color-accent-warm)"></i>
          <i style="left:79%;top:89%;width:24px;height:2px;background:var(--color-surface)"></i>
          <i style="left:82%;top:55%;width:18px;height:2px;background:var(--color-ink)"></i>
          <i style="left:74%;top:53%;width:39px;height:2px;background:var(--color-ink)"></i>
          <i style="left:59%;top:50%;width:35px;height:3px;background:var(--color-ink)"></i>
        </span>
      </div>
      </div>

      {/* Stats left, positioning statement right — the reference splits these
          across the base of the hero rather than stacking them. */}
      <div class="mt-12 grid gap-10 lg:grid-cols-2 lg:gap-16">
        <dl class="flex gap-12 sm:gap-16" data-anim="reveal">
          {
            stats.map((stat) => (
              <div>
                {/* Icons sit on the baseline, not the line box's centre. Syne's
                    numerals are short — 0.51em, closer to an x-height than a cap
                    height — while its line box is sized for caps and descenders,
                    so `items-center` lands the icon visibly above the digits.
                    Baseline-aligned, an SVG's bottom edge sits on the baseline,
                    and each nudge below drops its centre to 0.255em: half the
                    digit height, so the icon is centred on the numerals at any
                    size. Re-measure if the display face changes. */}
                <dd class="flex items-baseline font-display text-stat text-ink">
                  {stat.num}
                  {stat.op === 'times' ? (
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      aria-hidden="true"
                      class="mx-[0.04em] h-[0.56em] w-[0.56em] translate-y-[0.025em]"
                    >
                      <path
                        d="M18 6L6 18M6 6L18 18"
                        stroke="currentColor"
                        stroke-width="2.75"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  ) : (
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      aria-hidden="true"
                      class="mx-[0.1em] h-[0.62em] w-[0.62em] translate-y-[0.055em]"
                    >
                      <path
                        d="M4 12H20M20 12L14 6M20 12L14 18"
                        stroke="currentColor"
                        stroke-width="2.75"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  )}
                  <span class="sr-only">{stat.opWord}</span>
                  {stat.tail && <span>{stat.tail}</span>}
                </dd>
                <dt class="mt-3 text-micro uppercase tracking-[0.14em] text-ink-faint">
                  {stat.label}
                </dt>
              </div>
            ))
          }
        </dl>

        <p
          class="max-w-xl text-[clamp(1.0625rem,1.35vw,1.3rem)] leading-[1.55] text-ink-lead lg:justify-self-end"
          data-anim="reveal"
        >
          I'm a Colorado-based product designer and developer with technical roots and grit. I work
          end to end, from research through shipped frontend, turning complex product problems into
          interfaces that hold up under real use.
        </p>
      </div>
    </div>
  </section>

  {/* Origin story -----------------------------------------------------
      A scroll-told narrative. Each line is scrub-linked (see storyLine in
      effects.ts): it fades and rises in as it enters, holds full through the
      centre, then dims — so the eye follows one beat at a time. The hero above
      fades out on scroll to hand off the viewport. */}
  <section
    class="relative border-t border-line px-shell pb-[22vh] pt-[20vh]"
    aria-label="How I found design"
    data-blueprint="Story Quest"
  >
    <RuleCross />
    <div class="mx-auto flex max-w-2xl flex-col items-center gap-[24vh] text-center">
      {
        story.map((line) => (
          <p
            class="text-balance text-[clamp(1.5rem,3.2vw,2.6rem)] leading-[1.3] text-ink"
            data-anim="story-line"
            set:html={line}
          />
        ))
      }

      {/* Signature — Tegaki draws it stroke by stroke (real glyph skeletons),
          triggered on scroll-in by the `signature` effect. The canvas is
          decorative (aria-hidden); the sr-only name and noscript fallback carry
          it for assistive tech and no-JS. */}
      {/* Slight negative margin trims the 24vh flex gap inherited from the
          story column, without crowding the last line. */}
      <div class="-mt-[4vh]">
        {/* Controlled at 0 so it renders blank and never runs a playback loop
            at rest (uncontrolled autoplay races the async font load and
            fast-forwards to the end). The `signature` effect switches it to
            uncontrolled and restarts it on scroll-in. */}
        <TegakiRenderer
          text="Adam Robertson"
          font={signatureFont}
          time="0%"
          class="signature-canvas"
          aria-hidden="true"
        />
        <span class="sr-only">Adam Robertson</span>
        <noscript>
          <span class="font-display text-title text-ink">Adam Robertson</span>
        </noscript>
      </div>
    </div>
  </section>

  {/* Capabilities ----------------------------------------------------- */}
  <section
    class="relative border-t border-line px-shell pt-section pb-section lg:pb-0"
    aria-labelledby="capabilities"
    data-blueprint="My toolbelt"
  >
    <RuleCross />
    <h2
      id="capabilities"
      class="signal font-display text-title text-ink"
      data-anim="reveal-heading"
      data-text="Capabilities"
      style="--signal-dur: 11.3s; --signal-delay: 3s"
    >
      Capabilities
    </h2>
    <p class="mt-6 max-w-xl text-ink-dim" data-anim="reveal">
      The full range I bring across a product, from first research to the frontend that ships it.
    </p>

    {/* The grid pulls back out to the page rails (-mx-shell-pad) and carries the
        lines: a top rule rail-to-rail, per-column border-l dividers, and (at lg)
        pb-section so those dividers run all the way down to the next section's
        rule — one connected grid. Text stays padded (px-shell-pad) off the lines. */}
    <div
      class="bp-rules -mx-shell-pad mt-16 grid grid-cols-1 gap-y-12 border-t border-line sm:grid-cols-2 lg:grid-cols-4 lg:gap-y-0"
      data-anim="reveal-batch"
    >
      {
        capabilities.map((group, i) => (
          <div
            class:list={[
              'relative px-shell-pad pt-6 lg:pb-section',
              i % 2 === 1 && 'sm:border-l sm:border-line',
              i === 2 && 'lg:border-l lg:border-line',
            ]}
          >
            {/* Both ends of this column's divider. Only the three internal
                dividers get them — the outer two positions are the block's own
                corners, below. */}
            {i > 0 && (
              <>
                <span class="bp-sq bp-sq--t bp-sq--l hidden lg:block" aria-hidden="true" />
                <span class="bp-sq bp-sq--b bp-sq--l hidden lg:block" aria-hidden="true" />
              </>
            )}
            <h3 class="text-micro uppercase tracking-[0.14em] text-ink-faint">{group.name}</h3>
            <ul class="mt-5 space-y-2.5 text-ink">
              {group.items.map((item) => (
                <li>
                  <span class="cap-item">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      {/* The block's own four corners, where its rules meet the page rails.
          The bottom pair land on the next section's rule, which is what the
          columns' `lg:pb-section` runs them down to. */}
      <span class="bp-sq bp-sq--t bp-sq--l" aria-hidden="true" />
      <span class="bp-sq bp-sq--t bp-sq--r" aria-hidden="true" />
      <span class="bp-sq bp-sq--b bp-sq--l hidden lg:block" aria-hidden="true" />
      <span class="bp-sq bp-sq--b bp-sq--r hidden lg:block" aria-hidden="true" />
    </div>
  </section>

  {/* Selected work ---------------------------------------------------- */}
  <section
    id="work"
    class="relative scroll-mt-28 border-t border-line px-shell py-section"
    data-blueprint="Greatest Hits"
  >
    <RuleCross />
    <h2
      class="signal font-display text-title text-ink"
      data-anim="reveal-heading"
      data-text="Selected work"
      style="--signal-dur: 13.7s; --signal-delay: 5.5s"
    >
      Selected work
    </h2>

    {/*
      A ruled index rather than a grid of covers. The covers still exist, as a
      single frame that follows the pointer over the list (`work-preview`), so
      the imagery is there on intent and costs no vertical space otherwise.

      The frame is a sibling of the <ol>, not inside it: `reveal-batch` fades
      every child of the list, and the frame must stay at opacity 0 until hover.
    */}
    <div class="relative mt-14 md:mt-16" data-anim="work-preview">
      <ol class="-mx-shell-pad list-none" data-anim="reveal-batch">
        {work.map((entry, i) => <WorkRow entry={entry} index={i + 1} last={i === work.length - 1} />)}
      </ol>

      <div
        class="work-preview pointer-events-none absolute left-0 top-0 z-20 hidden aspect-[16/10] w-[clamp(16rem,24vw,22rem)] overflow-hidden rounded-ui bg-surface-lift opacity-0 lg:block"
        data-preview
        aria-hidden="true"
      >
        {
          previews.map((entry) => (
            <Image
              src={entry.data.cover!}
              alt=""
              widths={[400, 720]}
              sizes="22rem"
              class="absolute inset-0 h-full w-full object-cover opacity-0"
              data-preview-img={entry.id}
              loading="lazy"
            />
          ))
        }
      </div>
    </div>
  </section>

  {/* How I work now — a pointer to /how-i-work ---------------------------- */}
  <WorkbenchCta />

  {/* Leadership ------------------------------------------------------- */}
  <div class="relative border-t border-line">
    <RuleCross />
    <Leadership />
  </div>

  {/* Experience / résumé ---------------------------------------------- */}
  <div class="relative border-t border-line">
    <RuleCross />
    <Experience />
  </div>

  {/* Dribbble grid ---------------------------------------------------- */}
  <div class="relative border-t border-line">
    <RuleCross />
    <Dribbble />
  </div>
  </div>
</BaseLayout>

<style>
  /*
    Blueprint captions ("GREATEST HITS" and the rest) as weak indicator lamps:
    sitting at their usual 0.2, then once a cycle a stepped dip and a brief
    over-bright pop — a bulb on a failing supply. Homepage only (the
    `.home-signal` wrapper), and each label on its own duration so no two
    stutter together; negative delays put them mid-cycle on load, so the page
    does not arrive and then start misbehaving.
  */
  :global(.home-signal [data-blueprint])::before {
    animation: lamp 12.3s steps(1, end) infinite;
  }
  :global(.home-signal [data-blueprint='The Hook'])::before { animation-duration: 9.7s; animation-delay: -2s; }
  :global(.home-signal [data-blueprint='Story Quest'])::before { animation-duration: 12.3s; animation-delay: -7s; }
  :global(.home-signal [data-blueprint='My toolbelt'])::before { animation-duration: 10.9s; animation-delay: -4s; }
  :global(.home-signal [data-blueprint='Greatest Hits'])::before { animation-duration: 14.1s; animation-delay: -9s; }
  :global(.home-signal [data-blueprint='About Me'])::before { animation-duration: 11.7s; animation-delay: -1s; }
  :global(.home-signal [data-blueprint='War Stories'])::before { animation-duration: 16.3s; animation-delay: -12s; }
  :global(.home-signal [data-blueprint='The Sketchbook'])::before { animation-duration: 13.3s; animation-delay: -5s; }
  :global(.home-signal [data-blueprint='The Workbench'])::before { animation-duration: 15.7s; animation-delay: -3s; }
  @keyframes lamp {
    0%, 88% { opacity: 0.2; }
    88.4% { opacity: 0.06; }
    88.9% { opacity: 0.2; }
    89.3% { opacity: 0.04; }
    90.1% { opacity: 0.45; }
