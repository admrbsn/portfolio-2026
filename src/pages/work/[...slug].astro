---
import { getImage, Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths, ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Figure from '../../components/mdx/Figure.astro';
import PullQuote from '../../components/mdx/PullQuote.astro';
import Stat from '../../components/mdx/Stat.astro';
import Device from '../../components/mdx/Device.astro';
import Gallery from '../../components/mdx/Gallery.astro';
import NoiseGradient from '../../components/NoiseGradient.astro';
import RuleCross from '../../components/RuleCross.astro';

/*
  Process-gallery images are found by convention rather than listed in
  frontmatter: `src/assets/work/<slug>/…-gallery-<n>.webp`. Eager is safe here
  because this only resolves ImageMetadata at build time — the images
  themselves are still emitted per-page by the asset pipeline.
*/
const galleryModules = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/work/*/*-gallery-*.webp',
  { eager: true },
);

export const getStaticPaths = (async () => {
  const projects = (await getCollection('work', ({ data }) => !data.draft && !data.comingSoon)).sort(
    (a, b) => a.data.order - b.data.order || b.data.year - a.data.year,
  );

  return projects.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      // Precomputed so the footer doesn't have to re-query the collection.
      next: projects[(i + 1) % projects.length],
    },
  }));
}) satisfies GetStaticPaths;

const { entry, next } = Astro.props;
const {
  title,
  client,
  year,
  cover,
  role,
  summary,
  scope,
  team,
  timeline,
  impact,
  metrics,
  liveSiteUrl,
  liveSiteText,
} = entry.data;

const { Content } = await render(entry);

/*
  The social card for a case study is its own cover, cropped to the 1.91:1 box
  every unfurl uses — so a shared link shows the work rather than the generic
  brand card. Derived from the same `cover` the work tile uses, which means it
  can never go stale against the entry: change the cover, the card follows.

  The alternative was a rendered card per study (cover plus the title, like
  `/og-card`), which looks better but has to be regenerated by hand every time a
  title is edited. Automatic and current beats prettier and stale.
*/
const ogCard = cover
  ? await getImage({ src: cover, width: 1200, height: 630, fit: 'cover', format: 'jpeg', quality: 86 })
  : undefined;

/*
  Sort numerically, not lexically — a plain sort puts gallery-10 between
  gallery-1 and gallery-2, which silently reorders the whole set.
*/
const galleryIndex = (path: string) => Number(path.match(/-gallery-(\d+)\.webp$/)?.[1] ?? 0);

const gallery = Object.entries(galleryModules)
  .filter(([path]) => path.includes(`/assets/work/${entry.id}/`))
  .sort(([a], [b]) => galleryIndex(a) - galleryIndex(b))
  .map(([, mod]) => mod.default);

/*
  Impact labels are mostly claims with a figure in them ("Starts up 29%",
  "Onboarding conversion ~25% → 54%"), and the figure is the part that earns the
  section. Split it out so it can carry the accent ramp inline, rather than
  setting the whole line in colour or pulling the number out into a stat block —
  not every impact has one ("Figma stopped being the source of truth"), and a
  layout that demands a number would force the qualitative ones to fake it.
*/
const FIGURE = /(~?\$?\d[\d.,]*\s?[%KkMm]?\+?)/g;

const impactItems = impact.map((item, i) => {
  const parts = item.label
    .split(FIGURE)
    .filter(Boolean)
    .map((text) => ({ text, figure: FIGURE.test(text) && /\d/.test(text) }));

  return {
    ...item,
    index: String(i + 1).padStart(2, '0'),
    parts,
    /* Where the accent lands. A line with a figure puts it on the figure; a
       qualitative one has nowhere to put it, so its index takes the colour and
       every item still gets exactly one accent moment. */
    accentIndex: !parts.some((part) => part.figure),
  };
});

const glance = [
  { label: 'Role', value: role.join(', ') },
  { label: 'Scope', value: scope },
  { label: 'Team', value: team },
  { label: 'Timeline', value: timeline },
].filter((item): item is { label: string; value: string } => Boolean(item.value));

---

<BaseLayout
  title={`${title} · Adam Robertson`}
  description={summary}
  ogImage={ogCard?.src}
>
  {/*
    Back link. Hidden while the hero is on screen — up there the nav is right
    above it and the page title is unmissable — then it fades in for the rest of
    the read, which is long enough that "how do I get out of here" is a real
    question. Sits just under the fixed nav rather than inside it: the nav is
    `transition:persist` and shared by every page, so a case-study-only control
    does not belong in it.
  */}
  <a
    href="/#work"
    class="case-back"
    data-case-back
    data-cursor="grow"
  >
    <span aria-hidden="true">←</span>
    All work
  </a>

  {/*
    The blueprint rails, matching the homepage and /about. Case studies used to
    sit outside the frame on the grounds that a drafting frame around 2,000
    words is decoration — but the rails alone are not the frame, and without
    them the hero's copy sat on the gutter line rather than inside it, a full
    `--spacing-shell-pad` left of the nav's own wordmark.

    So: rails here, and every section moved from `px-gutter` (which puts content
    *on* the rail) to `px-shell` (gutter + shell-pad, which is what the nav
    uses). The section labels and dead-space hatch stay off these pages.
  */}
  <article class="page-rails">
    {/*
      Text-first hero. The `cover` is here as *texture*, not as an image: the
      work tile's own art, desaturated, blended into the wash and masked into
      the top-right corner — the slot the skills list used to fill.

      This is not the cover treatment that was cut twice before. Those put the
      screenshot between the reader and the first paragraph, at full width and
      full contrast. At `luminosity` the hue comes from the wash underneath and
      only the image's light and shade survive, so it reads as a watermark of
      the thing the study is about rather than as a picture of it.

      `aria-hidden`: the same art carries a real `alt` on the work index, and a
      watermark is not content.
    */}
    <section
      class="relative overflow-hidden px-shell pb-12 pt-48 md:pt-56"
      data-case-hero
      data-blueprint="Cover Story"
      style="--bp-top: calc(var(--nav-h, 4.3125rem) + 0.85rem)"
    >
      {/*
        The same component the homepage and /about use, at `soft` — not a
        hand-rolled copy of it. The copy drifted: it was two radials of
        `--color-accent` and `--color-accent-warm`, the *brand* accents, where
        the homepage wash is built from its own highlight blob, body blob and
        base tint. Same family on paper, visibly
        different in the frame.

        `soft` is what keeps them from being identical: same palette, smaller
        blobs held to the corner, so a case study reads as the quieter room.
      */}
      <NoiseGradient intensity="soft" />

      {
        cover && (
          <div class="hero-cover" aria-hidden="true">
            <Image src={cover} alt="" widths={[720, 1200]} sizes="60vw" loading="eager" />
          </div>
        )
      }

      <div class="relative z-10">
        <p class="text-micro uppercase tracking-[0.14em] text-ink-faint" data-anim="reveal">
          {client} · {year}
        </p>

        {/* No trailing accent dot here. It is the wordmark's device and reads
            as punctuation on a sentence-like title; after "Tribute.co" it also
            stutters into a second full stop. */}
        {/*
          Its own scale, not `--text-display`. That token is the homepage hero's
          (up to 8.25rem) and it pushed these 32–42 character titles onto three
          lines. Sized so the longest of them ("Launching a new product on three
          platforms") breaks at two, with `text-balance` splitting them evenly
          rather than leaving an orphan.

          Stepped down from 5rem: a case study is a reading page and the title
          is a claim, not a cover. At the old size it filled most of the first
          screen before the reader reached a single word of the argument.
        */}
        <h1
          class="mt-5 max-w-5xl font-display text-[clamp(2.125rem,4.4vw,3.75rem)] font-normal leading-[1.05] tracking-[-0.02em] text-balance text-ink"
          data-anim="reveal-heading"
        >
          {title}
        </h1>

        {/* White-with-alpha rather than `--color-ink-dim`. That token sits at
            hue 280 with a little chroma — invisible at body size, but at
            `--text-lead` it reads as a faint violet cast. Matches how the
            homepage hero handles its own lead. */}
        <p class="mt-7 max-w-3xl text-lead text-ink-lead" data-anim="reveal">{summary}</p>
      </div>
    </section>

    {/* At a glance -----------------------------------------------------

        `border-t` only. The bottom rule used to close this grid off, but the
        Impact band opens with a rule of its own a few lines below it, and two
        horizontals that close together read as a boxed-in strip rather than as
        two stacked bands. The Impact rule is the one doing the work — it has
        columns crossing it. */}
    <section class="relative border-t border-line px-shell py-14" data-blueprint="The Brief">
      <RuleCross />
      <dl
        class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4"
        data-anim="reveal-batch"
      >
        {
          glance.map((item) => (
            <div>
              <dt class="text-micro uppercase tracking-[0.14em] text-ink-faint">
                {item.label}
              </dt>
              <dd class="mt-2 text-ink">{item.value}</dd>
            </div>
          ))
        }
      </dl>

    </section>

    {/*
      Impact — deliberately above the body rather than below it.

      Every portfolio worth benchmarking against (Chiu, Sanvithi, Rachel Chen,
      Prinz) states outcomes within the first screen or two. The metrics band at
      the foot of this page sits behind 1,500–2,800 words, which most readers
      will never reach. This is the same answer, delivered before the argument
      rather than after it.

      Lifted surface rather than another bordered grid: the at-a-glance sits
      directly above and the metrics band below, and three plain grids in a row
      read as one undifferentiated table.

      Full-bleed to the gutter rails, matching the at-a-glance grid it sits
      directly beneath — a narrower centred block reads as a different column
      system stacked on the first.
    */}
    {
      impactItems.length > 0 && (
        /*
          Impact as a scroll-told sequence, borrowing the homepage's Story Quest
          treatment: each result is a beat that rises and lights as it enters,
          holds through the centre, then dims as the next one takes over.

          Why it suits this better than a grid did: three results laid out as
          columns are read as a table and skimmed as one — the reader takes an
          impression, not the numbers. One beat at a time makes each result land
          on its own, and the figures are what the eye lands on.

          The trade is scroll: this costs roughly one and a half screens where
          the grid cost a third of one. It buys that back by being the thing
          people actually read, and the body still opens before the second
          screen of prose.

          `story-line` is the same registered effect the homepage uses, so it
          inherits the pre-hide CSS and the reduced-motion escape hatch. The
          beats sit far enough down the page (below the hero and the at-a-glance
          grid) that the first one is always entered by scrolling rather than
          already mid-scrub at load.
        */
        <section class="px-shell pb-[14vh] pt-[8vh]">
          <h2 class="text-center text-micro uppercase tracking-[0.14em] text-ink-faint">Impact</h2>

          <div class="mx-auto mt-[10vh] flex max-w-2xl flex-col items-center gap-[22vh] text-center">
            {impactItems.map((item) => (
              <div class="impact__beat" data-anim="story-line">
                <span class:list={['impact__index', item.accentIndex && 'impact__index--accent']}>
                  {item.index}
                </span>

                <p class="impact__label">
                  {item.parts.map((part) =>
                    part.figure ? <span class="impact__figure">{part.text}</span> : part.text,
                  )}
                </p>

                <p class="impact__detail">{item.detail}</p>
              </div>
            ))}
          </div>
        </section>
      )
    }

    {/*
      No cover image on the page itself. `cover` is still required by the
      schema and still does the work it is good at — the bento tile on the work
      index and the social card — but at full width here it was a wall of
      screenshot between the reader and the first paragraph. Images earn their
      place inside the body instead, next to the passage they illustrate.
    */}

    {/* Body ----------------------------------------------------------- */}
    <div class="px-shell py-section">
      <div class="case-body mx-auto max-w-3xl">
        <Content components={{ Figure, PullQuote, Stat, Device }} />
      </div>
    </div>

    {/*
      Metrics.

      The inner wrapper carries `max-w-6xl px-gutter`, matching <Gallery />
      exactly — with the padding outside the max-width the two bands sat on
      different rails and the stats read as shifted against the thumbnails
      below them.

      Cells are centred, unlike the left-aligned meta grid above: four equal
      columns of left-aligned text leave slack at the end of the last one, so
      the block's ink sits left of its own box however well the box is centred.
    */}
    {
      metrics && metrics.length > 0 && (
        <section class="relative border-t border-line py-section">
          <RuleCross />
          <div class="mx-auto max-w-6xl px-gutter">
            <dl class="grid grid-cols-2 gap-10 lg:grid-cols-4" data-anim="reveal-batch">
              {metrics.map((metric) => (
                <div class="text-center">
                  {/* Same clamp as <Stat> — at four columns the display ramp
                      overflows the cell for anything longer than "+24%". The
                      blue→purple ramp is `stat-gradient` from global.css —
                      `accent-gradient`'s longer ramp reads flat at this width. */}
                  <dd class="stat-gradient font-display text-[clamp(2rem,4vw,3.5rem)] font-normal leading-[1] tracking-tight">
                    {metric.value}
                  </dd>
                  <dt class="mt-3">
                    {metric.description && (
                      <span class="block text-micro uppercase tracking-[0.14em] text-ink-faint">
                        {metric.description}
                      </span>
                    )}
                    <span class="mt-1 block text-balance text-ink-dim">{metric.label}</span>
                  </dt>
                </div>
              ))}
            </dl>

            {liveSiteUrl && (
              <p class="mx-auto mt-16 max-w-2xl text-center text-ink-dim" data-anim="reveal">
                {liveSiteText ? `${liveSiteText.replace(liveSiteUrl, '').trim()} ` : 'See it live at '}
                <a
                  href={liveSiteUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-accent underline underline-offset-4"
                  data-cursor="grow"
                >
                  {liveSiteUrl.replace(/^https?:\/\//, '')}
                </a>
              </p>
            )}
          </div>
        </section>
      )
    }

    {/* Process gallery -------------------------------------------------- */}
    {
      gallery.length > 0 && (
        <div class="relative border-t border-line">
          <RuleCross />
          <Gallery images={gallery} fit={entry.id === 'greetings' ? 'contain' : 'cover'} />
        </div>
      )
    }

    {/* Next ----------------------------------------------------------- */}
    <section class="relative border-t border-line px-shell py-section">
      <RuleCross />
      <p class="text-micro uppercase tracking-[0.14em] text-ink-faint">Next project</p>
      <a
        href={`/work/${next.id}`}
        class="group mt-6 block"
        data-cursor="grow"
      >
        <h2
          class="font-display text-title font-normal text-ink transition-colors duration-500 group-hover:text-accent"
        >
          {next.data.title}
        </h2>
      </a>
    </section>
  </article>
</BaseLayout>

<script>
  /*
    Reveal the back link once the hero has scrolled away. An IntersectionObserver
    rather than a scroll listener: this fires twice for the whole page rather
    than on every frame of a Lenis-smoothed scroll.
  */
  function initBackLink() {
    const link = document.querySelector<HTMLElement>('[data-case-back]');
    const hero = document.querySelector<HTMLElement>('[data-case-hero]');
    const nav = document.querySelector<HTMLElement>('[data-nav]');
    if (!link || !hero) return () => {};

    const observer = new IntersectionObserver(
      ([entry]) => link.classList.toggle('is-visible', !entry.isIntersecting),
      // Trip once the hero's last sliver clears the nav, not its exact edge.
      { rootMargin: '-72px 0px 0px 0px', threshold: 0 },
    );
    observer.observe(hero);

    /*
      Publish the nav's measured height so the CSS can put the *same* gap above
      the link in both states — below the nav while it is showing, below the
      viewport edge once it retracts. Measured rather than hardcoded because the
      wordmark steps up a size at `sm`, which changes the header's height.
    */
    let navResize: ResizeObserver | null = null;

    if (nav) {
      const syncNavHeight = () => {
        link.style.setProperty('--nav-h', `${Math.round(nav.offsetHeight)}px`);
      };
      syncNavHeight();
      navResize = new ResizeObserver(syncNavHeight);
      navResize.observe(nav);
    }

    return () => {
      observer.disconnect();
      navResize?.disconnect();
    };
  }

  // Same teardown contract as the motion registry — the ClientRouter swaps the
  // body, so the observer has to be released or it retains detached DOM.
  let teardown: (() => void) | null = null;

  document.addEventListener('astro:page-load', () => {
    teardown = initBackLink();
  });

  document.addEventListener('astro:before-swap', () => {
    teardown?.();
    teardown = null;
  });
</script>

<style>
  /*
    Back link. Fixed under the nav, and `pointer-events: none` until it is
    actually shown so it never sits invisibly over the hero swallowing clicks.
  */
  .case-back {
    /*
      Vertical offset is a variable rather than a `top` override so it composes
      with the enter transform below — one animated property, no layout, and the
      two states cannot fight each other.
    */
    --back-shift: 0rem;
    /*
      One gap, used twice: between the nav's bottom edge and the link while the
      header is showing, and between the viewport's top edge and the link once
      it has retracted. `--nav-h` is measured and published by the script; the
      fallback matches the header at its `sm` size in case that never runs.
    */
    --back-gap: 1.25rem;
    --nav-h: 4.25rem;

    position: fixed;
    top: calc(var(--nav-h) + var(--back-gap));
    /* Same rail as the [data-blueprint] labels: the gutter plus their 0.6rem
       nudge. Aligns the pill's edge with the "NAVBAR" caption above it. */
    left: calc(var(--spacing-gutter) + 0.6rem);
    z-index: 30;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    background: color-mix(in oklab, var(--color-surface) 82%, transparent);
    backdrop-filter: blur(8px);
    color: var(--color-ink-dim);
    font-size: var(--text-micro);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0;
    pointer-events: none;
    transform: translateY(calc(-0.4rem + var(--back-shift)));
    transition:
      opacity var(--dur-fast) var(--ease-out-expo),
      transform var(--dur-base) var(--ease-out-expo),
      color var(--dur-fast) var(--ease-out-expo),
      border-color var(--dur-fast) var(--ease-out-expo);
  }

  .case-back.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(var(--back-shift));
  }

  /*
    Follow the nav. `nav.ts` retracts the header on scroll down and restores it
    on scroll up, publishing `data-nav-state` — so the link rides up into the
    vacated space and drops back down when the header returns, instead of
    hanging in the middle of nothing.

    The sibling combinator works because <Nav> is rendered immediately before
    <main> in BaseLayout and carries `transition:persist`, so the relationship
    survives client-side navigation.
  */
  :global([data-nav][data-nav-state='hidden']) ~ :global(main) .case-back {
    /* Exactly the nav's height, so the remaining gap above the link is
       `--back-gap` — the same as when the nav is showing. */
    --back-shift: calc(-1 * var(--nav-h));
  }

  .case-back:hover {
    color: var(--color-ink);
    border-color: var(--color-accent);
  }

  /* Keyboard users get it regardless of scroll position — otherwise tabbing
     into a link that is transparent and inert is a dead end. */
  .case-back:focus-visible {
    opacity: 1;
    pointer-events: auto;
    /* Must keep --back-shift, not `none` — otherwise focusing the link while
       the nav is retracted snaps it back down underneath the hidden header. */
    transform: translateY(var(--back-shift));
  }

  /* Drop the slide-in offset, but keep --back-shift applied: it is positioning,
     not decoration — without it the link would overlap the restored nav. */
  @media (prefers-reduced-motion: reduce) {
    .case-back,
    .case-back.is-visible {
      transition: opacity var(--dur-fast) linear;
      transform: translateY(var(--back-shift));
    }
  }

  /*
  /*
    The cover as a corner watermark.

    `luminosity` is the whole trick: the blend takes hue and saturation from
    what is underneath (the hero wash) and only luminance from the image, so a
    full-colour product screenshot resolves into the page's own blue and purple rather
    than sitting on top of it as a foreign rectangle. `grayscale(1)` first, so
    the source's own colour cannot leak through at the edges of the blend.

    The masks are the pair the skills texture used, and for the same reasons:
    the diagonal keeps the bottom-left — where the title and lead sit — clean,
    and the vertical trim stops the image running up behind the fixed nav.
  */
  .hero-cover {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 0;
    width: clamp(20rem, 58vw, 58rem);
    pointer-events: none;
    user-select: none;
    filter: grayscale(1) contrast(1.05);
    mix-blend-mode: luminosity;
    /* Low enough that the UI inside the screenshot stops being legible — the
       moment individual buttons read, it is a picture again rather than a
       texture. */
    opacity: 0.16;

    -webkit-mask-image:
      linear-gradient(to bottom left, #000 4%, transparent 56%),
      linear-gradient(to bottom, transparent 2%, #000 22%);
    mask-image:
      linear-gradient(to bottom left, #000 4%, transparent 56%),
      linear-gradient(to bottom, transparent 2%, #000 22%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }

  .hero-cover :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Below `md` the hero is one narrow column and the diagonal has nowhere to
     go — the watermark ends up behind the title rather than beside it. */
  @media (max-width: 47.9375rem) {
    .hero-cover {
      display: none;
    }
  }

  /* `<NoiseGradient>` handles its own grain under reduced motion; this is only
     about the watermark, which is a busy backdrop of the same kind. */
  @media (prefers-reduced-motion: reduce) {
    .hero-cover {
      opacity: 0.14;
    }
  }

  /*
    Scoped prose styling for MDX output. Astro 7 uses Sätteri, which emits
    plain semantic HTML with no wrapper classes — so this targets elements
    directly rather than reaching for a typography plugin.
  */
  /* Impact ------------------------------------------------------------ */

  .impact__beat {
    /* The story-line effect animates opacity and y on this element; keep the
       beat as one box so the claim and its detail light and dim together. */
    width: 100%;
  }

  .impact__index {
    display: inline-block;
    margin-bottom: 0.9rem;
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink-faint);
  }

  /* The accent falls back to the index when the claim carries no figure, so
     every item has exactly one coloured moment. */
  .impact__index--accent,
  .impact__figure {
    background-image: var(--gradient-accent-compact);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  /* Sized against the homepage's story beats (clamp(1.5rem, 3.2vw, 2.6rem)) but
     a step down: those are six-word poetic lines, these run to eleven words and
     would break to four lines at that size. */
  .impact__label {
    margin: 0;
    font-size: clamp(1.375rem, 2.7vw, 2.125rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.015em;
    text-wrap: balance;
    color: var(--color-ink);
  }

  .impact__detail {
    max-width: 34rem;
    margin: 1.1rem auto 0;
    font-size: var(--text-body);
    line-height: 1.55;
    text-wrap: pretty;
    color: var(--color-ink-dim);
  }

  .impact__figure {
    /* Tabular figures so `33% → 66.58%` does not wobble against the text
       around it, and a touch more weight because the gradient lightens it. */
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

