---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order || b.data.year - a.data.year,
);
---

<BaseLayout
  title="Work — Adam Robertson"
  description="Selected product design and frontend case studies."
>
  <section class="px-gutter pb-24 pt-[28vh]">
    <h1 class="font-display text-display font-normal text-ink" data-anim="reveal-heading">Work</h1>
    <p class="mt-10 max-w-2xl text-lead text-ink-dim" data-anim="reveal">
      {projects.length} selected projects. Longer write-ups on request.
    </p>
  </section>

  {/*
    Typographic list in the mchiu.co.uk spirit — the row is the interface, and
    hovering reveals the cover image pinned to the right of the row.
  */}
  <section class="border-t border-line px-gutter pb-section">
    <ul>
      {
        projects.map((entry) => (
          <li class="group relative border-b border-line">
            <a
              href={`/work/${entry.id}`}
              class="flex items-baseline justify-between gap-6 py-10 md:py-14"
              data-cursor="grow"
            >
              <span class="flex flex-col gap-2 md:flex-row md:items-baseline md:gap-8">
                <span class="font-display text-title font-normal tracking-tight text-ink transition-colors duration-500 group-hover:text-accent">
                  {entry.data.title}
                </span>
                <span class="text-micro uppercase tracking-[0.14em] text-ink-faint">
                  {entry.data.client}
                </span>
              </span>

              <span class="shrink-0 text-micro uppercase tracking-[0.14em] text-ink-faint">
                {entry.data.year}
              </span>
            </a>

            {/*
              Hover preview. Hidden from AT and pointer-events-none so it never
              intercepts the row's own click target. Desktop only — on touch
              there is no hover state to key off.
            */}
            <div
              class="pointer-events-none absolute right-[12%] top-1/2 z-10 hidden w-64 -translate-y-1/2 scale-95 overflow-hidden rounded-lg opacity-0 transition-all duration-500 ease-[var(--ease-out-expo)] group-hover:scale-100 group-hover:opacity-100 lg:block"
              aria-hidden="true"
            >
              <Image
                src={entry.data.cover}
                alt=""
                widths={[256, 512]}
                sizes="256px"
                class="aspect-[4/3] w-full object-cover"
                loading="lazy"
              />
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
