---
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import BreakoutCTA from '../components/BreakoutCTA.astro';
import Cursor from '../components/Cursor.svelte';
import '../styles/global.css';

// Preload the two fonts above the fold. Without this the big Vidaloka display
// heading paints in the Georgia fallback and reflows when the webfont lands —
// worth ~0.1 of CLS on its own. Importing with ?url gives the hashed, Astro-
// served path so the <link> below points at the real built asset.
import vidalokaWoff2 from '@fontsource/vidaloka/files/vidaloka-latin-400-normal.woff2?url';
import sansWoff2 from '@fontsource-variable/google-sans/files/google-sans-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Absolute or site-relative OG image. Falls back to the default card. */
  ogImage?: string;
}

const { title, description, ogImage = '/og/default.jpg' } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogUrl = new URL(ogImage, Astro.site);
---

<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />

    <link rel="preload" href={vidalokaWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansWoff2} as="font" type="font/woff2" crossorigin />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* Swap `no-js` before first paint so the CSS that hides [data-anim]
        elements only ever applies when JS can actually reveal them. */}
    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>

    {/*
      Raise the page loader. Same contract as `no-js` above: the overlay is
      hidden by default and only this script — which requires JS — ever shows
      it, so a visit without JS goes straight to the content.

      Runs here rather than in the motion module because it has to take effect
      on the first paint, before the module has even been fetched. `initMotion`
      drops the attribute once the page is composed; the timeout is the failsafe
      for the module never arriving at all (offline, a chunk 404) and is the
      reason this can't strand anyone on a spinner. Both paths just remove the
      attribute, so whichever lands first wins and the other is a no-op.

      The `__loaderShown` guard makes it a cold-load-only affair: the ClientRouter
      re-runs inline head scripts on navigation, and a spinner between two pages
      of the same site is worse than the cross-fade it would replace.
    */}
    <script is:inline>
      (function () {
        if (window.__loaderShown) return;
        // Reduced motion forces every [data-anim] element visible immediately,
        // so there is nothing to wait for — and an infinite ripple is the last
        // thing to show someone who asked for less movement.
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        window.__loaderShown = true;
        var root = document.documentElement;
        root.setAttribute('data-loading', '');
        setTimeout(function () {
          root.removeAttribute('data-loading');
        }, 4000);
      })();
    </script>

    {/* Drive the Tegaki signature. Inline + is:inline so it runs during parse,
        before Tegaki's deferred hydration module — that guarantees the
        `tegaki:ready` listener is attached before the event fires. The moment
        the engine exists we pin it to a controlled blank frame (which runs no
        playback loop, so it can't autoplay to the end on font-load), then draw
        it once it scrolls into view. Reduced motion snaps to the finished mark. */}
    <script is:inline>
      (function () {
        var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        document.addEventListener('tegaki:ready', function (e) {
          var engine = e.detail.engine;
          if (reduce) {
            engine.update({ time: '100%' });
            return;
          }
          engine.update({ time: '0%' });
          var io = new IntersectionObserver(
            function (entries) {
              for (var i = 0; i < entries.length; i++) {
                if (entries[i].isIntersecting) {
                  io.disconnect();
                  // Seconds for all fourteen glyphs. This is the only speed
                  // knob for the signature; 3s drew at a hesitant, tracing pace,
                  // where a real signature is written in about half that.
                  engine.update({ time: { mode: 'uncontrolled', playing: true, duration: 1.6 } });
                  engine.restart();
                }
              }
            },
            { threshold: 0.4 },
          );
          io.observe(e.target);
        });
      })();
    </script>

    <ClientRouter />
  </head>

  <body>
    {/* Loader. First element in the body so it paints with the very first frame,
        and `aria-hidden` because it is a pure waiting state — the content behind
        it is already in the accessibility tree and readable. */}
    <div id="page-loader" aria-hidden="true">
      <div class="lds-ripple"><div></div><div></div></div>
    </div>

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-accent focus:px-4 focus:py-2 focus:text-surface"
    >
      Skip to content
    </a>

    <Cursor client:idle />

    <Nav transition:persist />

    <main id="main">
      <slot />
    </main>

    <BreakoutCTA transition:persist />

    <Footer transition:persist />

    <script>
      import { bindMotionLifecycle } from '../lib/motion';
      bindMotionLifecycle();
    </script>
  </body>
</html>
